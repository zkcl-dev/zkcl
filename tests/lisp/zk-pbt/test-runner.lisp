;; sample handles rejections, recursive expands at small sizes, and surrogate overlaps are safe.
(let ((evens (zk-pbt:sample (zk-pbt:such-that #'evenp (zk-pbt:integers :min 0 :max 20))
                            :seed 42 :count 12)))
  (assert (and (= 12 (length evens)) (every #'evenp evens))))
(let ((trees (zk-pbt:sample (zk-pbt:s-expressions :max-depth 2) :seed 42 :size 10 :count 20)))
  (assert (some (lambda (x) (or (consp x) (vectorp x))) trees)))
(when (> char-code-limit #xE010)
  (let ((lo-chars (zk-pbt:sample (zk-pbt::char-range-generator #xD7F0 #xD810)
                                 :seed 42 :count 16))
        (hi-chars (zk-pbt:sample (zk-pbt::char-range-generator #xDFF0 #xE010)
                                 :seed 42 :count 16))
        (span-chars (zk-pbt:sample (zk-pbt:characters :min (code-char #xD7F0) :max (code-char #xE010))
                                   :seed 42 :count 24)))
    (assert (every (lambda (c) (<= #xD7F0 (char-code c) #xD7FF)) lo-chars))
    (assert (every (lambda (c) (<= #xE000 (char-code c) #xE010)) hi-chars))
    (assert (every (lambda (c) (not (<= #xD800 (char-code c) #xDFFF))) span-chars))))

