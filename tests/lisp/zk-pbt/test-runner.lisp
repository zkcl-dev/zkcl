;;; Schedule-sensitive race: fixed round-robin (0 1 0) passes, interleaved (0 0 1) triggers bug
(zk-pbt:defmachine latch-race
  (:model () nil)
  (:open () (list :armed nil))
  (:command :arm ()
    (:step (m) (declare (ignore m)) (values nil '(:armed)))
    (:act (sut) (setf (getf sut :armed) t) :armed))
  (:command :fire ()
    (:step (m) (declare (ignore m)) (values nil '(:safe)))
    (:act (sut) (if (getf sut :armed) :unsafe-fired :safe)))
  (:command :disarm ()
    (:step (m) (declare (ignore m)) (values nil '(:disarmed)))
    (:act (sut) (setf (getf sut :armed) nil) :disarmed)))

(let ((safe-plan (list '() '((:arm) (:fire)) '((:disarm)))))
  (assert (eq t (zk-pbt:run-parallel-commands 'latch-race safe-plan))))
(let ((sched-r
        (zk-pbt:for-all ((sched (zk-pbt:list-of (zk-pbt:integers :min 0 :max 1) :min 0 :max 4)))
          (:name latch-schedule-finder)
          (:seed 7) (:trials 40) (:check nil)
          (zk-pbt:run-parallel-commands
           'latch-race
           (list :scheduled '() (list '((:arm) (:fire)) '((:disarm))) sched)))))
  (assert (eq :falsified (zk-pbt:report-status sched-r)))
  (assert (equal '(:claim (latch-race :linearizability)) (field sched-r :failure)))
  (assert (some (lambda (n) (search "schedule:" n)) (field sched-r :notes)))
  (assert (eq :reproduced (zk-pbt:replay sched-r))))

;;; Herlihy & Wing call/return interval linearizability (linearizable-history-p)
(zk-pbt:defmachine seq-register-oracle
  (:model () 0)
  (:open () nil)
  (:command :write (v)
    (:args (m) (declare (ignore m)) (zk-pbt:tuple (zk-pbt:integers :min -5 :max 5)))
    (:step (m) (declare (ignore m)) (values v (list v)))
    (:act (s) (declare (ignore s v)) 0))
  (:command :read ()
    (:step (m) (values m (list m)))
    (:act (s) (declare (ignore s)) 0)))

(assert (zk-pbt:linearizable-history-p
         'seq-register-oracle 0
         '((:call c1 t1 (:write 5))
           (:call c2 t2 (:read))
           (:return c2 (5))
           (:return c1 (5)))))
(assert (zk-pbt:linearizable-history-p
         'seq-register-oracle 0
         '((:call c1 t1 (:write 5))
           (:call c2 t2 (:read))
           (:return c2 (0))
           (:return c1 (5)))))
(assert (not (zk-pbt:linearizable-history-p
              'seq-register-oracle 0
              '((:call c1 t1 (:write 5))
                (:return c1 (5))
                (:call c2 t2 (:read))
                (:return c2 (0))))))
(assert (not (zk-pbt:linearizable-history-p
              'seq-register-oracle 0
              '((:call c1 t1 (:write 7))
                (:call c2 t2 (:read))
                (:return c2 (7))
                (:call c3 t3 (:read))
                (:return c3 (0))
                (:return c1 (7))))))

;;; Monolith-style Multi-Object Differential Model Testing (defmodel)
(defstruct (cow-mut (:constructor make-cow-mut (vec owner)))
  vec owner)

(defun cow-mut-copy (s)
  (let* ((v (cow-mut-vec s))
         (n (length v))
         (nv (make-array n :adjustable t :fill-pointer n)))
    (dotimes (i n nv) (setf (aref nv i) (aref v i)))))

(defun cow-ensure-owned (s)
  (when (eq (cow-mut-owner s) :shared)
    (setf (cow-mut-vec s) (cow-mut-copy s)
          (cow-mut-owner s) :unique))
  s)

(zk-pbt:defmodel cow-seq-ok
  (:abstract :mseq :check (lambda (ref cand) (equal (car ref) (coerce (cow-mut-vec cand) 'list))))
  (:abstract :pseq :check (lambda (ref cand) (equal ref (coerce cand 'list))))
  (:op :make ()
    (:weight 2)
    (:returns (:abstract :mseq))
    (:ref (lambda () (list nil)))
    (:cand (lambda () (make-cow-mut (make-array 0 :adjustable t :fill-pointer 0) :unique))))
  (:op :push ((s (:ref :mseq)) (x (zk-pbt:integers :min -20 :max 20)))
    (:weight 4)
    (:returns :value)
    (:ref (lambda (s x) (setf (car s) (append (car s) (list x))) (length (car s))))
    (:cand (lambda (s x)
             (cow-ensure-owned s)
             (vector-push-extend x (cow-mut-vec s))
             (length (cow-mut-vec s)))))
  (:op :snapshot ((s (:ref :mseq)))
    (:weight 3)
    (:returns (:abstract :pseq))
    (:ref (lambda (s) (copy-list (car s))))
    (:cand (lambda (s)
             (setf (cow-mut-owner s) :shared)
             (cow-mut-vec s))))
  (:op :pget ((p (:ref :pseq)) (i (zk-pbt:integers :min 0 :max 10)))
    (:weight 2)
    (:pre (p i) (and (<= 0 i) (< i (length p))))
    (:returns :value)
    (:ref (lambda (p i) (nth i p)))
    (:cand (lambda (p i) (aref p i))))
  (:op :split ((s (:ref :mseq)) (i (zk-pbt:integers :min 0 :max 5)))
    (:weight 2)
    (:pre (s i) (and (<= 0 i) (<= i (length (car s)))))
    (:returns (:values (:abstract :mseq) (:abstract :mseq)))
    (:ref (lambda (s i) (values (list (subseq (car s) 0 i)) (list (subseq (car s) i)))))
    (:cand (lambda (s i)
             (let* ((v (cow-mut-vec s))
                    (left (make-array i :adjustable t :fill-pointer i))
                    (rlen (- (length v) i))
                    (right (make-array rlen :adjustable t :fill-pointer rlen)))
               (dotimes (k i) (setf (aref left k) (aref v k)))
               (dotimes (k rlen) (setf (aref right k) (aref v (+ i k))))
               (values (make-cow-mut left :unique) (make-cow-mut right :unique)))))))

(let ((r (zk-pbt:for-all ((sc (zk-pbt:model-scenarios 'cow-seq-ok :min 2 :max 12)))
           (:seed 7) (:trials 40) (:check nil)
           (zk-pbt:run-model 'cow-seq-ok sc))))
  (assert (eq :passed (zk-pbt:report-status r))))

;;; Intentional CoW ownership bug: snapshot forgets to mark owner :shared -> mutation corrupts snapshot
(zk-pbt:defmodel cow-seq-buggy
  (:abstract :mseq :check (lambda (ref cand) (equal (car ref) (coerce (cow-mut-vec cand) 'list))))
  (:abstract :pseq :check (lambda (ref cand) (equal ref (coerce cand 'list))))
  (:op :make ()
    (:weight 2)
    (:returns (:abstract :mseq))
    (:ref (lambda () (list nil)))
    (:cand (lambda () (make-cow-mut (make-array 0 :adjustable t :fill-pointer 0) :unique))))
  (:op :push ((s (:ref :mseq)) (x (zk-pbt:integers :min -20 :max 20)))
    (:weight 4)
    (:returns :value)
    (:ref (lambda (s x) (setf (car s) (append (car s) (list x))) (length (car s))))
    (:cand (lambda (s x)
             (cow-ensure-owned s)
             (vector-push-extend x (cow-mut-vec s))
             (length (cow-mut-vec s)))))
  (:op :snapshot ((s (:ref :mseq)))
    (:weight 3)
    (:returns (:abstract :pseq))
    (:ref (lambda (s) (copy-list (car s))))
    (:cand (lambda (s)
             ;; BUG: shares underlying vector without flipping owner to :shared
             (cow-mut-vec s)))))

(zk-pbt:defproperty cow-seq-buggy-fails
    ((sc (zk-pbt:model-scenarios 'cow-seq-buggy :min 2 :max 12)))
  (zk-pbt:run-model 'cow-seq-buggy sc))
