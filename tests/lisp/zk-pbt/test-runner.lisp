(defvar *opens* 0) (defvar *closes* 0)
(zk-pbt:defmachine broken-map
  (:model () nil)
  (:open () (incf *opens*) (make-hash-table :test 'eql))
  (:close (sut) (incf *closes*) (clrhash sut))
  (:command :put (k v)
    (:args (m) (zk-pbt:tuple (zk-pbt:elements :a :b) (zk-pbt:elements nil 1)))
    (:step (m) (values (acons k v m) (list v)))
    (:act (sut) (setf (gethash k sut) v)))
  (:command :get (k)
    (:args (m) (zk-pbt:tuple (zk-pbt:elements :a :b)))
    (:step (m) (let ((entry (assoc k m))) (values m (list (cdr entry) (not (null entry))))))
    (:act (sut) (let ((v (gethash k sut))) (values v (not (null v)))))))
(zk-pbt:defproperty model-agrees (ops)
  (:generate (zk-pbt:tuple (zk-pbt:commands 'broken-map :max 12)))
  (zk-pbt:run-commands 'broken-map ops))
(let* ((r (zk-pbt:run 'model-agrees :seed 42 :trials 200))
       (ops (car (field r :reduced))))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (= 2 (length ops)))
  (assert (and (eq :put (caar ops)) (eq :get (caadr ops))
               (eq (second (first ops)) (second (second ops)))
               (null (third (first ops)))))
  (assert (eq :reproduced (zk-pbt:replay r)))
  (assert (= *opens* *closes*)))

;; Independent samples, bounded dependent draws and finite custom enumeration.
(assert (equal (zk-pbt:sample (zk-pbt:integers) :seed 42 :size 10 :count 4) '(5 7 -1 10)))
(zk-pbt:defproperty dependent (x y)
  (:generate (zk-pbt:bind-gen (zk-pbt:integers :min -50 :max 50)
               (lambda (x) (zk-pbt:tuple (zk-pbt:just x) (zk-pbt:integers :min x :max (+ x 7))))))
  (:enumerate (zk-pbt:enumerator (emit) (funcall #'emit '(0 0)) (funcall #'emit '(2 9))))
  (<= x y (+ x 7)))
(assert (eq :passed (status 'dependent :seed 91)))
(assert (eq :insufficient (status 'dependent :max-enumerated 1)))
(let* ((g (zk-pbt:frequency (list 0 (zk-pbt:just :invalid))
                            (list (ash 1 65) (zk-pbt:just :ok))))
       (values (zk-pbt:sample g :seed 42 :count 9)))
  (assert (every (lambda (v) (eq v :ok)) values)))
(assert (every #'floatp (zk-pbt:sample (zk-pbt:floats) :seed 42 :count 20)))

;; Mutable graph data must be reconstructed before every candidate executes.
(zk-pbt:defproperty mutates (x)
  (:generate (zk-pbt:tuple (zk-pbt:just (list 7))))
  (let ((first (car x))) (setf (car x) :changed) (not (eql first 7))))
(let ((r (zk-pbt:run 'mutates :seed 42)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '((7)) (field r :original)))
  (assert (eq :reproduced (zk-pbt:replay r))))
(let* ((h (make-hash-table :test 'equal))
       (v (make-array 4 :adjustable t :fill-pointer 1 :initial-element nil)))
  (setf (aref v 0) h (aref v 3) 71 (gethash "vector" h) v)
  (let ((copy (zk-pbt::decode-case-value (zk-pbt::encode-case-value v))))
    (assert (eq (gethash "vector" (aref copy 0)) copy))
    (assert (and (= 1 (fill-pointer copy)) (adjustable-array-p copy) (= (aref copy 3) 71)))))

(defstruct token text)
(zk-pbt:define-case-codec "demo-token"
  (lambda (x) (when (token-p x) (values (token-text x) t)))
  (lambda (data) (make-token :text data)))
(zk-pbt:defproperty rejects-token (token)
  (:generate (zk-pbt:tuple (zk-pbt:map-gen (lambda (s) (make-token :text s)) (zk-pbt:just "x"))))
  (not (equal "x" (token-text token))))
(let ((report (zk-pbt:run 'rejects-token :seed 42)))
  (assert (eq :reproduced (zk-pbt:replay report))))
(zk-pbt:defproperty opaque-function (f)
  (:generate (zk-pbt:tuple (zk-pbt:generator (draw size) (lambda () nil))))
  (funcall f))
(let ((r (zk-pbt:run 'opaque-function :seed 42)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (not (field r :persistable)))
  (assert (eq :reproduced (zk-pbt:replay r))))

(define-condition numbered-error (error)
  ((number :initarg :number :reader error-number)))
(zk-pbt:defproperty stable-cause (n)
  (:generate (zk-pbt:tuple (zk-pbt:integers :min 0 :max 100)))
  (:failure-key #'error-number)
  (error 'numbered-error :number (if (zerop n) :other :original)))
(let ((r (zk-pbt:run 'stable-cause :seed 42)))
  (assert (equal (field r :failure) '(:condition numbered-error :original)))
  (assert (equal (field r :reduced) '(1))))

(zk-pbt:defmachine broken-cleanup
  (:model () nil) (:open () nil) (:close (sut) (error "cleanup failed"))
  (:command :read ()
    (:args (m) (zk-pbt:tuple))
    (:step (m) (values m '(nil))) (:act (sut) (values))))
(zk-pbt:defproperty cleanup-diagnostic (ops)
  (:examples (((:read))))
  (zk-pbt:run-commands 'broken-cleanup ops))
(let ((r (zk-pbt:run 'cleanup-diagnostic)))
  (assert (eq :error (zk-pbt:report-status r)))
  (assert (typep (field r :prior) 'error)))

