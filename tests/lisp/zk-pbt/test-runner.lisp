;; defmachine: Bundle symbolic handles (:produces, bundle-elements, deref) & step trace notes.
(zk-pbt:defmachine handle-box-machine
  (:model () 0)
  (:open () (list :boxes nil))
  (:command :new-box ()
    (:produces :boxes)
    (:step (m) (1+ m))
    (:act (sut)
      (let ((box (list 0)))
        (push box (getf sut :boxes))
        box))
    (:post (before after actual)
      (declare (ignore actual))
      (= after (1+ before))))
  (:command :set-box (h val)
    (:args (m) (zk-pbt:tuple (zk-pbt:bundle-elements :boxes) (zk-pbt:integers :min 0 :max 10)))
    (:step (m) (values m (list val)))
    (:act (sut)
      (let ((box (zk-pbt:deref h)))
        (setf (car box) val)
        val)))
  (:command :check-box (h)
    (:args (m) (zk-pbt:tuple (zk-pbt:bundle-elements :boxes)))
    (:step (m) (values m (list :ok)))
    (:act (sut)
      (if (>= (car (zk-pbt:deref h)) 5) :boom :ok))))
(zk-pbt:defproperty handle-box-shrinks
    ((ops (zk-pbt:commands 'handle-box-machine :max 10)))
  (zk-pbt:run-commands 'handle-box-machine ops))
(let ((r (zk-pbt:run 'handle-box-shrinks :seed 42 :trials 150)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (let ((ops (car (field r :reduced))))
    (assert (= 3 (length ops)))
    (assert (eq :new-box (car (first ops))))
    (assert (eq :set-box (car (second ops))))
    (assert (eq :check-box (car (third ops))))
    (assert (equal '(:ref :boxes 1) (second (second ops))))
    (assert (equal '(:ref :boxes 1) (second (third ops)))))
  (assert (some (lambda (n) (search "step 0:" n)) (field r :notes)))
  (assert (eq :reproduced (zk-pbt:replay r))))

