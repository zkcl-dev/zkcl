;;; Deep defmodel: state-aware :from, nested :refs, :executable formatter, invariant ref/cand diff
(defun cow-named-make ()
  (make-cow-mut (make-array 0 :adjustable t :fill-pointer 0) :unique))

(defun cow-named-push (s x)
  (cow-ensure-owned s)
  (vector-push-extend x (cow-mut-vec s))
  (length (cow-mut-vec s)))

(zk-pbt:defmodel cow-seq-dep
  (:abstract :mseq :check (lambda (ref cand) (equal (car ref) (coerce (cow-mut-vec cand) 'list))))
  (:abstract :pseq :check (lambda (ref cand) (equal ref (coerce cand 'list))))
  (:op :make ()
    (:weight 2)
    (:returns (:abstract :mseq))
    (:ref (lambda () (list nil)))
    (:cand #'cow-named-make))
  (:op :push ((s (:ref :mseq)) (x (zk-pbt:integers :min -10 :max 10)))
    (:weight 4)
    (:returns :value)
    (:ref (lambda (s x) (setf (car s) (append (car s) (list x))) (length (car s))))
    (:cand #'cow-named-push))
  (:op :snapshot ((s (:ref :mseq)))
    (:weight 3)
    (:returns (:abstract :pseq))
    (:ref (lambda (s) (copy-list (car s))))
    (:cand (lambda (s)
             (setf (cow-mut-owner s) :shared)
             (cow-mut-vec s))))
  (:op :pget ((p (:ref :pseq))
              (i (:from (p) (zk-pbt:integers :min 0 :max (max 0 (1- (length p)))))))
    (:weight 3)
    (:returns :value)
    (:ref (lambda (p i) (if (< i (length p)) (nth i p) (error "out of bounds"))))
    (:cand (lambda (p i) (if (< i (length p)) (aref p i) (error "out of bounds")))))
  (:op :split ((s (:ref :mseq))
               (i (:from (s) (zk-pbt:integers :min 0 :max (length (car s))))))
    (:weight 2)
    (:returns (:values (:abstract :mseq) (:abstract :mseq)))
    (:ref (lambda (s i) (values (list (subseq (car s) 0 i)) (list (subseq (car s) i)))))
    (:cand (lambda (s i)
             (let* ((v (cow-mut-vec s))
                    (left (make-array i :adjustable t :fill-pointer i))
                    (rlen (- (length v) i))
                    (right (make-array rlen :adjustable t :fill-pointer rlen)))
               (dotimes (k i) (setf (aref left k) (aref v k)))
               (dotimes (k rlen) (setf (aref right k) (aref v (+ i k))))
               (values (make-cow-mut left :unique) (make-cow-mut right :unique))))))
  (:op :concat ((ss (:refs :mseq :min 1 :max 2)))
    (:weight 2)
    (:returns (:abstract :mseq))
    (:ref (lambda (ss)
            (list (loop for box in ss append (copy-list (car box))))))
    (:cand (lambda (ss)
             (let ((out (make-array 0 :adjustable t :fill-pointer 0)))
               (dolist (box ss)
                 (let ((v (cow-mut-vec box)))
                   (dotimes (k (length v))
                     (vector-push-extend (aref v k) out))))
               (make-cow-mut out :unique))))))

(let ((r (zk-pbt:for-all ((sc (zk-pbt:model-scenarios 'cow-seq-dep :min 2 :max 12)))
           (:seed 7) (:trials 40) (:check nil)
           (zk-pbt:run-model 'cow-seq-dep sc))))
  (assert (eq :passed (zk-pbt:report-status r)))
  (assert (= 0 (getf (field r :counts) :discarded))))

