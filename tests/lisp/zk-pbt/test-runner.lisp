;; Shrink-time generator error preserves :prior falsification evidence.
(let ((tripped nil))
  (zk-pbt:defproperty shrink-time-error (n)
    (:generate (zk-pbt:tuple
                (zk-pbt:bind-gen (zk-pbt:integers :min 1 :max 100)
                                 (lambda (k)
                                   (when (and tripped (= k 1)) (error "shrink crash"))
                                   (zk-pbt:just k)))))
    (if (>= n 10)
        (progn (setq tripped t) nil)
        t))
  (let ((r (zk-pbt:run 'shrink-time-error :seed 42)))
    (assert (eq :error (zk-pbt:report-status r)))
    (assert (equal '(:predicate) (field r :prior)))))

