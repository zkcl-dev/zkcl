  (handler-case (zk-pbt:check 'thresholds :seed 42)
    (zk-pbt:check-failed (c) (setq caught c)))
  (assert caught)
  (assert (eq :reproduced (zk-pbt:replay caught))))

;; zk-pbt:assume, collect, tabulate, octets, and fast O(log N) binary-search shrinking.
(zk-pbt:defproperty assume-filters-and-shrinks ((a (zk-pbt:integers :min 0 :max 20))
                                              (b (zk-pbt:integers :min 0 :max 20)))
  (:enumerate (zk-pbt:tuple (zk-pbt:integers :min 0 :max 3)
                            (zk-pbt:integers :min 0 :max 3)))
  (zk-pbt:assume (< a b))
  (zk-pbt:collect (if (< (- b a) 5) :close :far))
  (zk-pbt:tabulate :pair-diff (- b a))
  (< b 15))
(let ((r (zk-pbt:run 'assume-filters-and-shrinks :seed 42 :trials 25)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  ;; Shrink preserves assume (< a b) and minimizes (a b) to (0 15).
  (assert (equal '(0 15) (field r :reduced)))
  (assert (= 6 (getf (field r :counts) :enumerated))))

(zk-pbt:defproperty assume-passes-without-inflating-random ((a (zk-pbt:integers :min 0 :max 10))
                                                          (b (zk-pbt:integers :min 0 :max 10)))
  (zk-pbt:assume (< a b))
  (zk-pbt:collect (< (- b a) 4))
  (zk-pbt:tabulate :gap (- b a))
  (< a b))
(let ((r (zk-pbt:run 'assume-passes-without-inflating-random :seed 42 :trials 20)))
  (assert (eq :passed (zk-pbt:report-status r)))
  (assert (= 20 (getf (field r :counts) :random)))
  (assert (plusp (getf (field r :counts) :discarded)))
  (assert (assoc '(:gap . 1) (field r :coverage) :test #'equal)))

(zk-pbt:defproperty example-violating-assume (n)
  (:examples (0))
  (zk-pbt:assume (plusp n))
  t)
(assert (eq :error (status 'example-violating-assume :trials 0)))

(let ((oct (zk-pbt:sample (zk-pbt:octets :min 2 :max 6) :seed 42 :count 10)))
  (assert (every (lambda (v)
                   (and (vectorp v) (<= 2 (length v) 6)
                        (every (lambda (b) (typep b '(unsigned-byte 8))) v)))
                 oct)))

(zk-pbt:defproperty large-integer-binary-shrink ((n (zk-pbt:integers :min 0 :max 1000000000)))
  (< n 123456789))
(let ((r (zk-pbt:run 'large-integer-binary-shrink :seed 42 :trials 40)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(123456789) (field r :reduced)))
  (assert (< (field r :shrinks) 60)))

(zk-pbt:defproperty dependent-list-shrink
    ((xs (zk-pbt:bind-gen (zk-pbt:integers :min 1 :max 10)
                          (lambda (n) (zk-pbt:list-of (zk-pbt:integers :min 0 :max 10) :min n :max n)))))
  (< (reduce #'+ xs) 8))
(let ((r (zk-pbt:run 'dependent-list-shrink :seed 42 :trials 40)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (= 8 (reduce #'+ (car (field r :reduced))))))

;; State machine with terminal state & preconditions completes without discard exhaustion.
(zk-pbt:defmachine bounded-door
  (:model () :open)
  (:open () (list :open))
  (:close (sut) (declare (ignore sut)))
  (:command :close-door ()
    (:enabled (m) (eq m :open))
    (:args (m) (zk-pbt:tuple))
    (:step (m) (values :closed (list :closed)))
    (:act (sut) (setf (car sut) :closed))))
(zk-pbt:defproperty bounded-door-ok ((ops (zk-pbt:commands 'bounded-door :min 0 :max 8)))
  (zk-pbt:run-commands 'bounded-door ops))
(assert (eq :passed (status 'bounded-door-ok :seed 42 :trials 20)))

;; First-class serializable/shrinkable functions, :expect :falsified, shrink-with,
;; max-discard-ratio, run-schedule, and JSON/JUnit/discovery protocols.
(zk-pbt:defproperty generated-fn-fails-large
    ((f (zk-pbt:functions (zk-pbt:integers :min 0 :max 20) :arity 1 :max-entries 4)))
  (< (+ (funcall f :a) (funcall f :b)) 12))
(let ((r (zk-pbt:run 'generated-fn-fails-large :seed 42 :trials 60)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (field r :persistable))
  (assert (eq :reproduced (zk-pbt:replay r))))

(zk-pbt:defproperty expected-counterexample ((n (zk-pbt:integers :min 0 :max 50)))
  (:expect :falsified)
  (< n 5))
(let ((r (zk-pbt:run 'expected-counterexample :seed 42)))
  (assert (eq :passed (zk-pbt:report-status r)))
  (assert (equal '(5) (field r :reduced))))

(zk-pbt:defproperty unexpected-pass-fails ((n (zk-pbt:integers :min 0 :max 10)))
  (:expect :falsified)
  (<= 0 n 10))
(assert (eq :falsified (status 'unexpected-pass-fails :seed 42 :trials 10)))

(zk-pbt:defproperty sorted-pair-domain-shrink
    ((xs (zk-pbt:shrink-with
          (lambda (items)
            (when (> (length items) 1)
              (list (cdr items) (butlast items))))
          (zk-pbt:map-gen (lambda (ys) (sort (copy-list ys) #'<))
                          (zk-pbt:list-of (zk-pbt:integers :min 10 :max 30) :min 3 :max 6)))))
  (assert (apply #'<= xs))
  (< (reduce #'+ xs) 40))
(let ((r (zk-pbt:run 'sorted-pair-domain-shrink :seed 42 :trials 30)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (let ((reduced (car (field r :reduced))))
    (assert (apply #'<= reduced))
    (assert (<= (length reduced) 3))))

(zk-pbt:defproperty discard-ratio-budget ((n (zk-pbt:such-that #'evenp (zk-pbt:integers :min 0 :max 10) :attempts 1)))
  (evenp n))
(assert (eq :passed (status 'discard-ratio-budget :seed 42 :trials 15 :max-discard-ratio 5)))
(assert (eq :insufficient (status 'discard-ratio-budget :seed 42 :trials 15 :max-discard-ratio 0)))

(zk-pbt:defproperty race-schedule-detects-lost-update
    ((sched (zk-pbt:list-of (zk-pbt:integers :min 0 :max 1) :min 2 :max 8)))
  (let ((counter 0)
        (r0 0) (s0 0)
        (r1 0) (s1 0))
    (zk-pbt:run-schedule
     (list (lambda () (ecase s0 (0 (setq r0 counter s0 1) t) (1 (setq counter (1+ r0) s0 2) nil)))
           (lambda () (ecase s1 (0 (setq r1 counter s1 1) t) (1 (setq counter (1+ r1) s1 2) nil))))
     sched)
    (= counter 2)))
(let ((r (zk-pbt:run 'race-schedule-detects-lost-update :seed 42 :trials 40)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (eq :reproduced (zk-pbt:replay r))))

(let* ((report (zk-test:run 'severity-suite :seed 42 :trials 3))
       (json (with-output-to-string (s) (zk-test:write-json-report report s)))
       (junit (with-output-to-string (s) (zk-test:write-junit-report report s))))
  (assert (search "\"status\": \"falsified\"" json))
  (assert (search "<testsuite " junit))
  (assert (search "<failure " junit)))

(let ((saved-only zk-test:*discover-only*)
      (saved-checks zk-test:*discovered-checks*))
  (unwind-protect
       (progn
         (setq zk-test:*discover-only* t
               zk-test:*discovered-checks* nil)
         (assert (eq t (zk-test:check 'severity-suite)))
         (assert (= 1 (length zk-test:*discovered-checks*))))
    (setq zk-test:*discover-only* saved-only
          zk-test:*discovered-checks* saved-checks)))

;; Modern combinators: let-gen, multi-arg map-gen, resize, scale, nat, option, cons-of, char/string helpers.
(zk-pbt:defproperty let-gen-dependent-shrink
    ((xs (zk-pbt:let-gen ((n (zk-pbt:integers :min 1 :max 10))
                          (items (zk-pbt:list-of (zk-pbt:integers :min 0 :max 10) :min n :max n)))
           items)))
  (< (reduce #'+ xs) 8))
(let ((r (zk-pbt:run 'let-gen-dependent-shrink :seed 42 :trials 40)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (= 8 (reduce #'+ (car (field r :reduced))))))

(let ((sums nil))
  (zk-pbt::enumerate-inputs
   (zk-pbt:map-gen #'+ (zk-pbt:elements 1 2) (zk-pbt:elements 10 20))
   (lambda (v) (push v sums)))
  (assert (equal (nreverse sums) '(11 21 12 22))))
(assert (every #'integerp
               (zk-pbt:sample (zk-pbt:map-gen #'+ (zk-pbt:integers :min 0 :max 5)
                                                  (zk-pbt:integers :min 10 :max 20))
                              :seed 42 :count 10)))

(assert (every (lambda (x) (and (integerp x) (>= x 0)))
               (zk-pbt:sample (zk-pbt:nat) :seed 42 :count 20)))
(assert (every (lambda (x) (<= -3 x 3))
               (zk-pbt:sample (zk-pbt:resize 3 (zk-pbt:integers)) :seed 42 :size 100 :count 20)))
(assert (every (lambda (x) (<= -5 x 5))
               (zk-pbt:sample (zk-pbt:scale (lambda (s) (floor s 10)) (zk-pbt:integers))
                              :seed 42 :size 50 :count 20)))
(let ((opts (zk-pbt:sample (zk-pbt:option (zk-pbt:integers :min 1 :max 10)) :seed 42 :count 30)))
  (assert (some #'null opts))
  (assert (some #'integerp opts)))
(assert (every (lambda (p) (and (consp p) (keywordp (car p)) (integerp (cdr p))))
               (zk-pbt:sample (zk-pbt:cons-of (zk-pbt:keywords :max 4) (zk-pbt:nat :max 9))
                              :seed 42 :count 15)))
(assert (every (lambda (c) (<= 32 (char-code c) 126))
               (zk-pbt:sample (zk-pbt:printable-characters) :seed 42 :count 20)))
(assert (every #'alphanumericp
               (zk-pbt:sample (zk-pbt:alphanumeric-characters) :seed 42 :count 30)))
(assert (every (lambda (c) (< (char-code c) 128))
               (zk-pbt:sample (zk-pbt:ascii-characters) :seed 42 :count 20)))
(assert (every (lambda (s) (and (stringp s) (every (lambda (c) (<= 32 (char-code c) 126)) s)))
               (zk-pbt:sample (zk-pbt:printable-strings :max 8) :seed 42 :count 15)))

;; with-corners & such-that-maybe.
(let ((enum-vals nil))
  (zk-pbt::enumerate-inputs
   (zk-pbt:with-corners '(0 99) (zk-pbt:integers :min 5 :max 6))
   (lambda (v) (push v enum-vals)))
  (assert (equal (nreverse enum-vals) '(0 99 5 6))))
(zk-pbt:defproperty corner-preferred-shrink
    ((n (zk-pbt:with-corners '(99 100) (zk-pbt:integers :min 1 :max 50))))
  (not (or (= n 99) (>= n 40))))
(let ((r (zk-pbt:run 'corner-preferred-shrink :seed 42 :trials 50)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(99) (field r :reduced))))

(let ((maybes (zk-pbt:sample (zk-pbt:such-that-maybe #'minusp (zk-pbt:just 1)) :seed 42 :count 5)))
  (assert (equal maybes '(nil nil nil nil nil))))
(zk-pbt:defproperty such-that-maybe-shrinks
    ((n (zk-pbt:such-that-maybe #'evenp (zk-pbt:integers :min 1 :max 50) :attempts 10)))
  (or (null n) (< n 10)))
(let ((r (zk-pbt:run 'such-that-maybe-shrinks :seed 42 :trials 40)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(10) (field r :reduced))))

;; unique-list-of, subsequence-of, permutation-of.
(let ((ulists (zk-pbt:sample (zk-pbt:unique-list-of (zk-pbt:integers :min 0 :max 12) :min 3 :max 6)
                             :seed 42 :count 20))
      (slists (zk-pbt:sample (zk-pbt:unique-list-of (zk-pbt:elements "a" "b" "c" "d")
                                                  :min 2 :max 4 :test #'equal)
                             :seed 42 :count 15)))
  (assert (every (lambda (xs) (and (<= 3 (length xs) 6)
                                   (= (length xs) (length (remove-duplicates xs :test #'eql)))))
                 ulists))
  (assert (every (lambda (xs) (and (<= 2 (length xs) 4)
                                   (= (length xs) (length (remove-duplicates xs :test #'equal)))))
                 slists)))
(zk-pbt:defproperty unique-list-shrinks-preserving-uniqueness
    ((xs (zk-pbt:unique-list-of (zk-pbt:integers :min 0 :max 30) :min 3 :max 8)))
  (< (reduce #'+ xs) 10))
(let ((r (zk-pbt:run 'unique-list-shrinks-preserving-uniqueness :seed 42 :trials 40)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (let ((xs (car (field r :reduced))))
    (assert (>= (length xs) 3))
    (assert (= (length xs) (length (remove-duplicates xs :test #'eql))))
    (assert (>= (reduce #'+ xs) 10))))

(labels ((subseq-order-p (sub full &key (test #'eql))
           (let ((pos 0)
                 (n (length full)))
             (every (lambda (item)
                      (loop while (and (< pos n) (not (funcall test item (elt full pos))))
                            do (incf pos))
                      (when (< pos n) (incf pos) t))
                    sub))))
  (let ((lsubs (zk-pbt:sample (zk-pbt:subsequence-of '(10 20 30 40) :min 1 :max 3) :seed 42 :count 20))
        (vsubs (zk-pbt:sample (zk-pbt:subsequence-of #(1 2 3 4)) :seed 42 :count 20))
        (ssubs (zk-pbt:sample (zk-pbt:subsequence-of "abcd" :min 2 :max 2) :seed 42 :count 15))
        (enums nil))
    (assert (every (lambda (s) (and (listp s) (<= 1 (length s) 3) (subseq-order-p s '(10 20 30 40)))) lsubs))
    (assert (every (lambda (s) (and (vectorp s) (subseq-order-p s #(1 2 3 4)))) vsubs))
    (assert (every (lambda (s) (and (stringp s) (= 2 (length s)) (subseq-order-p s "abcd" :test #'char=))) ssubs))
    (zk-pbt::enumerate-inputs (zk-pbt:subsequence-of '(a b c) :min 1 :max 2)
                              (lambda (s) (push s enums)))
    (assert (= 6 (length enums)))
    (assert (every (lambda (s) (and (<= 1 (length s) 2) (subseq-order-p s '(a b c)))) enums))))

(zk-pbt:defproperty subseq-shrinks-to-trigger
    ((s (zk-pbt:subsequence-of '(10 20 30 40))))
  (not (member 30 s)))
(let ((r (zk-pbt:run 'subseq-shrinks-to-trigger :seed 42 :trials 40)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '((30)) (field r :reduced))))

(labels ((same-multiset-p (a b &key (test #'eql))
           (and (= (length a) (length b))
                (let ((rem (coerce b 'list)))
                  (every (lambda (x)
                           (let ((found (member x rem :test test)))
                             (when found
                               (setq rem (remove x rem :test test :count 1))
                               t)))
                         (coerce a 'list))))))
  (let ((lperms (zk-pbt:sample (zk-pbt:permutation-of '(1 1 2 3)) :seed 42 :count 15))
        (sperms (zk-pbt:sample (zk-pbt:permutation-of "abbc") :seed 42 :count 15))
        (vperms (zk-pbt:sample (zk-pbt:permutation-of #(a b c)) :seed 42 :count 15)))
    (assert (every (lambda (p) (and (listp p) (same-multiset-p p '(1 1 2 3)))) lperms))
    (assert (every (lambda (p) (and (stringp p) (same-multiset-p p "abbc" :test #'char=))) sperms))
    (assert (every (lambda (p) (and (vectorp p) (same-multiset-p p #(a b c)))) vperms))))
(zk-pbt:defproperty permutation-shrinks-to-identity
    ((p (zk-pbt:permutation-of '(1 2 3 4))))
  (not (= 10 (reduce #'+ p))))
(let ((r (zk-pbt:run 'permutation-shrinks-to-identity :seed 42 :trials 10)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '((1 2 3 4)) (field r :reduced))))

;; no-shrink protects pinned argument while shrinking sibling.
(let ((r (zk-pbt:for-all ((locked (zk-pbt:no-shrink (zk-pbt:integers :min 10 :max 100)))
                          (free (zk-pbt:integers :min 0 :max 100)))
           (:seed 42)
           (:check nil)
           (not (and (>= locked 10) (>= free 7))))))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (= (first (field r :original)) (first (field r :reduced))))
  (assert (= 7 (second (field r :reduced)))))

;; recursive tree-lifting shrinks nested structures directly to minimal leaf.
(labels ((tree-max-leaf (x)
           (if (integerp x)
               x
               (reduce #'max x :key #'tree-max-leaf :initial-value 0))))
  (zk-pbt:defproperty tree-lift-shrink
      ((tree (zk-pbt:resize 60
               (zk-pbt:recursive (zk-pbt:integers :min 0 :max 20)
                                 (lambda (child) (zk-pbt:list-of child :min 1 :max 4))
                                 :max-depth 4 :leaf-weight 1 :branch-weight 9))))
    (< (tree-max-leaf tree) 5))
  (let ((r (zk-pbt:run 'tree-lift-shrink :seed 42 :trials 20)))
    (assert (eq :falsified (zk-pbt:report-status r)))
    (assert (consp (car (field r :original))))
    (assert (equal '(5) (field r :reduced)))))

;; Simultaneous equal-integer choice shrinking.
(zk-pbt:defproperty shared-int-shrink
    ((a (zk-pbt:integers :min 0 :max 100))
     (b (zk-pbt:integers :min 0 :max 100)))
  (not (and (= a b) (>= a 10))))
(let ((r (zk-pbt:run 'shared-int-shrink :seed 42 :trials 5000)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(10 10) (field r :reduced))))

;; shrink-with propagation through list-of, resize, scale + shrink-candidates.
(let* ((elem-gen (zk-pbt:shrink-with (lambda (x) (when (> x 1) (list (1- x))))
                                     (zk-pbt:integers :min 1 :max 10)))
       (list-gen (zk-pbt:resize 5 (zk-pbt:scale #'1+ (zk-pbt:list-of elem-gen :min 1 :max 4)))))
  (assert (equal '(4) (zk-pbt:shrink-candidates elem-gen 5)))
  (assert (some (lambda (cand) (equal cand '(2 3)))
                (zk-pbt:shrink-candidates list-gen '(3 3))))
  (let ((r (zk-pbt:for-all ((xs list-gen))
             (:seed 42)
             (:check nil)
             (< (reduce #'+ xs) 5))))
    (assert (eq :falsified (zk-pbt:report-status r)))
    (assert (= 5 (reduce #'+ (car (field r :reduced)))))))

;; defproperty docstring + per-property budget defaults + call-site override.
(zk-pbt:defproperty documented-default-budget ((n (zk-pbt:integers :min 0 :max 20)))
  "Property docstring before options."
  (:trials 7)
  (:max-size 12)
  (declare (ignorable n))
  (<= 0 n 20))
(let ((r-default (zk-pbt:run 'documented-default-budget :seed 42))
      (r-override (zk-pbt:run 'documented-default-budget :seed 42 :trials 3)))
  (assert (eq :passed (zk-pbt:report-status r-default)))
  (assert (= 7 (getf (field r-default :counts) :random)))
  (assert (= 3 (getf (field r-override :counts) :random))))

;; for-all macro: inline check, :check nil, :name, replay, and embedding inside deftest.
(assert (eq t (zk-pbt:for-all ((a (zk-pbt:integers :min 0 :max 10))
                               (b (zk-pbt:integers :min 0 :max 10)))
                (:trials 20)
                (:seed 42)
                (= (+ a b) (+ b a)))))
(let ((r (zk-pbt:for-all ((x (zk-pbt:integers :min 0 :max 30)))
           (:name inline-check-prop)
           (:trials 40)
           (:seed 42)
           (:check nil)
           (< x 9))))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (eq 'inline-check-prop (field r :name)))
  (assert (equal '(9) (field r :reduced)))
  (assert (eq :reproduced (zk-pbt:replay r))))
(zk-test:deftest for-all-inside-deftest ()
  (zk-pbt:for-all ((n (zk-pbt:integers :min 0 :max 50)))
    (:seed 42)
    (< n 5)))
(let ((r (zk-test:run 'for-all-inside-deftest)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(5) (field r :reduced))))

;; note diagnostics & readable generated-function descriptions in text and JSON reports.
(zk-pbt:defproperty noted-function-failure
    ((f (zk-pbt:functions (zk-pbt:integers :min 0 :max 20) :arity 1 :max-entries 4)))
  (let ((va (funcall f :a))
        (vb (funcall f :b)))
    (zk-pbt:note "f(:a)=~D f(:b)=~D" va vb)
    (< (+ va vb) 12)))
(let* ((r (zk-pbt:run 'noted-function-failure :seed 42 :trials 60))
       (text (with-output-to-string (*standard-output*) (zk-test:print-report r)))
       (json (with-output-to-string (s) (zk-test:write-json-report r s)))
       (desc (zk-pbt:describe-generated-function (car (field r :reduced)))))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (consp (field r :notes)))
  (assert (eq :fn (first desc)))
  (assert (search "note: " text))
  (assert (search ":FN" text))
  (assert (search ":CALLS" text))
  (assert (search "->" text))
  (assert (not (search "#<CLOSURE" text)))
  (assert (search "\"notes\": [" json))
  (assert (search ":FN" json)))

;; Coverage failure reports :observed-count and :required-count.
(let* ((r (zk-pbt:run 'coverage :seed 42 :trials 3))
       (text (with-output-to-string (*standard-output*) (zk-test:print-report r)))
       (json (with-output-to-string (s) (zk-test:write-json-report r s))))
  (assert (eq :insufficient (zk-pbt:report-status r)))
  (assert (eql 0 (field r :observed-count)))
  (assert (eql 2 (field r :required-count)))
  (assert (search "observed 0, required 2" text))
  (assert (search "\"observed_count\": 0" json))
  (assert (search "\"required_count\": 2" json)))

;; defmachine: stable command indices with dynamic :enabled, optional :close & 0-arg :args, :weight, :post.
(zk-pbt:defmachine dynamic-enable-machine
  (:model () nil)
  (:open () (list :armed nil))
  (:command :extra ()
    (:enabled (m) (not m))
    (:step (m) (values m (list :extra)))
    (:act (sut) :extra))
  (:command :arm ()
    (:enabled (m) (not m))
    (:step (m) (values t (list :armed)))
    (:act (sut) (setf (getf sut :armed) t) :armed))
  (:command :tick ()
    (:step (m) (values m (list :tick)))
    (:act (sut) :tick))
  (:command :trigger ()
    (:enabled (m) m)
    (:step (m) (values m (list :ok)))
    (:act (sut) :boom)))
(zk-pbt:defproperty dynamic-enable-shrinks
    ((ops (zk-pbt:commands 'dynamic-enable-machine :max 10)))
  (zk-pbt:run-commands 'dynamic-enable-machine ops))
(let ((r (zk-pbt:run 'dynamic-enable-shrinks :seed 42 :trials 100)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(((:arm) (:trigger))) (field r :reduced)))
  (assert (eq :reproduced (zk-pbt:replay r))))

(zk-pbt:defmachine weighted-post-machine
  (:model () 0)
  (:open () (list 0))
  (:command :add (n)
    (:weight 10)
    (:args (m) (zk-pbt:tuple (zk-pbt:integers :min 1 :max 4)))
    (:step (m) (+ m n))
    (:act (sut) (incf (car sut) n))
    (:post (before after actual)
      (and (= after (+ before n))
           (equal actual (list after)))))
  (:command :never-picked ()
    (:weight 0)
    (:step (m) m)
    (:act (sut) :unused)))
(let ((seqs (zk-pbt:sample (zk-pbt:commands 'weighted-post-machine :min 2 :max 5)
                           :seed 42 :count 15)))
