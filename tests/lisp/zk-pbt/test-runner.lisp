;; Bounded floats, typed vector-of/arrays, and enumeration through one-of/frequency/list-of.
(let ((fs (zk-pbt:sample (zk-pbt:floats :format 'double-float :min -2.5d0 :max 3.5d0)
                         :seed 42 :count 25)))
  (assert (every (lambda (x) (and (typep x 'double-float) (<= -2.5d0 x 3.5d0))) fs)))
(let ((octs (zk-pbt:sample (zk-pbt:vector-of (zk-pbt:integers :min 0 :max 255)
                                             :min 2 :max 4 :element-type '(unsigned-byte 8))
                           :seed 42 :count 10))
      (bits (zk-pbt:sample (zk-pbt:arrays (zk-pbt:integers :min 0 :max 1)
                                          :min-rank 1 :max-rank 1 :max-dim 4 :element-type 'bit)
                           :seed 42 :count 10)))
  (assert (every (lambda (v) (and (vectorp v) (<= 2 (length v) 4)
                                  (subtypep (array-element-type v) '(unsigned-byte 8))))
                 octs))
  (assert (every (lambda (a) (and (bit-vector-p a) (<= (length a) 4))) bits)))

(zk-pbt:defproperty enumerable-combinators (v)
  (:enumerate (zk-pbt:tuple
               (zk-pbt:one-of (zk-pbt:just nil)
                              (zk-pbt:frequency (list 0 (zk-pbt:just :skipped))
                                                (list 2 (zk-pbt:list-of (zk-pbt:elements :a :b) :min 0 :max 1))))))
  (or (null v) (and (listp v) (<= (length v) 1))))
(let ((r (zk-pbt:run 'enumerable-combinators :trials 0)))
  (assert (eq :passed (zk-pbt:report-status r)))
  ;; 1 from (just nil) + 1 empty list + 2 single-element lists = 4 enumerated cases.
  (assert (= 4 (getf (field r :counts) :enumerated))))

