;; Non-atomic split read-then-write exposes linearizability violation and shrinks cleanly.
(zk-pbt:defmachine racy-register
  (:model () 0)
  (:open () (list :val 0 :snap nil))
  (:command :read-snap ()
    (:step (m) (values m (list m)))
    (:act (sut) (setf (getf sut :snap) (getf sut :val))))
  (:command :write-from-snap ()
    (:step (m) (values (1+ m) (list (1+ m))))
    (:act (sut)
      (let ((next (1+ (or (getf sut :snap) (getf sut :val)))))
        (setf (getf sut :val) next)
        next))))
(zk-pbt:defproperty racy-register-catches-race
    ((plan (zk-pbt:parallel-commands 'racy-register :prefix-max 1 :branch-count 2 :branch-max 3)))
  (zk-pbt:run-parallel-commands 'racy-register plan))
(let ((r (zk-pbt:run 'racy-register-catches-race :seed 42 :trials 80)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(:claim (racy-register :linearizability)) (field r :failure)))
  (assert (eq :reproduced (zk-pbt:replay r))))

;;; Byte-stream choice source (generate-from-bytes / run-with-bytes)
(let ((g (zk-pbt:tuple (zk-pbt:integers :min 0 :max 10) (zk-pbt:booleans))))
  (multiple-value-bind (v1 tr1 n1) (zk-pbt:generate-from-bytes g #(5 1))
    (multiple-value-bind (v2 tr2 n2) (zk-pbt:generate-from-bytes g '(5 1))
      (assert (equal v1 v2))
      (assert (equal tr1 tr2))
      (assert (plusp n1))
      (assert (= n1 n2))))
  (multiple-value-bind (v-empty tr-empty n-empty) (zk-pbt:generate-from-bytes g #())
    (declare (ignore tr-empty))
    (assert (listp v-empty))
    (assert (= 2 (length v-empty)))
    (assert (= 0 n-empty)))
  (multiple-value-bind (v-str tr-str n-str) (zk-pbt:generate-from-bytes g "AB")
    (declare (ignore tr-str))
    (assert (listp v-str))
    (assert (= 2 (length v-str)))
    (assert (= 2 n-str))))

