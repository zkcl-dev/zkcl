(defpackage :runner-tests (:use :cl))
(in-package :runner-tests)
(defun status (name &rest options)
  (zk-pbt:report-status (apply #'zk-test:run name options)))
(defun field (report key) (getf (zk-pbt:report-data report) key))

(zk-test:deftest ordinary () (zk-test:is (null (values))))
(zk-test:deftest ordinary-failure () (zk-test:is (evenp 3)))
(zk-test:defsuite passing ordinary ordinary)
(assert (eq :passed (status 'passing)))
(assert (= 1 (length (field (zk-test:run 'passing) :results))))
(assert (eq :falsified (status 'ordinary-failure)))
(zk-test:defsuite cycle-a cycle-b)
(zk-test:defsuite cycle-b cycle-a)
(assert (eq :error (status 'cycle-a)))

(zk-pbt:defproperty thresholds (n)
  (:generate (zk-pbt:tuple (zk-pbt:integers :min 0 :max 100)))
  (zk-pbt:claim :under-seven (< n 7)))
(zk-pbt:defproperty failure-identity (n)
  (:generate (zk-pbt:tuple (zk-pbt:integers :min 0 :max 100)))
  (when (zerop n) (error "different defect"))
  (zk-pbt:claim :primary nil))
(zk-pbt:defproperty starvation (n)
  (:generate (zk-pbt:tuple (zk-pbt:such-that #'minusp (zk-pbt:just 1))))
  (minusp n))
(zk-pbt:defproperty coverage (n)
  (:generate (zk-pbt:tuple (zk-pbt:just 0)))
  (:examples (1))
  (:cover :positive :at-least 1/2)
  (zk-pbt:classify :positive (plusp n))
  t)
(zk-pbt:defproperty four-inputs (k v)
  (:generate (zk-pbt:tuple (zk-pbt:elements :a :b) (zk-pbt:elements nil 1)))
  (:examples (:a nil) (:b 0))
  (:enumerate (zk-pbt:tuple (zk-pbt:elements :a :b) (zk-pbt:elements nil -1 0 1)))
  (let ((h (make-hash-table)))
    (setf (gethash k h) v)
    (multiple-value-bind (value present) (gethash k h) (and present (eql value v)))))
(zk-test:defsuite mixed ordinary four-inputs)
(assert (equal (zk-test:list-tests 'mixed) '(ordinary four-inputs)))
(assert (member 'four-inputs (zk-test:list-tests)))
(assert (eq :passed (status 'mixed :seed 42 :trials 3)))
(let ((counts (field (zk-pbt:run 'four-inputs :seed 42 :trials 3) :counts)))
  (assert (equal counts '(:examples 2 :regression 0 :enumerated 8 :random 3 :discarded 0))))
(assert (eq :insufficient (status 'four-inputs :max-enumerated 7)))
(assert (eq :passed (status 'four-inputs :max-enumerated 8 :trials 0)))
(assert (eq :insufficient (status 'coverage :seed 42 :trials 3)))
(assert (eq :insufficient (status 'starvation :seed 42 :max-discards 3)))
(let ((r (zk-pbt:run 'thresholds :seed 42)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(7) (field r :reduced)))
  (assert (eq :reproduced (zk-pbt:replay r))))
(let ((r (zk-pbt:run 'failure-identity :seed 42)))
  (assert (equal '(:claim :primary) (field r :failure)))
  (assert (equal '(1) (field r :reduced))))

(defvar *tick* nil)
(zk-pbt:defproperty unstable (n)
  (:examples (1))
  (and n (prog1 *tick* (setf *tick* (not *tick*)))))
(assert (eq :unstable (status 'unstable)))
(zk-pbt:defproperty generator-signals-error (x)
  (:generate (zk-pbt:generator (draw size) (error "Generator failed before producing an input")))
  x)
(assert (eq :error (status 'generator-signals-error)))

