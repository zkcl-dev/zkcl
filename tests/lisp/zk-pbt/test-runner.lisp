;;; Exception differential checking, :compare, :nondet, and :close cleanup
(defvar *model-closed-count* 0)
(zk-pbt:defmodel model-advanced-features
  (:abstract :res
    :check (lambda (ref cand) (= ref (car cand)))
    :close (lambda (cand) (declare (ignore cand)) (incf *model-closed-count*)))
  (:op :open ((x (zk-pbt:elements 1 2)))
    (:returns (:abstract :res))
    (:ref (lambda (x) x))
    (:cand (lambda (x) (list x))))
  (:op :pick ((x (zk-pbt:elements 1 2)))
    (:returns (:nondet (lambda (args res) (member res (list (first args) (1+ (first args)))))))
    (:ref (lambda (x) x))
    (:cand (lambda (x) (1+ x))))
  (:op :mod10 ((x (zk-pbt:integers :min 0 :max 5)))
    (:returns (:compare (lambda (a b) (= (mod a 10) (mod b 10)))))
    (:ref (lambda (x) x))
    (:cand (lambda (x) (+ x 10))))
  (:op :may-fail ((bad (zk-pbt:booleans)))
    (:returns :value)
    (:ref (lambda (bad) (if bad (error "ref fail") :ok)))
    (:cand (lambda (bad) (if bad (error "cand fail") :ok)))))

(let ((*model-closed-count* 0))
  (assert (eq t (zk-pbt:run-model 'model-advanced-features
                                  '((:open ((:mref :res 0)) (1))
                                    (:pick nil (2))
                                    (:mod10 nil (4))
                                    (:may-fail nil (t))
                                    (:may-fail nil (nil))))))
  (assert (= 1 *model-closed-count*)))

(zk-pbt:defmodel model-exn-mismatch
  (:abstract :res :close (lambda (cand) (declare (ignore cand)) (incf *model-closed-count*)))
  (:op :open ((x (zk-pbt:elements 1)))
    (:returns (:abstract :res))
    (:ref (lambda (x) x))
    (:cand (lambda (x) (list x))))
  (:op :boom ()
    (:returns :value)
    (:ref (lambda () (error "expected")))
    (:cand (lambda () :did-not-throw)))
  (:op :unexpected ()
    (:returns :value)
    (:ref (lambda () :ok))
    (:cand (lambda () (error "unexpected")))))

(let* ((*model-closed-count* 0)
       (err1 (handler-case (zk-pbt:run-model 'model-exn-mismatch
                                             '((:open ((:mref :res 0)) (1))
                                               (:boom nil nil)))
               (zk-pbt::property-violation (c) (zk-pbt::property-violation-key c)))))
  (assert (equal '(model-exn-mismatch :boom :missing-exception) err1))
  (assert (= 1 *model-closed-count*)))
(let ((err2 (handler-case (zk-pbt:run-model 'model-exn-mismatch '((:unexpected nil nil)))
              (zk-pbt::property-violation (c) (zk-pbt::property-violation-key c)))))
  (assert (equal '(model-exn-mismatch :unexpected :unexpected-exception) err2)))

;;; bit-vectors, grammar, and extended type-gen
(let ((bvs (zk-pbt:sample (zk-pbt:bit-vectors :min 2 :max 6) :count 10 :seed 42)))
  (assert (every #'bit-vector-p bvs))
  (assert (every (lambda (b) (<= 2 (length b) 6)) bvs)))
(assert (every (lambda (b) (and (bit-vector-p b) (= 4 (length b))))
               (zk-pbt:sample (zk-pbt:type-gen '(bit-vector 4)) :count 6 :seed 9)))
(assert (every #'atom (zk-pbt:sample (zk-pbt:type-gen 'atom) :count 12 :seed 9)))

(let ((g (zk-pbt:grammar `((:expr (+ :expr :expr) (- :expr) :leaf)
                           (:leaf ,(zk-pbt:integers :min 0 :max 5) x))
                         :expr :max-depth 4)))
  (labels ((eval-gram (e)
             (cond
               ((numberp e) e)
               ((eq e 'x) 1)
               ((and (consp e) (eq (car e) '-)) (- (eval-gram (second e))))
               ((and (consp e) (eq (car e) '+)) (+ (eval-gram (second e)) (eval-gram (third e))))
               (t 0))))
    (let ((samples (zk-pbt:sample g :count 15 :seed 42)))
      (assert (= 15 (length samples)))
      (assert (every #'integerp (mapcar #'eval-gram samples))))
    (let ((r (zk-pbt:for-all ((expr g))
               (:name grammar-shrink-contract)
               (:seed 42) (:trials 50) (:check nil)
               (< (eval-gram expr) 6))))
      (assert (eq :falsified (zk-pbt:report-status r)))
      (assert (<= (eval-gram (car (field r :reduced))) 10))
      (assert (eq :reproduced (zk-pbt:replay r))))))

;;; Evolutionary fuzzer (fuzz-property)
(zk-pbt:defproperty fuzz-target-pair ((pair (zk-pbt:tuple (zk-pbt:integers :min 0 :max 20)
                                                         (zk-pbt:integers :min 0 :max 20))))
  (let ((a (first pair))
        (b (second pair)))
    (zk-pbt:target (+ a b) :pair-sum)
    (zk-pbt:classify :big-a (> a 10))
    (not (and (>= a 12) (>= b 12)))))
(let ((r (zk-pbt:fuzz-property 'fuzz-target-pair :iterations 400 :seed 42)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (let* ((pair (first (field r :reduced)))
         (a (first pair))
         (b (second pair)))
    (assert (and (>= a 12) (>= b 12))))
  (assert (vectorp (field r :fuzz-bytes)))
  (assert (eq r zk-pbt:*last-failure*))
  (assert (eq :reproduced (zk-pbt:replay r))))
(zk-pbt:defproperty fuzz-always-passes ((bv (zk-pbt:bit-vectors :min 0 :max 8)))
  (>= (length bv) 0))
(let ((r (zk-pbt:fuzz-property 'fuzz-always-passes :iterations 25 :seed 42)))
  (assert (eq :passed (zk-pbt:report-status r)))
  (assert (= 25 (getf (field r :counts) :fuzz))))

