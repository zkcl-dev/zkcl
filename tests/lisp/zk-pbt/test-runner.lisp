;; State-machine :invariant catches representation drift automatically.
(zk-pbt:defmachine invariant-checked-box
  (:model () 0)
  (:open () (list 0 0))
  (:close (sut) (setf (first sut) nil))
  (:invariant (model sut) (= model (first sut)))
  (:command :inc (delta)
    (:args (m) (zk-pbt:tuple (zk-pbt:integers :min 1 :max 5)))
    (:step (m) (values (+ m delta) (list (+ m delta))))
    (:act (sut)
      (incf (second sut) delta)
      (when (<= (+ (first sut) delta) 6)
        (incf (first sut) delta))
      (second sut))))
(zk-pbt:defproperty box-keeps-invariant ((ops (zk-pbt:commands 'invariant-checked-box :max 10)))
  (zk-pbt:run-commands 'invariant-checked-box ops))
(let ((r (zk-pbt:run 'box-keeps-invariant :seed 42 :trials 100)))
  (assert (eq :falsified (zk-pbt:report-status r)))
  (assert (equal '(:claim (invariant-checked-box :inc :invariant)) (field r :failure))))

