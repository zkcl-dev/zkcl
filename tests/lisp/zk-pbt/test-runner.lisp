;; Timeout budget stops gracefully with :stop-reason :timeout.
(zk-pbt:defproperty slow-timeout-prop ((n (zk-pbt:integers :min 0 :max 10)))
  (dotimes (k 500) (declare (ignore k)) (+ n 1))
  t)
(let* ((r (zk-pbt:run 'slow-timeout-prop :seed 42 :trials 50000 :timeout-ms 10))
       (text (with-output-to-string (*standard-output*) (zk-test:print-report r)))
       (json (with-output-to-string (s) (zk-test:write-json-report r s))))
  (assert (member (zk-pbt:report-status r) '(:passed :insufficient)))
  (assert (< (getf (field r :counts) :random) 50000))
  (assert (or (eq :timeout (field r :stop-reason))
              (eq :timeout (field r :reason))))
  (when (eq :timeout (field r :stop-reason))
    (assert (search "stop-reason: :TIMEOUT" text))
    (assert (search "\"stop_reason\": \"timeout\"" json))))

