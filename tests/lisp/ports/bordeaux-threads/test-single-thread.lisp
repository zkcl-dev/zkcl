;;;; Run with the Bordeaux Threads 0.9.4 distribution and dependencies in ASDF's source registry.
(require :asdf)
(asdf:load-system "bordeaux-threads")

(assert (not (or (member :thread-support *features*) (member :bordeaux-threads *features*)
                 bt:*supports-threads-p* bt2:+supports-threads-p+)))
(let ((thread (bt:current-thread)))
  (assert (bt:threadp thread))
  (assert (not (bt:threadp nil)))
  (assert (bt:thread-alive-p thread))
  (assert (eq thread (bt:current-thread)))
  (assert (equal (list thread) (bt:all-threads)))
  (assert (string= "Main thread" (bt:thread-name thread)))
  (assert (eq thread (bt2:thread-native-thread (bt2:current-thread)))))
(let ((lock (bt:make-lock)) (recursive (bt:make-recursive-lock)))
  (assert (and (bt:lock-p lock) (typep lock 'bt:lock)))
  (assert (bt:recursive-lock-p recursive))
  (assert (= 42 (bt:with-lock-held (lock)
                  (bt:with-recursive-lock-held (recursive) 42))))
  (assert (handler-case
              (progn (bt:condition-wait (bt:make-condition-variable) lock) nil)
            (bt::bordeaux-mp-condition () t))))
(let ((ran nil))
  (assert (handler-case (progn (bt:make-thread (lambda () (setf ran t))) nil)
            (bt::bordeaux-mp-condition () t)))
  (assert (not ran)))
(let ((lock (bt2:make-lock :name "single")) (places 0))
  (assert (and (bt2:lockp lock) (string= (bt2:lock-name lock) "single")))
  (assert (bt2:native-lock-p (bt2:lock-native-lock lock)))
  (assert (eq :exit (catch 'done
                      (bt2:with-lock-held ((progn (incf places) lock))
                        (assert (not (bt2:acquire-lock lock :wait nil)))
                        (throw 'done :exit)))))
  (assert (= places 1))
  (assert (bt2:acquire-lock lock))
  (assert (eq lock (bt2:release-lock lock))))
(let ((lock (bt2:make-recursive-lock)))
  (assert (bt2:recursive-lock-p lock))
  (assert (equal '(7 8) (multiple-value-list
                          (bt2:with-recursive-lock-held (lock)
                            (bt2:with-recursive-lock-held (lock) (values 7 8)))))))
(let ((condition (bt2:make-condition-variable :name "ready"))
      (lock (bt2:make-lock)))
  (assert (bt2:condition-variable-p condition))
  (assert (handler-case
              (progn (bt2:with-lock-held (lock)
                       (bt2:condition-wait condition lock :timeout (ash 1 80))) nil)
            (error () t)))
  (assert (bt2:acquire-lock lock :wait nil))
  (bt2:release-lock lock)
  (assert (null (bt2:condition-broadcast condition)))
  (bt2:with-lock-held (lock)
    (assert (null (bt2:condition-wait condition lock :timeout 0)))
    (assert (not (bt2:acquire-lock lock :wait nil))))
  (assert (handler-case (progn (bt2:with-lock-held (lock)
                                 (bt2:condition-wait condition lock)) nil)
            (bt2:not-implemented () t))))
(let ((sem (bt2:make-semaphore :count 1)))
  (assert (bt2:semaphorep sem))
  (assert (bt2:wait-on-semaphore sem))
  (assert (bt2:signal-semaphore sem))
  (assert (bt2:wait-on-semaphore sem))
  (assert (null (bt2:wait-on-semaphore sem :timeout 0))))
(let* ((width #+64-bit 64 #+32-bit 32)
       (limit (ash 1 width))
       (max (1- limit))
       (counter (bt2:make-atomic-integer :value max)))
  (assert (typep counter 'bt2:atomic-integer))
  (assert (handler-case (progn (bt2:make-atomic-integer :value limit) nil)
            (type-error (c) (equal (type-error-expected-type c) (list 'unsigned-byte width)))))
  (assert (zerop (bt2:atomic-integer-incf counter)))
  (assert (= max (bt2:atomic-integer-decf counter)))
  (assert (not (bt2:atomic-integer-compare-and-swap counter 0 7)))
  (assert (bt2:atomic-integer-compare-and-swap counter max 7))
  (zk:gc)
  (assert (= 7 (bt2:atomic-integer-value counter)))
  (assert (= 10 (bt2:atomic-integer-incf counter 3)))
  (assert (= 4 (bt2:atomic-integer-decf counter 6)))
  (assert (= max (setf (bt2:atomic-integer-value counter) max)))
  (assert (handler-case (progn (bt2:atomic-integer-compare-and-swap counter max limit) nil)
            (type-error () t)))
  (assert (handler-case (progn (setf (bt2:atomic-integer-value counter) -1) nil)
            (type-error () t)))
  (assert (handler-case (progn (bt2:atomic-integer-incf counter -1) nil)
            (type-error () t)))
  (assert (= max (bt2:atomic-integer-value counter))))
(let ((thread (bt2:current-thread)) (ran nil))
  (assert (bt2:threadp thread))
  (assert (equal (list thread) (bt2:all-threads)))
  (assert (eq thread (bt2:current-thread)))
  (assert (string= "Main thread" (bt2:thread-name thread)))
  (assert (bt2:thread-alive-p thread))
  (assert (handler-case (progn (bt2:make-thread (lambda () (setf ran t))) nil)
            (bt2:not-implemented () t)))
  (assert (handler-case (progn (bt2:interrupt-thread thread (lambda () (setf ran t))) nil)
            (bt2:not-implemented () t)))
  (assert (handler-case (progn (bt2:with-timeout (1) (setf ran t)) nil)
            (bt2:not-implemented () t)))
  (assert (not ran)))
(format t "~&Bordeaux Threads single-thread checks passed.~%")
