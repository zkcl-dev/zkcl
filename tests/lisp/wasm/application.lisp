(defvar *input* 3 "Input used by the Wasm application.")
(defvar *input* (error "DEFVAR must preserve the existing value"))
(declaim (notinline wait-for-timer))

(defun increment (number)
  (1+ number))

(defun multiply (left right)
  (* left right))

(defun vop-chain (left right)
  (if (< (1+ left) right)
      (* (- right left) (1+ left))
      (1- right)))

(defun vop-join (swap left right)
  (let ((left (1+ left)) (right (1+ right)))
    (when swap (psetq left right right left))
    (- left right)))

(defun vop-fold (value offset)
  (- (* value 2 3) offset 1 (- offset)))

(defun vop-bits (left right)
  (if (logtest left right)
      (logxor (logand left 255) (logior right 128))
      (lognot left)))

(defun vop-sign-bit (value)
  (logbitp 104 value))

(defun vop-loop (count)
  (let ((total 0))
    (dotimes (i count total) (incf total i))))

(defun use-vop-loop (count)
  (list (vop-loop count)))

(defparameter *original* #'increment)

(defun sum-loop (count)
  (let ((sum 0))
    (dotimes (index count sum)
      (incf sum index))))

(defun rotate-loop (count left right)
  (dotimes (index count (values left right))
    (psetq left right right left)))

(defun nested-loops (rows columns)
  (let ((sum 0))
    (dotimes (row rows sum)
      (dotimes (column columns)
        (incf sum (+ row column))))))

(defun alternate (left-first count)
  (let ((left 0) (right 0))
    (tagbody
      (if left-first (go left) (go right))
      left
      (incf left)
      (when (plusp (decf count)) (go right))
      (go done)
      right
      (incf right)
      (when (plusp (decf count)) (go left))
      done)
    (values left right)))

(defun closure-after-gc (value)
  (let ((combine (lambda (delta)
                   (zk:gc)
                   (incf (car value) delta))))
    (values (funcall combine 2) value)))

(defun throw-values (first second)
  (throw 'done (values first second)))

(defun recover-values (value)
  (catch 'done
    (unwind-protect (throw-values value 'second)
      (zk:gc)
      (unless (= *input* 41) (error "missing dynamic binding during cleanup")))))

(defun wait-for-timer ()
  (sleep 1/100)
  :done)

(defun optional-values (required &optional (first required first-p)
                                           (second (progn (zk:gc) first) second-p))
  (values first first-p second second-p))

(defun optional-identity (&optional value)
  value)

(defun rest-values (head &rest tail)
  (zk:gc)
  (values head tail))

(defun keyword-values (&optional (seed :default seed-p) &rest pairs
                        &key (first (progn (zk:gc) seed) first-p)
                             (second seed second-p))
  (values pairs first first-p second second-p seed-p))

(defun trace-between-calls (number)
  (let ((first (+ number 1)))
    (trace +)
    (values first (+ number 2))))

(defun call-null (value)
  (null value))

(defvar *missing-value*)

(defun recover-unbound-variable ()
  (handler-case *missing-value*
    (unbound-variable () :unbound)))

(defun recover-undefined-function ()
  (let ((cleaned nil))
    (handler-case
        (unwind-protect (missing-wasm-function)
          (setf cleaned t))
      (undefined-function () cleaned))))

(defun read-input ()
  *input*)

(let ((mode (first (zk:command-line-arguments))))
  (cond ((equal mode "--sync-sleep")
         ;; Macro expansion reenters Lisp through a pinned Rust frame.
         (assert (eq (eval '(macrolet ((sleep-in-expander () (sleep 1/40) :awake))
                             (sleep-in-expander)))
                     :awake))
         (write-line "sync finished"))
        ((member mode '("--external-cancel" "--cancel-after-poll") :test #'equal)
         (let ((*input* :external))
           (unwind-protect (progn
                             (write-line "parked")
                             (when (equal mode "--cancel-after-poll")
                               (sleep 1/200)
                               (write-line "reparked"))
                             (sleep 60)
                             (error "external cancellation was not delivered"))
             (assert (eq *input* :external))
             (write-line "cleanup started")
             (sleep 1/40)
             (zk:gc)
             (write-line "cleanup finished"))))))

(let ((*input* 41)
      (saved (list 40 2)))
  (unwind-protect
       (progn
         (sleep 0)
         (format t "waiting ~a~%" (first (zk:command-line-arguments)))
         (finish-output)
         (let ((before (get-internal-real-time)))
           (wait-for-timer)
           (assert (> (get-internal-real-time) before)))
         (assert (> (get-universal-time) 2208988800))
         (assert (random-state-p (make-random-state t)))
         (zk:gc)
         (assert (= (read-input) 41))
         (assert (eq (recover-unbound-variable) :unbound))
         (assert (recover-undefined-function))
         (assert (= (sum-loop 100) 4950))
         (assert (= (nested-loops 7 11) 616))
         (assert (equal (multiple-value-list (alternate t 7)) '(4 3)))
         (assert (equal (multiple-value-list (alternate nil 7)) '(3 4)))
         (multiple-value-bind (left right) (rotate-loop 9 :left :right)
           (assert (eq left :right))
           (assert (eq right :left)))
         (let ((list (list 40)))
           (multiple-value-bind (answer retained) (closure-after-gc list)
             (assert (= answer 42))
             (assert (eq retained list))
             (assert (= (car retained) 42)))
           (multiple-value-bind (first second) (recover-values list)
             (assert (eq list first))
             (assert (eq second 'second)))
           (assert (equal (multiple-value-list (optional-values list))
                          (list list nil list nil)))
           (assert (equal (multiple-value-list (optional-values list list))
                          (list list t list nil)))
           (assert (equal (multiple-value-list (optional-values list nil :second))
                          '(nil t :second t)))
           (assert (null (optional-identity)))
           (assert (eq list (optional-identity list)))
           (multiple-value-bind (head tail) (rest-values :head list nil :end)
             (assert (eq head :head))
             (assert (eq (first tail) list))
             (assert (equal (rest tail) '(nil :end))))
           (assert (equal (multiple-value-list (rest-values list)) (list list nil)))
           (assert (equal (multiple-value-list (keyword-values))
                          '(nil :default nil :default nil nil)))
           (multiple-value-bind (pairs first first-p second second-p seed-p)
               (keyword-values :seed :second list :second :ignored)
             (assert (eq (second pairs) list))
             (assert (eq first :seed))
             (assert (not first-p))
             (assert (eq second list))
             (assert second-p)
             (assert seed-p))
           (assert (equal (multiple-value-list
                           (keyword-values nil :first nil :unknown list :allow-other-keys t))
                          (list (list :first nil :unknown list :allow-other-keys t)
                                nil t nil nil t)))
           (assert (handler-case (progn (keyword-values :seed :unknown list) nil)
                     (program-error () t)))
           (assert (handler-case (progn (keyword-values :seed :first) nil)
                     (program-error () t))))
         (assert (= (funcall *original* *input*) 42))
         (assert (= (multiply -7 6) -42))
         (assert (= (vop-chain 2 8) 18))
         (assert (= (vop-chain 5 2) 1))
         (assert (= (vop-chain (1- (ash 1 28)) 7) 6))
         (assert (= (vop-join nil 5 9) -4))
         (assert (= (vop-join t 5 9) 4))
         (assert (= (vop-fold 8 7) 47))
         (assert (= (vop-bits -1 2) 125))
         (assert (= (vop-bits 4 2) -5))
         (assert (= (vop-bits -1 (ash 1 100)) (+ (ash 1 100) 127)))
         (assert (vop-sign-bit -2))
         (assert (not (vop-sign-bit 4)))
         (assert (vop-sign-bit (ash 1 104)))
         (assert (= (vop-loop -3) 0))
         (assert (= (vop-loop 16) 120))
         (assert (= (vop-loop 300) 44850))
         (assert (equal (use-vop-loop 300) '(44850)))
         (assert (eq (handler-case (vop-chain :bad 7)
                       (type-error (condition) (type-error-datum condition)))
                     :bad))
         (let ((*trace-output* (make-string-output-stream)))
           (unwind-protect
                (progn
                  (trace *)
                  (assert (= (multiply -7 6) -42))
                  (assert (search "*" (get-output-stream-string *trace-output*))))
             (untrace *)))
         (let ((*trace-output* (make-string-output-stream)))
           (unwind-protect
                (progn
                  (assert (equal (multiple-value-list (trace-between-calls 40)) '(41 42)))
                  (assert (search "+" (get-output-stream-string *trace-output*))))
             (untrace +)))
         (let ((*trace-output* (make-string-output-stream)))
           (unwind-protect
                (progn
                  (trace null)
                  (assert (call-null nil))
                  (assert (search "NULL" (get-output-stream-string *trace-output*))))
             (untrace null)))
         (let ((wide (increment (1- (ash 1 28)))))
           (assert (= wide (ash 1 28)))
           #+wasm32 (assert (typep wide 'bignum)))
         (eval '(defun increment (number) (+ 2 number)))
         (assert (= (increment *input*) 43))
         (multiple-value-bind (left right) (values-list saved)
           (assert (= (funcall *original* (1+ left)) (+ left right)))))
    (assert (= *input* 41))
    (zk:gc)
    (format t "cleanup~%")))

(assert (= *input* 3))
(assert (string= (documentation '*input* 'variable) "Input used by the Wasm application."))

(defun task-scalar (left right)
  (+ left right))

(defun task-revision () :old)

(defvar *task-parking* nil)

(defun task-suspend (delay)
  (setf *task-parking* t)
  (sleep delay)
  (zk-async:yield)
  (values))

(let ((saved (list :payload))
      (previous #'task-revision)
      (updated nil)
      (cleaned nil))
  (zk-async:with-task-group (group)
    (let ((worker (let ((*input* :worker))
                    (zk-async:spawn-task (group)
                      (unwind-protect
                           (progn
                             (unless (null (multiple-value-list (task-suspend 1/100)))
                               (error "TASK-SUSPEND must return zero values"))
                             (assert updated)
                             (values (task-scalar 19 23) *input* saved
                                     (funcall previous) (task-revision)))
                        (assert (eq *input* :worker))
                        (setf cleaned t))))))
      (loop until *task-parking* do (zk-async:yield))
      (assert (= *input* 3))
      (zk:gc)
      (eval '(defun task-revision () :new))
      (setf updated t)
      (multiple-value-bind (number binding payload old new) (zk-async:await worker)
        (assert (= number 42))
        (assert (eq binding :worker))
        (assert (eq payload saved))
        (assert (eq old :old))
        (assert (eq new :new)))
      (assert cleaned))))

(setf *task-parking* nil)
(let ((cleanups nil))
  (zk-async:with-task-group (group)
    (let ((worker (let ((*input* :cancelled))
                    (zk-async:spawn-task (group)
                      (unwind-protect
                           (unwind-protect (task-suspend 10)
                             (push :inner cleanups)
                             (assert (zk-async:task-cancelled-p))
                             (zk-async:cancel-task (zk-async:current-task))
                             (sleep 1/100)
                             (push :resumed cleanups))
                        (zk:gc)
                        (assert (eq *input* :cancelled))
                        (push :outer cleanups))))))
      (loop until *task-parking* do (zk-async:yield))
      ;; If the worker exhausted its slice immediately after the marker, let
      ;; it reach SLEEP before asking the scheduler to cancel the timer.
      (zk-async:yield)
      (assert (zk-async:cancel-task worker))
      (assert (handler-case (progn (zk-async:await worker) nil)
                (zk-async:waited-task-cancelled () t)))
      (assert (equal cleanups '(:outer :resumed :inner)))
      (assert (= *input* 3)))))

(zk:set-exit-code 17)
