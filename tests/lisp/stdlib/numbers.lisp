(in-package #:zkcl-stdlib-tests)

(zk-pbt:defproperty exact-integer-ring-laws ((a (zk-pbt:exact-integers))
                                           (b (zk-pbt:exact-integers))
                                           (c (zk-pbt:exact-integers)))
  (zk-test:is= (+ a b) (+ b a))
  (zk-test:is= (* a b) (* b a))
  (zk-test:is= (+ (+ a b) c) (+ a (+ b c)))
  (zk-test:is= (* (* a b) c) (* a (* b c)))
  (zk-test:is= (* a (+ b c)) (+ (* a b) (* a c)))
  (zk-test:is= (+ a (- a)) 0)
  (zk-test:is= (- a b) (+ a (- b)))
  t)

(zk-pbt:defproperty integer-division-laws ((n (zk-pbt:exact-integers))
                                         (d (zk-pbt:such-that (lambda (x) (not (zerop x)))
                                                              (zk-pbt:exact-integers)
                                                              :attempts 30)))
  (multiple-value-bind (fq fr) (floor n d)
    (zk-test:is= n (+ (* fq d) fr))
    (if (plusp d)
        (zk-test:is (and (<= 0 fr) (< fr d)))
        (zk-test:is (and (<= fr 0) (> fr d))))
    (zk-test:is= fr (mod n d)))
  (multiple-value-bind (cq cr) (ceiling n d)
    (zk-test:is= n (+ (* cq d) cr))
    (if (plusp d)
        (zk-test:is (and (<= cr 0) (> cr (- d))))
        (zk-test:is (and (<= 0 cr) (< cr (- d))))))
  (multiple-value-bind (tq tr) (truncate n d)
    (zk-test:is= n (+ (* tq d) tr))
    (zk-test:is (< (abs tr) (abs d)))
    (unless (zerop tr)
      (zk-test:is= (signum tr) (signum n)))
    (zk-test:is= tr (rem n d)))
  (multiple-value-bind (rq rr) (round n d)
    (zk-test:is= n (+ (* rq d) rr))
    (zk-test:is (<= (* 2 (abs rr)) (abs d))))
  t)

(zk-pbt:defproperty gcd-lcm-laws ((a (zk-pbt:exact-integers))
                                (b (zk-pbt:exact-integers)))
  (let ((g (gcd a b))
        (l (lcm a b)))
    (zk-test:is (not (minusp g)))
    (zk-test:is (not (minusp l)))
    (zk-test:is= g (gcd b a))
    (zk-test:is= l (lcm b a))
    (zk-test:is= (* g l) (abs (* a b)))
    (when (plusp g)
      (zk-test:is= 0 (rem a g))
      (zk-test:is= 0 (rem b g)))
    (when (or (zerop a) (zerop b))
      (zk-test:is= 0 l)))
  t)

(zk-pbt:defproperty bitwise-and-byte-laws ((a (zk-pbt:exact-integers))
                                         (b (zk-pbt:exact-integers))
                                         (shift (zk-pbt:integers :min -40 :max 40))
                                         (pos (zk-pbt:integers :min 0 :max 64))
                                         (width (zk-pbt:integers :min 0 :max 32)))
  (zk-test:is= (lognot (lognot a)) a)
  (zk-test:is= (lognot (logand a b)) (logior (lognot a) (lognot b)))
  (zk-test:is= (lognot (logior a b)) (logand (lognot a) (lognot b)))
  (zk-test:is= (logxor a a) 0)
  (zk-test:is= (logxor (logxor a b) b) a)
  (zk-test:is= (ash a shift) (floor (* a (expt 2 shift))))
  (dotimes (i 16)
    (zk-test:is (eq (logbitp i a) (naive-logbitp-model i a))))
  (let* ((spec (byte width pos))
         (extracted (ldb spec a))
         (roundtrip (dpb extracted spec a)))
    (zk-test:is (and (<= 0 extracted) (< extracted (ash 1 width))))
    (zk-test:is= roundtrip a)
    (zk-test:is= (ldb spec (dpb -1 spec a)) (1- (ash 1 width))))
  t)

(zk-pbt:defproperty ratio-canonical-and-field-laws
    ((r (zk-pbt:ratios :max-bits 64))
     (s (zk-pbt:rationals :max-bits 64)))
  (let ((num (numerator r))
        (den (denominator r)))
    (zk-test:is (> den 1))
    (zk-test:is= (gcd num den) 1)
    (zk-test:is= r (/ num den))
    (zk-test:is= (* r (/ r)) 1)
    (zk-test:is= (+ (+ r s) (- s)) r))
  t)

(zk-pbt:defproperty float-decode-scale-roundtrip
    ((x (zk-pbt:one-of (zk-pbt:floats :format 'single-float)
                       (zk-pbt:floats :format 'double-float))))
  (multiple-value-bind (sig exp sign) (integer-decode-float x)
    (let ((reconstructed (* sign (scale-float (float sig x) exp))))
      (zk-test:is (eql x reconstructed))
      (zk-test:is (eql (float-sign x) (float-sign reconstructed)))))
  t)
