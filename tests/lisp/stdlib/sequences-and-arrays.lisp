(in-package #:zkcl-stdlib-tests)

(zk-pbt:defproperty sort-and-stable-sort-match-oracle
    ((xs (zk-pbt:list-of (zk-pbt:integers :min -10 :max 10) :max 40)))
  (let* ((tagged (loop for x in xs for i from 0 collect (cons x i)))
         (expected (insertion-sort-oracle tagged (lambda (a b) (< (car a) (car b)))))
         (sorted-list (stable-sort (copy-list tagged) #'< :key #'car))
         (sorted-vec (stable-sort (coerce tagged 'vector) #'< :key #'car))
         (plain-sorted (sort (copy-list xs) #'<))
         (plain-expected (mapcar #'car expected)))
    (zk-test:is-equal expected sorted-list)
    (zk-test:is-equal expected (coerce sorted-vec 'list))
    (zk-test:is-equal plain-expected plain-sorted))
  t)

(zk-pbt:defproperty displaced-and-fill-pointer-sort-isolates-neighbors
    ((xs (zk-pbt:list-of (zk-pbt:integers :min -20 :max 20) :max 25))
     (offset (zk-pbt:integers :min 1 :max 5)))
  (let* ((n (length xs))
         (backing (make-array (+ n offset 3) :initial-element 999))
         (sub (make-array n :displaced-to backing :displaced-index-offset offset))
         (fp-vec (make-array (+ n 4) :fill-pointer n :initial-element -777))
         (expected (insertion-sort-oracle xs #'<)))
    (loop for x in xs for i from 0 do
      (setf (aref backing (+ offset i)) x
            (aref fp-vec i) x))
    (sort sub #'<)
    (sort fp-vec #'<)
    (zk-test:is-equal expected (coerce sub 'list))
    (zk-test:is-equal expected (coerce fp-vec 'list))
    (dotimes (i offset)
      (zk-test:is= 999 (aref backing i)))
    (loop for i from (+ offset n) below (length backing) do
      (zk-test:is= 999 (aref backing i)))
    (loop for i from n below (array-total-size fp-vec) do
      (zk-test:is= -777 (aref fp-vec i))))
  t)

(zk-pbt:defproperty sequence-operations-agree-across-representations
    ((xs (zk-pbt:list-of (zk-pbt:integers :min -5 :max 5) :max 20))
     (target (zk-pbt:integers :min -5 :max 5))
     (replacement (zk-pbt:integers :min 10 :max 20))
     (from-end (zk-pbt:booleans)))
  (let* ((n (length xs))
         (vec (coerce xs 'vector))
         (list-rem (remove target xs :from-end from-end))
         (vec-rem (coerce (remove target vec :from-end from-end) 'list))
         (list-sub (substitute replacement target xs :from-end from-end))
         (vec-sub (coerce (substitute replacement target vec :from-end from-end) 'list)))
    (zk-test:is-equal list-rem vec-rem)
    (zk-test:is-equal list-sub vec-sub)
    (zk-test:is-equal (position target xs :from-end from-end)
                      (position target vec :from-end from-end))
    (zk-test:is= (count target xs) (count target vec))
    (zk-test:is= (reduce #'+ xs :initial-value 0)
                 (reduce #'+ vec :initial-value 0))
    (when (plusp n)
      (let* ((start (floor n 3))
             (end (min n (+ start (max 1 (floor n 2))))))
        (zk-test:is-equal (subseq xs start end)
                          (coerce (subseq vec start end) 'list))
        (zk-test:is-equal xs
                          (concatenate 'list
                                       (subseq xs 0 start)
                                       (subseq xs start end)
                                       (subseq xs end))))))
  t)

(zk-pbt:defproperty list-set-algebra-laws
    ((xs (zk-pbt:list-of (zk-pbt:integers :min 0 :max 12) :max 15))
     (ys (zk-pbt:list-of (zk-pbt:integers :min 0 :max 12) :max 15)))
  (let* ((a (remove-duplicates xs))
         (b (remove-duplicates ys))
         (u (union a b))
         (inter (intersection a b))
         (a-b (set-difference a b))
         (b-a (set-difference b a))
         (sym (set-exclusive-or a b)))
    (zk-test:is (subsetp inter a))
    (zk-test:is (subsetp inter b))
    (zk-test:is (subsetp a u))
    (zk-test:is (subsetp b u))
    (zk-test:is (subsetp a-b a))
    (zk-test:is (null (intersection a-b b)))
    (zk-test:is (= (length u) (+ (length a) (length b) (- (length inter)))))
    (zk-test:is (= (length sym) (+ (length a-b) (length b-a))))
    (zk-test:is (and (subsetp sym (union a-b b-a))
                     (subsetp (union a-b b-a) sym))))
  t)

(defun check-adjustable-vector-invariants (model vec)
  (and (arrayp vec)
       (adjustable-array-p vec)
       (array-has-fill-pointer-p vec)
       (= (length vec) (fill-pointer vec) (length model))
       (<= (fill-pointer vec) (array-total-size vec))
       (equal (coerce vec 'list) model)))

(zk-pbt:defmachine adjustable-vector-machine
  (:model () nil)
  (:open () (make-array 2 :fill-pointer 0 :adjustable t :initial-element 0))
  (:close (v) (setf (fill-pointer v) 0))
  (:invariant (model vec) (check-adjustable-vector-invariants model vec))
  (:command :push-extend (x)
    (:args (m) (zk-pbt:tuple (zk-pbt:integers :min -20 :max 20)))
    (:step (m) (values (append m (list x)) (list (length m))))
    (:act (vec) (vector-push-extend x vec)))
  (:command :pop ()
    (:enabled (m) (not (null m)))
    (:args (m) (zk-pbt:tuple))
    (:step (m) (values (butlast m) (last m)))
    (:act (vec) (vector-pop vec)))
  (:command :set-elt (idx val)
    (:enabled (m) (not (null m)))
    (:args (m)
      (zk-pbt:tuple (zk-pbt:integers :min 0 :max (1- (length m)))
                    (zk-pbt:integers :min -20 :max 20)))
    (:step (m)
      (let ((next (copy-list m)))
        (setf (nth idx next) val)
        (values next (list val))))
    (:act (vec)
      (setf (aref vec idx) val)))
  (:command :shrink (new-size)
    (:args (m) (zk-pbt:tuple (zk-pbt:integers :min 0 :max (length m))))
    (:step (m)
      (values (subseq m 0 new-size) (list new-size)))
    (:act (vec)
      (adjust-array vec new-size :fill-pointer new-size)
      (length vec))))

(zk-pbt:defproperty adjustable-vector-state-machine
    ((ops (zk-pbt:commands 'adjustable-vector-machine :max 20)))
  (zk-pbt:run-commands 'adjustable-vector-machine ops))

(zk-pbt:defmachine plist-machine
  (:model () nil)
  (:open () (list :plist nil))
  (:close (box) (setf (second box) nil))
  (:command :put (k v)
    (:args (m) (zk-pbt:tuple (zk-pbt:elements :a :b :c) (zk-pbt:elements nil 0 1 :x)))
    (:step (m) (values (cons (cons k v) (remove k m :key #'car)) (list v)))
    (:act (box) (setf (getf (second box) k) v)))
  (:command :get (k)
    (:args (m) (zk-pbt:tuple (zk-pbt:elements :a :b :c)))
    (:step (m) (values m (list (cdr (assoc k m)))))
    (:act (box) (getf (second box) k)))
  (:command :rem (k)
    (:args (m) (zk-pbt:tuple (zk-pbt:elements :a :b :c)))
    (:step (m)
      (let ((found (not (null (assoc k m)))))
        (values (remove k m :key #'car) (list found))))
    (:act (box) (not (null (remf (second box) k))))))

(zk-pbt:defproperty plist-state-machine
    ((ops (zk-pbt:commands 'plist-machine :max 20)))
  (zk-pbt:run-commands 'plist-machine ops))
