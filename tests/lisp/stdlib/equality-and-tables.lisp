(in-package #:zkcl-stdlib-tests)

(zk-pbt:defproperty equality-refinement-and-equivalence
    ((a (zk-pbt:s-expressions :max-depth 2))
     (b (zk-pbt:s-expressions :max-depth 2)))
  (zk-test:is (eql a a))
  (zk-test:is (equal a a))
  (zk-test:is (equalp a a))
  (when (eq a b) (zk-test:is (eql a b)))
  (when (eql a b) (zk-test:is (equal a b)))
  (when (equal a b)
    (zk-test:is (equalp a b))
    (zk-test:is (equal b a))
    (zk-test:is= (sxhash a) (sxhash b)))
  (when (equalp a b)
    (zk-test:is (equalp b a)))
  (let ((hash (sxhash a)))
    (zk-test:is (typep hash '(integer 0)))
    (zk-test:is (<= hash most-positive-fixnum)))
  t)

(zk-pbt:defproperty sxhash-ignores-sharing-and-package-status
    ((s (zk-pbt:strings :min 0 :max 16 :unicode t)))
  (let* ((part (list s 42))
         (shared (cons part part))
         (copied (cons (list (copy-seq s) 42) (list (copy-seq s) 42)))
         (sym-a (make-symbol s))
         (sym-b (make-symbol (copy-seq s))))
    (zk-test:is (equal shared copied))
    (zk-test:is= (sxhash shared) (sxhash copied))
    (zk-test:is= (sxhash sym-a) (sxhash sym-b)))
  t)

(defun check-hash-table-invariants (model table test-fn)
  (let ((count 0))
    (maphash (lambda (k v)
               (incf count)
               (let ((entry (assoc k model :test test-fn)))
                 (unless (and entry (eql v (cdr entry)))
                   (return-from check-hash-table-invariants nil))))
             table)
    (and (= count (hash-table-count table))
         (= count (length model))
         (every (lambda (kv)
                  (multiple-value-bind (val present) (gethash (car kv) table)
                    (and present (eql val (cdr kv)))))
                model))))

(defun table-key-gen ()
  (zk-pbt:one-of
   (zk-pbt:elements :a :b 0 1 -0.0d0 0.0d0 "ab" "AB")
   (zk-pbt:map-gen (lambda (x) (list 1 x)) (zk-pbt:elements 2))))

(defun table-val-gen ()
  (zk-pbt:elements nil 0 1 :v "x"))

(defmacro define-table-machine (machine-name test-sym)
  `(zk-pbt:defmachine ,machine-name
     (:model () nil)
     (:open () (make-hash-table :test ',test-sym))
     (:close (table) (clrhash table))
     (:invariant (model table)
       (check-hash-table-invariants model table #',test-sym))
     (:command :put (k v)
       (:args (m) (zk-pbt:tuple (table-key-gen) (table-val-gen)))
       (:step (m)
         (let ((rest (remove k m :key #'car :test #',test-sym)))
           (values (acons k v rest) (list v))))
       (:act (table) (setf (gethash k table) v)))
     (:command :get (k)
       (:args (m) (zk-pbt:tuple (table-key-gen)))
       (:step (m)
         (let ((entry (assoc k m :test #',test-sym)))
           (values m (list (cdr entry) (not (null entry))))))
       (:act (table)
         (multiple-value-bind (v present) (gethash k table)
           (values v (not (null present))))))
     (:command :rem (k)
       (:args (m) (zk-pbt:tuple (table-key-gen)))
       (:step (m)
         (let ((entry (assoc k m :test #',test-sym)))
           (values (remove k m :key #'car :test #',test-sym)
                   (list (not (null entry))))))
       (:act (table)
         (not (null (remhash k table)))))
     (:command :clr ()
       (:args (m) (zk-pbt:tuple))
       (:step (m) (values nil (list t)))
       (:act (table) (clrhash table) t))))

(define-table-machine eq-table-machine eq)
(define-table-machine eql-table-machine eql)
(define-table-machine equal-table-machine equal)
(define-table-machine equalp-table-machine equalp)

(zk-pbt:defproperty eq-hash-table-state-machine ((ops (zk-pbt:commands 'eq-table-machine :max 20)))
  (zk-pbt:run-commands 'eq-table-machine ops))

(zk-pbt:defproperty eql-hash-table-state-machine ((ops (zk-pbt:commands 'eql-table-machine :max 20)))
  (zk-pbt:run-commands 'eql-table-machine ops))

(zk-pbt:defproperty equal-hash-table-state-machine ((ops (zk-pbt:commands 'equal-table-machine :max 20)))
  (zk-pbt:run-commands 'equal-table-machine ops))

(zk-pbt:defproperty equalp-hash-table-state-machine ((ops (zk-pbt:commands 'equalp-table-machine :max 20)))
  (zk-pbt:run-commands 'equalp-table-machine ops))
