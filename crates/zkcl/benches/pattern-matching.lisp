;; Run with the release CLI: zkcl run pattern-matching.lisp
(zk:defvariant result (ready datum) (absent))
(defun by-hand (r)
  (declare (type result r))
  (typecase r
    (ready (case (ready-datum r) (0 3) (1 5) (2 7) (otherwise 9)))
    (absent 11)
    (t (error "outside domain"))))
(defun by-pattern (r)
  (declare (type result r))
  (zk:match r
    ((ready 0) 3) ((ready 1) 5) ((ready 2) 7) ((ready _) 9)
    ((absent) 11)))
(defun hand-nested (r)
  (declare (type result r))
  (if (typep r 'absent) 0
      (let ((datum (ready-datum r)))
        (if (consp datum) (case (car datum) (:left 11) (:right 13) (otherwise 17))
            19))))
(defun match-nested (r)
  (declare (type result r))
  (zk:match r
    ((absent) 0) ((ready (cons :left _)) 11)
    ((ready (cons :right _)) 13) ((ready (cons _ _)) 17) ((ready _) 19)))
(defvar *guard-calls* 0)
(defun count-guard (n) (incf *guard-calls*) (oddp n))
(defun hand-guard (r)
  (declare (type result r))
  (cond ((typep r 'absent) 3) ((count-guard (ready-datum r)) 5) (t 7)))
(defun match-guard (r)
  (declare (type result r))
  (zk:match r
    ((absent) 3) ((ready x) :when (count-guard x) 5) ((ready _) 7)))
(defun exercise (fn inputs rounds)
  (let ((total 0))
    (dotimes (i rounds)
      (dolist (v inputs) (incf total (funcall fn v))))
    total))
(defun pair-bench (name manual compiled inputs &optional (rounds 5000))
  (dolist (x inputs) (assert (= (funcall manual x) (funcall compiled x))))
  (setq *guard-calls* 0)
  (let* ((expected (exercise manual inputs 1))
         (expected-calls (* rounds *guard-calls*)))
    (dotimes (i 7)
      (dolist (fn (if (evenp i) (list manual compiled) (list compiled manual)))
        (setq *guard-calls* 0)
        (let* ((start (get-internal-run-time))
               (checksum (exercise fn inputs rounds))
               (elapsed (- (get-internal-run-time) start)))
          (assert (= checksum (* rounds expected)))
          (assert (= *guard-calls* expected-calls))
          (format t "~A ~D ~A ~D ~D ~D~%" name i (if (eq fn manual) :hand :match)
                  elapsed checksum *guard-calls*))))))
(let ((simple (list (ready 0) (ready 1) (ready 2) (ready 3) (absent))))
  (pair-bench :flat #'by-hand #'by-pattern simple)
  (pair-bench :guard #'hand-guard #'match-guard simple)
  (pair-bench :nested #'hand-nested #'match-nested
              (list (absent) (ready (cons :left 1)) (ready (cons :right 2))
                    (ready (cons :other 3)) (ready 0))))

;; Stress compile-time specialization and runtime dispatch at different widths.
(defun scale-case (width)
  (let* ((keys (loop for i below width collect (intern (format nil "KEY-~D" i) :keyword)))
         (clauses (loop for key in keys for i from 0 collect (list key i))))
    (let ((match-source `(lambda (x) (zk:match x ,@clauses (_ -1))))
          (hand-source `(lambda (x) (case x ,@clauses (otherwise -1))))
          (matched nil) (hand nil))
      (dotimes (i 7)
        (dolist (which (if (evenp i) '(:hand :match) '(:match :hand)))
          (let ((start (get-internal-run-time)))
            (if (eq which :match) (setf matched (compile nil match-source))
                (setf hand (compile nil hand-source)))
            (format t "COMPILE ~D ~D ~A ~D~%" width i which (- (get-internal-run-time) start)))))
      (pair-bench width hand matched (list (car keys) (car (last keys)) :not-present))
      (when (= width 64)
        (pair-bench :first-key hand matched (list (car keys)) 15000)
        (pair-bench :uniform hand matched keys 250)))))
(dolist (width '(8 16 32 64)) (scale-case width))

;; Dense integer results, and a sparse dispatch whose arms must run user code.
(defun scale-layout (width)
  (let* ((half (floor width 2))
         (keys (loop for i below width collect (intern (format nil "OP-~D" i) :keyword)))
         (dense (loop for i from (- half) below half collect (list i (mod (* i i) 17))))
         (actions (loop for k in keys for i from 0 collect (list k (list '+ i '(car v))))))
    (pair-bench :dense
      (compile nil `(lambda (x) (case x ,@dense (otherwise -1))))
      (compile nil `(lambda (x) (zk:match x ,@dense (_ -1))))
      (list (- half) 0 (1- half) half :outside))
    (pair-bench :actions
      (compile nil `(lambda (v) (case (cdr v) ,@actions (otherwise -1))))
      (compile nil `(lambda (v) (zk:match (cdr v) ,@actions (_ -1))))
      (list (cons 4 (first keys)) (cons 5 (car (last keys))) (cons 6 :outside)))))
(scale-layout 64)

(defun measure-matrix (width)
  (let* ((rows (loop for i below width collect
                 (list (list (intern (format nil "K~D" i) :keyword) '(cons y _)) '(1+ y))))
         (form `(zk:match (:inputs x v) ,@rows (_ :miss))))
    (dotimes (i 5)
      (let ((start (get-internal-run-time)))
        (macroexpand-1 form)
        (format t "MATRIX ~D ~D ~D~%" width i (- (get-internal-run-time) start))))))
(dolist (width '(8 32 64 128)) (measure-matrix width))

(defun checked-second (x)
  (zk:ematch (:values (values :ok x)) ((:ok v) v)))
(defun handwritten-second (x)
  (multiple-value-bind (tag v) (values :ok x)
    (if (eq tag :ok) v (error "unexpected tag"))))
(pair-bench :values #'handwritten-second #'checked-second '(1 2 3 4 5))

(defvar *labels* (make-hash-table))
(dotimes (i 8) (setf (gethash i *labels*) (* i i)))
(defun checked-label (key)
  (zk:ematch (:values (gethash key *labels*)) ((v found) :when found v)))
(defun handwritten-label (key)
  (multiple-value-bind (v found) (gethash key *labels*)
    (if found v (error "absent key"))))
(pair-bench :lookup #'handwritten-label #'checked-label '(0 1 2 3 4))
