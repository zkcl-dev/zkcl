(require :zk-gray)
(in-package :cl-user)

(defclass gray-character-source (zk-gray:fundamental-character-input-stream)
  ((text :initarg :text)
   (position :initform 0)))
(defmethod zk-gray:stream-read-char ((s gray-character-source))
  (with-slots (text position) s
    (if (= position (length text))
        :eof
        (prog1 (char text position) (incf position)))))
(defmethod zk-gray:stream-unread-char ((s gray-character-source) character)
  (declare (ignore character))
  (decf (slot-value s 'position)))

(defclass gray-bytes (zk-gray:fundamental-binary-input-stream
                      zk-gray:fundamental-binary-output-stream)
  ((remaining :initarg :remaining :initform nil)
   (written :initform nil)))
(defmethod zk-gray:stream-read-byte ((s gray-bytes))
  (with-slots (remaining) s
    (if remaining (pop remaining) :eof)))
(defmethod zk-gray:stream-write-byte ((s gray-bytes) byte)
  (push byte (slot-value s 'written)))
(defmethod stream-element-type ((s gray-bytes)) '(signed-byte 16))

(defclass gray-character-sink (zk-gray:fundamental-character-output-stream)
  ((data :initform (make-string-output-stream))))
(defmethod zk-gray:stream-write-char ((s gray-character-sink) character)
  (write-char character (slot-value s 'data)))

(let* ((s (make-instance 'gray-character-source :text (format nil "  λZ~%x")))
       (*standard-input* s)
       (destination (copy-seq "...")))
  (assert (and (streamp s) (typep s 'stream) (typep s (find-class 'stream))))
  (assert (and (open-stream-p s) (input-stream-p s) (not (output-stream-p s))))
  (assert (eq (stream-element-type s) 'character))
  (assert (char= (peek-char t) #\λ))
  (assert (char= (read-char-no-hang) #\λ))
  (unread-char #\λ)
  (assert (= 3 (read-sequence destination s :start 1)))
  (assert (equal destination ".λZ"))
  (assert (equal (multiple-value-list (read-line)) '("" nil)))
  (assert (equal (multiple-value-list (read-line)) '("x" t)))
  (assert (eq :end (read-char s nil :end)))
  (assert (handler-case (progn (read-char s) nil)
            (end-of-file (c) (eq s (stream-error-stream c)))))
  (assert (close s))
  (assert (not (open-stream-p s)))
  (assert (handler-case (progn (read-char s nil :end) nil)
            (stream-error (c) (eq s (stream-error-stream c))))))

(let* ((s (make-instance 'gray-bytes :remaining '(23 -170 312)))
       (v (vector nil nil nil nil)))
  (assert (and (input-stream-p s) (output-stream-p s)))
  (assert (equal (stream-element-type s) '(signed-byte 16)))
  (assert (= (read-byte s) 23))
  (assert (= (read-sequence v s :start 1) 3))
  (assert (equalp v #(nil -170 312 nil)))
  (assert (eq :done (read-byte s nil :done)))
  (assert (eql (write-byte -10 s) -10))
  (assert (eq v (write-sequence v s :start 1 :end 3)))
  (assert (equal (slot-value s 'written) '(312 -170 -10))))

(let ((s (make-instance 'gray-bytes :remaining '(3 4))) (list (list 7 7 7 7)))
  (assert (= (read-sequence list s :start 1) 3))
  (assert (equal list '(7 3 4 7)))
  (assert (eq list (write-sequence list s :start 1 :end 3)))
  (assert (equal (slot-value s 'written) '(4 3))))

(let* ((s (make-instance 'gray-character-sink)) (*standard-output* s))
  (write-char #\A)
  (write-string "0123" s :start 1 :end 3)
  (write-line "!")
  (format t "~D" 45)
  (princ 'x)
  (assert (equal (get-output-stream-string (slot-value s 'data))
                 (format nil "A12!~%45X"))))

(let* ((s (make-instance 'gray-character-source :text "λ  (!Q 42)99"))
       (*readtable* (copy-readtable nil)))
  (set-macro-character #\! (lambda (input c)
                             (declare (ignore c))
                             (assert (eq input s))
                             (read-char input)))
  (assert (eq (read-preserving-whitespace s) 'λ))
  (assert (char= (read-char s) #\Space))
  (assert (equal (read s) '(#\Q 42)))
  (assert (= (read s) 99))
  (assert (eq :end (read s nil :end)))
  (assert (handler-case (read s)
            (end-of-file (c) (eq s (stream-error-stream c))))))

(let* ((s (make-instance 'gray-character-source :text "!Q"))
       (*readtable* (copy-readtable nil)))
  (set-macro-character #\! (lambda (input c)
                             (declare (ignore c))
                             (throw 'gray-read (read-char input))))
  (assert (char= #\Q (catch 'gray-read (read s)))))

(defclass gray-live-input (zk-gray:fundamental-character-input-stream)
  ((position :initform 0)))
(defmethod zk-gray:stream-read-char ((s gray-live-input))
  (let ((n (incf (slot-value s 'position))))
    (cond ((= n 1) #\4) ((= n 2) #\2) ((= n 3) #\Space)
          (t (throw 'over-read :too-far)))))
(defmethod zk-gray:stream-unread-char ((s gray-live-input) character)
  (declare (ignore character))
  (decf (slot-value s 'position)))
(let ((s (make-instance 'gray-live-input)))
  (assert (eql 42 (catch 'over-read (read s))))
  (assert (= 3 (slot-value s 'position)))
  (assert (eq :too-far (catch 'over-read (read s)))))

(let* ((s (make-instance 'gray-character-source :text "(3 !4 5)97"))
       (*readtable* (copy-readtable nil)))
  (set-macro-character #\! (lambda (input c) (declare (ignore c))
                              (+ 10 (read input t nil t))))
  (assert (equal (read s) '(3 14 5)))
  (assert (= (read s) 97)))
(let ((s (make-instance 'gray-character-source :text "#.(throw 'read-eval-done 19)77")))
  (assert (= 19 (catch 'read-eval-done (read s))))
  (assert (= 77 (read s))))
(let ((s (make-instance 'gray-character-source :text "a β)Z")))
  (assert (equal (read-delimited-list #\) s) '(a β)))
  (assert (char= (read-char s) #\Z)))
(let ((s (make-instance 'gray-character-source :text "!3)8"))
      (*readtable* (copy-readtable nil)))
  (set-macro-character #\! (lambda (in char)
                             (declare (ignore char))
                             (funcall (get-macro-character #\() in #\()))
  (assert (equal (read s) '(3)))
  (assert (= 8 (read s))))

(defstruct gray-read-record (value 0))
(let* ((s (make-instance 'gray-character-source :text "#S(gray-read-record :value 7)"))
       (record (read s)))
  (assert (= 7 (gray-read-record-value record))))

(defvar *gray-loaded* nil)
(let ((s (make-instance 'gray-character-source :text
            "(setq *gray-loaded* (list *load-pathname* *load-truename*)) (push 19 *gray-loaded*)")))
  (assert (load s :external-format :already-decoded))
  (assert (equal *gray-loaded* '(19 nil nil)))
  (assert (open-stream-p s)))
(let* ((s (make-instance 'gray-character-source :text "!"))
       (*readtable* (copy-readtable nil)))
  (set-macro-character #\! (lambda (in c) (declare (ignore c)) (throw 'abandon-load in)))
  (assert (eq s (catch 'abandon-load (load s)))))
(let ((out (make-instance 'gray-character-sink)))
  (assert (handler-case (progn (load out) nil) (stream-error (c) (eq (stream-error-stream c) out)))))

(defvar *gray-synonym-target*)
(let* ((first (make-instance 'gray-character-source :text "(a"))
       (tail (make-string-input-stream ")X"))
       (input (make-concatenated-stream first tail))
       (out (make-instance 'gray-character-sink))
       (copy (make-string-output-stream))
       (broadcast (make-broadcast-stream out copy))
       (echo (make-echo-stream input broadcast))
       (*gray-synonym-target* echo)
       (synonym (make-synonym-stream '*gray-synonym-target*))
       (two-way (make-two-way-stream synonym broadcast)))
  (assert (and (eq first (car (concatenated-stream-streams input)))
               (eq out (car (broadcast-stream-streams broadcast)))
               (eq echo (symbol-value (synonym-stream-symbol synonym)))))
  (assert (and (input-stream-p two-way) (output-stream-p two-way)
               (eq 'character (stream-element-type two-way))))
  (assert (equal '(a) (read two-way)))
  (assert (string= "(a)" (get-output-stream-string copy)))
  (assert (char= #\X (peek-char nil two-way)))
  (assert (char= #\X (read-char-no-hang two-way)))
  (unread-char #\X two-way)
  (assert (char= #\X (read-char two-way)))
  (setq *gray-synonym-target* (make-instance 'gray-character-source :text "Y"))
  (assert (char= #\Y (read-char two-way)))
  (write-sequence "23" two-way)
  (format two-way "x~A" 4)
  (finish-output two-way)
  (assert (string= "X23x4" (get-output-stream-string copy)))
  (assert (string= "(a)X23x4" (get-output-stream-string (slot-value out 'data))))
  (close broadcast)
  (assert (and (not (open-stream-p broadcast)) (open-stream-p out) (open-stream-p copy))))
(let* ((in (make-instance 'gray-bytes :remaining '(1 2 3)))
       (out (make-instance 'gray-bytes))
       (echo (make-echo-stream (make-concatenated-stream in)
                               (make-broadcast-stream out)))
       (buf (make-list 4)))
  (assert (equal (stream-element-type echo) '(signed-byte 16)))
  (assert (= 1 (read-byte echo)))
  (assert (= 3 (read-sequence buf echo :start 1)))
  (assert (equal buf '(nil 2 3 nil)))
  (assert (equal (slot-value out 'written) '(3 2 1))))
(let* ((head (make-string-input-stream "(set"))
       (tail (make-instance 'gray-character-source :text "q *gray-loaded* 73)"))
       (joined (make-concatenated-stream head tail)))
  (assert (load joined))
  (assert (eql 73 *gray-loaded*)))
