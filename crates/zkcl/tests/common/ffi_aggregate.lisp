(defvar *aggregate-library* (zk-ffi:open-library (aggregate-library-path)))
(defvar *mixed* '(:struct :double :int32))
(defvar *outer* (list :struct :uint8 *mixed* :uint16))
(defvar *pair* '(:struct :float :float))
(defvar *hfa* (list :struct *pair* *pair*))
(defvar *tiny* '(:struct :uint8))
(defvar *triple* '(:struct :uint8 :uint8 :uint8))

(defun aggregate-function (name result &rest arguments)
  (apply #'zk-ffi:bind-function *aggregate-library* name result arguments))

(defvar *c-layout* (aggregate-function "aggregate_layout" :size :int))
(defvar *transform* (aggregate-function "transform_mixed" *mixed* :int32 *mixed* :double))
(defvar *variadic*
  (zk-ffi:bind-variadic-function *aggregate-library* "variadic_mixed" 1 *mixed*
                                 :int *mixed* :float))
(defvar *transform-outer* (aggregate-function "transform_outer" *outer* *outer*))
(defvar *visit-outer* (aggregate-function "visit_outer" *outer* *outer* :pointer))
(defvar *transform-hfa* (aggregate-function "transform_hfa" *hfa* *hfa* :float))
(defvar *tiny-call* (aggregate-function "transform_tiny" *tiny* *tiny*))
(defvar *rotate* (aggregate-function "rotate_three" *triple* *triple*))
(defvar *spilled* (apply #'aggregate-function "spilled_mixed" *mixed*
                         (append (make-list 8 :initial-element :double)
                                 (make-list 8 :initial-element :int)
                                 (list *mixed* :int32))))
(defvar *visit-mixed-fields* (aggregate-function "visit_mixed_fields" *mixed* *mixed* :pointer))
(defvar *visit-outer-fields* (aggregate-function "visit_outer_fields" *outer* *outer* :pointer))
(defvar *visit-float-fields* (aggregate-function "visit_float_fields" *hfa* *hfa* :pointer))
(defvar *visit-tiny-field* (aggregate-function "visit_tiny_field" *tiny* *tiny* :pointer))
(defvar *visitor-returned-zero* (aggregate-function "visitor_returned_zero" :int))
(defvar *message-type* '(:struct :pointer :uint16))
(defvar *messages-type* (list :struct :uint8 *message-type* :cstring :pointer))
(defvar *gather-strings* (aggregate-function "gather_strings" *messages-type* :cstring :pointer))
(defvar *captured-messages*
  (funcall *gather-strings* "Lisp input"
           (zk-ffi:make-callback (lambda (i) (if (zerop i) "first answer" "second answer"))
                                 :cstring :int)))
;; Forward the bytes through C and through a callback after dropping the prior handle.
(let* ((original *captured-messages*)
       (copy (funcall (aggregate-function "echo_messages" *messages-type* *messages-type*)
                      original)))
  (zk-ffi:free original)
  (setf *captured-messages* copy))
(setf *captured-messages*
      (funcall (aggregate-function "callback_messages" *messages-type* :pointer :pointer)
               (zk-ffi:make-callback (lambda () (prog1 *captured-messages*
                                                  (setf *captured-messages* nil)))
                                     *messages-type*)
               (zk-ffi:make-callback #'collect-in-aggregate-test :void)))
(let* ((type '(:struct :int :pointer))
       (result (funcall (aggregate-function "no_detail" type))))
  (assert (= -1 (zk-ffi:mem-ref result :int)))
  (zk-ffi:free result))
(defvar *received-message* nil)
(funcall (aggregate-function "transfer_message" :void :pointer :pointer)
         (zk-ffi:make-callback (lambda (unused) (declare (ignore unused)) "abcd") :cstring :int)
         (zk-ffi:make-callback (lambda (message) (setf *received-message* message))
                               :void *message-type*))
(defvar *forwarded-input* nil)
(funcall (aggregate-function "forward_input_message" :void :cstring :pointer)
         "wxyz"
         (zk-ffi:make-callback (lambda (message) (setf *forwarded-input* message))
                               :void *message-type*))
(defvar *message-result*
  (funcall (aggregate-function "static_message" *message-type*)))
(setf *aggregate-library* nil)

(defun check-aggregate-calls ()
  ;; Compare with the C compiler, including outer alignment and tail padding.
  (let ((expected (list (zk-ffi:type-size *mixed*) (zk-ffi:type-alignment *mixed*)
                        (zk-ffi:field-offset *mixed* 0) (zk-ffi:field-offset *mixed* 1)
                        (zk-ffi:type-size *outer*) (zk-ffi:type-alignment *outer*)
                        (zk-ffi:field-offset *outer* 0) (zk-ffi:field-offset *outer* 1)
                        (zk-ffi:field-offset *outer* 2))))
    (loop for value in expected for i from 0 do
      (assert (= value (funcall *c-layout* i)))))

  ;; Input can be an unaligned slice. Pass a private by-value copy.
  (let* ((bytes (zk-ffi:allocate (1+ (zk-ffi:type-size *mixed*))))
         (p (zk-ffi:inc-pointer bytes 1))
         (tag (zk-ffi:field-offset *mixed* 1)))
    (zk-ffi:mem-set p :double 0 2.5d0)
    (zk-ffi:mem-set p :int32 tag -12)
    (let ((result (funcall *transform* 3 p 2d0))
          (variadic (funcall *variadic* -1 p 3f0))
          (spilled (funcall *spilled* 1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0
                            1 2 3 4 5 6 7 8 p 42)))
      (assert (= -12 (zk-ffi:mem-ref p :int32 tag)))
      (zk-ffi:free bytes)
      (assert (eql 5d0 (zk-ffi:mem-ref result :double)))
      (assert (= -9 (zk-ffi:mem-ref result :int32 tag)))
      (assert (eql 7.5d0 (zk-ffi:mem-ref variadic :double)))
      (assert (= -13 (zk-ffi:mem-ref variadic :int32 tag)))
      (zk-ffi:free variadic)
      (assert (eql 38.5d0 (zk-ffi:mem-ref spilled :double)))
      (assert (= 66 (zk-ffi:mem-ref spilled :int32 tag)))
      (loop for i from (+ tag (zk-ffi:type-size :int32)) below (zk-ffi:type-size *mixed*)
            do (assert (zerop (zk-ffi:mem-ref result :uint8 i))))
      (assert (nth-value 1 (ignore-errors (funcall *transform* 1 p 1d0))))
      (zk-ffi:free result)
      (zk-ffi:free spilled)))

  ;; This nested value exceeds two machine words and includes both kinds of padding.
  (let* ((p (zk-ffi:allocate (zk-ffi:type-size *outer*)))
         (child (zk-ffi:field-offset *outer* 1))
         (tag (+ child (zk-ffi:field-offset *mixed* 1)))
         (suffix (zk-ffi:field-offset *outer* 2)))
    (zk-ffi:mem-set p :uint8 0 254)
    (zk-ffi:mem-set p :double child 3.25d0)
    (zk-ffi:mem-set p :int32 tag -123)
    (zk-ffi:mem-set p :uint16 suffix 65535)
    (let ((result (funcall *transform-outer* p)))
      (assert (= 254 (zk-ffi:mem-ref p :uint8)))
      (zk-ffi:free p)
      (assert (= 255 (zk-ffi:mem-ref result :uint8)))
      (assert (eql -6.5d0 (zk-ffi:mem-ref result :double child)))
      (assert (= 0 (zk-ffi:mem-ref result :int32 tag)))
      (assert (= 65534 (zk-ffi:mem-ref result :uint16 suffix)))
      (zk-ffi:free result)))

  ;; The callback can release the original storage while C owns its by-value copy.
  (let* ((p (zk-ffi:allocate (zk-ffi:type-size *outer*)))
         (suffix (zk-ffi:field-offset *outer* 2))
         (expected (make-condition 'simple-error :format-control "visitor failed")))
    (assert (eq expected
                (handler-case
                    (funcall *visit-outer* p
                             (zk-ffi:make-callback (lambda () (error expected)) :int))
                  (simple-error (c) c))))
    (zk-ffi:mem-set p :uint16 suffix 9)
    (let ((result (funcall *visit-outer* p
                           (zk-ffi:make-callback (lambda () (zk-ffi:free p) 3) :int))))
      (assert (= 12 (zk-ffi:mem-ref result :uint16 suffix)))
      (zk-ffi:free result)))

  ;; Four nested floats exercise the homogeneous floating aggregate ABI.
  (let* ((p (zk-ffi:allocate (zk-ffi:type-size *hfa*)))
         (hi (zk-ffi:field-offset *hfa* 1))
         (b (zk-ffi:field-offset *pair* 1))
         (offsets (list 0 b hi (+ hi b))))
    (loop for offset in offsets for value in '(1f0 2f0 3f0 4f0)
          do (zk-ffi:mem-set p :float offset value))
    (let ((result (funcall *transform-hfa* p 5f0)))
      (loop for offset in offsets for value in '(4f0 3f0 7f0 1f0)
            do (assert (eql value (zk-ffi:mem-ref result :float offset))))
      (zk-ffi:free result))
    (zk-ffi:free p))

  (let ((p (zk-ffi:allocate 3)))
    (zk-ffi:mem-set p :uint8 0 #x80)
    (zk-ffi:mem-set p :uint8 1 #xaa)
    (zk-ffi:mem-set p :uint8 2 #xcc)
    (let ((result (funcall *tiny-call* p))
          (triple (funcall *rotate* p)))
      (assert (= #x7f (zk-ffi:mem-ref result :uint8)))
      (assert (nth-value 1 (ignore-errors (zk-ffi:mem-ref result :uint8 1))))
      (assert (= #xcc (zk-ffi:mem-ref triple :uint8 0)))
      (assert (= #x80 (zk-ffi:mem-ref triple :uint8 1)))
      (assert (= #xaa (zk-ffi:mem-ref triple :uint8 2)))
      (assert (nth-value 1 (ignore-errors (funcall *rotate* (zk-ffi:inc-pointer p 1)))))
      (zk-ffi:free triple)
      (zk-ffi:free result))
    (zk-ffi:free p))
  (assert (nth-value 1 (ignore-errors (funcall *tiny-call* nil))))
  (dolist (type '((:struct) (:struct :void) (:struct . :int) (:struct (:struct :void))))
    (assert (nth-value 1 (ignore-errors (zk-ffi:type-size type)))))
  (let ((cycle (list :struct nil)))
    (setf (second cycle) cycle)
    (assert (nth-value 1 (ignore-errors (zk-ffi:type-size cycle)))))
  (assert (nth-value 1 (ignore-errors (zk-ffi:field-offset *mixed* 2))))
  (assert (nth-value 1 (ignore-errors (zk-ffi:field-offset :int32 0)))))

(defun check-aggregate-callbacks ()
  (let* ((p (zk-ffi:allocate (zk-ffi:type-size *mixed*)))
         (tag (zk-ffi:field-offset *mixed* 1))
         (saved nil)
         (visitor (zk-ffi:make-callback
                   (lambda (value delta)
                     (setf saved value)
                     (collect-in-aggregate-test)
                     (zk-ffi:mem-set value :double 0 (+ delta (zk-ffi:mem-ref value :double)))
                     (zk-ffi:mem-set value :int32 tag -17)
                     value)
                   *mixed* *mixed* :double)))
    (zk-ffi:mem-set p :double 0 3.25d0)
    (zk-ffi:mem-set p :int32 tag 23)
    (let ((result (funcall *visit-mixed-fields* p visitor)))
      (assert (= 23 (zk-ffi:mem-ref p :int32 tag)))
      (assert (= -7 (zk-ffi:mem-ref result :int32 tag)))
      (assert (eql 3.75d0 (zk-ffi:mem-ref result :double)))
      (zk-ffi:free p)
      (zk-ffi:free result)
      (collect-in-aggregate-test)
      (assert (= -17 (zk-ffi:mem-ref saved :int32 tag)))
      (zk-ffi:free saved)))

  ;; A large nested callback result uses the platform's indirect return convention.
  (let* ((p (zk-ffi:allocate (zk-ffi:type-size *outer*)))
         (child (zk-ffi:field-offset *outer* 1))
         (visitor (zk-ffi:make-callback
                   (lambda (value)
                     (assert (eql 1.25d0 (zk-ffi:mem-ref value :double child)))
                     (zk-ffi:mem-set value :double child -0.5d0)
                     value)
                   *outer* *outer*)))
    (zk-ffi:mem-set p :double child 1.25d0)
    (let ((result (funcall *visit-outer-fields* p visitor)))
      (assert (eql -0.5d0 (zk-ffi:mem-ref result :double child)))
      (zk-ffi:free result))
    (let ((too-small (zk-ffi:allocate 1)))
      (assert (nth-value 1 (ignore-errors
                            (funcall *visit-outer-fields* p
                                     (zk-ffi:make-callback
                                      (lambda (arg) (declare (ignore arg)) too-small)
                                      *outer* *outer*)))))
      (assert (= 1 (funcall *visitor-returned-zero*)))
      (zk-ffi:free too-small))
    (zk-ffi:free p))

  (let* ((p (zk-ffi:allocate (zk-ffi:type-size *hfa*)))
         (last (+ (zk-ffi:field-offset *hfa* 1) (zk-ffi:field-offset *pair* 1)))
         (visitor (zk-ffi:make-callback
                   (lambda (value)
                     (assert (eql 3f0 (zk-ffi:mem-ref value :float last)))
                     (zk-ffi:mem-set value :float last -2.5f0)
                     value)
                   *hfa* *hfa*)))
    (zk-ffi:mem-set p :float last 3f0)
    (let ((result (funcall *visit-float-fields* p visitor)))
      (assert (eql -5f0 (zk-ffi:mem-ref result :float last)))
      (zk-ffi:free result))
    (zk-ffi:free p))

  (let* ((p (zk-ffi:allocate 1))
         (visitor (zk-ffi:make-callback
                   (lambda (value)
                     (zk-ffi:mem-set value :uint8 0 (1+ (zk-ffi:mem-ref value :uint8)))
                     value)
                   *tiny* *tiny*)))
    (zk-ffi:mem-set p :uint8 0 200)
    (let ((result (funcall *visit-tiny-field* p visitor)))
      (assert (= 202 (zk-ffi:mem-ref result :uint8)))
      (zk-ffi:free result))
    (zk-ffi:free p)))

(defun release-aggregate-bindings ()
  (setf *gather-strings* nil *c-layout* nil *transform* nil *variadic* nil *transform-outer* nil
        *visit-mixed-fields* nil *visit-outer-fields* nil *visit-float-fields* nil
        *visitor-returned-zero* nil *visit-tiny-field* nil
        *visit-outer* nil *transform-hfa* nil *tiny-call* nil *rotate* nil *spilled* nil))

(defun check-message-owner ()
  (assert (= 6 (zk-ffi:mem-ref *message-result* :uint16
                                (zk-ffi:field-offset *message-type* 1))))
  (let ((text (zk-ffi:mem-ref *message-result* :pointer)))
    (zk-ffi:free *message-result*)
    (setf *message-result* nil)
    text))

(defun extract-captured-strings ()
  (let* ((record *captured-messages*)
         (first (zk-ffi:mem-ref record :pointer (zk-ffi:field-offset *messages-type* 1)))
         (second (zk-ffi:mem-ref record :pointer (zk-ffi:field-offset *messages-type* 2)))
         (input (zk-ffi:mem-ref record :pointer (zk-ffi:field-offset *messages-type* 3))))
    (assert (= 42 (zk-ffi:mem-ref record :uint8)))
    (zk-ffi:free record)
    (setf *captured-messages* nil)
    (let ((forwarded (zk-ffi:mem-ref *received-message* :pointer))
          (forwarded-input (zk-ffi:mem-ref *forwarded-input* :pointer)))
      (zk-ffi:free *received-message*)
      (zk-ffi:free *forwarded-input*)
      (setf *received-message* nil *forwarded-input* nil)
      (list first second input forwarded forwarded-input))))
