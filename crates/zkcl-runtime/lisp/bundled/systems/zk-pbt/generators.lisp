           #:linearizable-p #:linearizable-history-p
           #:interleaved-steps #:interleaving-schedules #:pct-schedules #:run-interleaved
           #:defmodel #:model-scenarios #:run-model #:format-model-scenario))
(in-package #:zk-pbt)

(defconstant +mask64+ #xffffffffffffffff)
(defun u64 (n) (logand n +mask64+))
(defun splitmix-word (state)
  (let* ((next-state (u64 (+ state #x9e3779b97f4a7c15)))
         (first-mix (u64 (* (logxor next-state (ash next-state -30)) #xbf58476d1ce4e5b9)))
         (second-mix (u64 (* (logxor first-mix (ash first-mix -27)) #x94d049bb133111eb))))
    (values (logxor second-mix (ash second-mix -31)) next-state)))

(defun hash-byte (h byte) (u64 (* (logxor h byte) #x100000001b3)))
(defun hash-u64 (h n)
  (dotimes (i 8 h) (setq h (hash-byte h (ldb (byte 8 (* i 8)) n)))))
(defun utf8-bytes (text)
  (let ((out nil))
    (loop for c across text for n = (char-code c) do
      (if (< n 128)
          (push n out)
          (let ((extra (cond ((< n #x800) 1) ((< n #x10000) 2) (t 3))))
            (push (logior (nth (1- extra) '(192 224 240)) (ash n (* -6 extra))) out)
            (loop for i downfrom (1- extra) to 0 do
              (push (+ 128 (ldb (byte 6 (* 6 i)) n)) out)))))
    (nreverse out)))
(defun hash-text (h s)
  (let ((bytes (utf8-bytes s)))
    (reduce #'hash-byte bytes :initial-value (hash-u64 h (length bytes)))))
(defun trial-seed (seed name index)
  (let ((pkg (symbol-package name)))
    (hash-u64 (hash-text (hash-text (hash-u64 #xcbf29ce484222325 seed)
                                    (if pkg (package-name pkg) ""))
                         (symbol-name name))
              index)))
(defun fresh-seed () (random (ash 1 64) (make-random-state t)))

(defstruct (input-generator (:constructor make-input-generator (produce &optional enumerate shrink)))
  produce enumerate shrink)
(defvar *splitmix-state*) (defvar *sample-size*)
(defvar *replaying-choices*) (defvar *remaining-replay-choices*) (defvar *choice-trace*)
(defvar *choice-byte-stream* nil)
(defstruct (choice-byte-stream (:constructor make-choice-byte-stream (bytes &optional (index 0) (length (length bytes)))))
  bytes index length)
(defun normalize-choice-bytes (bytes)
  (cond
    ((vectorp bytes)
     (let* ((len (length bytes))
            (vec (make-array len :initial-element 0)))
       (dotimes (i len vec)
         (let ((el (aref bytes i)))
           (setf (aref vec i) (logand #xff (if (characterp el) (char-code el) el)))))))
    ((listp bytes)
     (let* ((len (length bytes))
            (vec (make-array len :initial-element 0))
            (i 0))
       (dolist (el bytes vec)
         (setf (aref vec i) (logand #xff (if (characterp el) (char-code el) el)))
         (incf i))))
    (t (error "Expected sequence of octets or characters, got ~S" bytes))))
(defun read-choice-byte (stream)
  (let ((idx (choice-byte-stream-index stream))
        (len (choice-byte-stream-length stream)))
    (incf (choice-byte-stream-index stream))
    (if (< idx len) (aref (choice-byte-stream-bytes stream) idx) 0)))
(define-condition rejected-draw (condition) ())
(defun reject () (signal 'rejected-draw) (error "Rejected draw outside a generator run"))
(defun random-below (n)
  (unless (plusp n) (error "Empty generator range"))
  (let ((bits (integer-length (1- n))))
    (if *choice-byte-stream*
        (if (zerop bits)
            0
            (let ((nbytes (ceiling bits 8)) (v 0))
              (dotimes (i nbytes)
                (setq v (logior v (ash (read-choice-byte *choice-byte-stream*) (* 8 i)))))
              (mod v n)))
        (loop
          (let ((v 0))
            (loop for i from 0 below bits by 64 do
              (multiple-value-bind (word next) (splitmix-word *splitmix-state*)
                (setq *splitmix-state* next v (logior v (ash word i)))))
            (setq v (ldb (byte bits 0) v))
            (when (< v n) (return v)))))))

(defun choice (bound)
  (unless (plusp bound) (error "Empty generator range"))
  (let* ((previous-choice (and *replaying-choices* (pop *remaining-replay-choices*)))
         (selected-choice (if *replaying-choices* (if (typep previous-choice 'unsigned-byte) (min previous-choice (1- bound)) 0)
                (random-below bound))))
    (push selected-choice *choice-trace*) selected-choice))
(defun draw-input (input-generator)
  (let ((previous-subtrace (and *replaying-choices* (pop *remaining-replay-choices*))))
    (multiple-value-bind (value choice-trace)
        (let ((*remaining-replay-choices* (if (listp previous-subtrace) previous-subtrace nil)) (*choice-trace* nil))
          (values (funcall (input-generator-produce input-generator)) (nreverse *choice-trace*)))
      (push choice-trace *choice-trace*) value)))
(defun generate-inputs (input-generator seed size &optional (choice-trace nil replay-choices-p))
  (let ((*splitmix-state* seed) (*sample-size* size) (*replaying-choices* replay-choices-p)
        (*remaining-replay-choices* (list choice-trace)) (*choice-trace* nil)
        (*choice-byte-stream* nil))
    (values (draw-input input-generator) (car *choice-trace*))))
(defun generate-from-bytes (input-generator bytes &key (size 20))
  (check-type input-generator input-generator)
  (check-type size unsigned-byte)
  (let* ((vec (normalize-choice-bytes bytes))
         (bs (make-choice-byte-stream vec 0 (length vec)))
         (*splitmix-state* 0) (*sample-size* size)
         (*replaying-choices* nil) (*remaining-replay-choices* nil)
         (*choice-trace* nil) (*choice-byte-stream* bs))
    (values (draw-input input-generator)
            (car *choice-trace*)
            (min (choice-byte-stream-index bs) (choice-byte-stream-length bs)))))

(defmacro generator ((draw size) &body body)
  `(make-input-generator (lambda ()
               (let ((,size *sample-size*))
                 (declare (ignorable ,size))
                 (flet ((,draw (g) (draw-input g))) ,@body)))))
(defmacro enumerator ((emit) &body body)
  (let ((yield (gensym "YIELD"))
        (val (gensym "VAL")))
    `(make-input-generator (lambda () (error "An enumerator needs :enumerate"))
               (lambda (,yield) (flet ((,emit (,val) (funcall ,yield ,val))) ,@body)))))
(defun enumerate-inputs (g yield)
  (unless (input-generator-enumerate g) (error "Generator has no finite enumeration"))
  (funcall (input-generator-enumerate g) yield))
(defun just (x) (make-input-generator (lambda () x) (lambda (yield) (funcall yield x))))
(defun elements (&rest xs)
  (unless xs (error "ELEMENTS requires at least one value"))
  (let* ((vec (coerce xs 'simple-vector))
         (len (length vec)))
    (make-input-generator (lambda () (svref vec (choice len)))
                          (lambda (f) (mapc f xs)))))
(defun booleans () (elements nil t))
(defun nat (&key max) (integers :min 0 :max max))
(defun integers (&key min max)
  (when (or (and min (not (integerp min))) (and max (not (integerp max)))
            (and min max (> min max))) (error "Invalid integer bounds ~S ~S" min max))
  (make-input-generator
   (lambda ()
     (let* ((lo (or min (if max (min (- *sample-size*) (- max *sample-size*)) (- *sample-size*))))
            (hi (or max (max *sample-size* (+ lo *sample-size*))))
            (center (max lo (min hi 0)))
            (offset (choice (1+ (- hi lo)))))
       ;; Choice zero denotes the simplest legal value.
       (cond ((zerop offset) center)
             ((<= offset (- hi center)) (+ center offset))
             (t (- hi offset)))))
   (and min max (lambda (emit) (loop for i from min to max do (funcall emit i))))))

(defun unique-integers (xs)
  (let ((seen (make-hash-table :test 'eql))
        (out nil))
    (dolist (x xs (nreverse out))
      (unless (gethash x seen)
        (setf (gethash x seen) t)
        (push x out)))))

(defun fixnum-boundary-values ()
  (let ((vals (list 0 1 -1 2 -2 10 -10
                    most-positive-fixnum (1- most-positive-fixnum)
                    most-negative-fixnum (1+ most-negative-fixnum)))
        (bits (integer-length most-positive-fixnum)))
    (loop for k from 1 to bits do
      (let ((p (ash 1 k)))
        (dolist (cand (list p (1- p) (1+ p) (- p) (- -1 p) (- 1 p)))
          (when (<= most-negative-fixnum cand most-positive-fixnum)
            (push cand vals)))))
    (loop for p = 10 then (* p 10) while (<= p most-positive-fixnum) do
      (dolist (cand (list p (1- p) (1+ p) (- p) (- -1 p) (- 1 p)))
        (when (<= most-negative-fixnum cand most-positive-fixnum)
          (push cand vals))))
    (unique-integers (nreverse vals))))

(defparameter *fixnum-boundary-values* (fixnum-boundary-values))

(defun fixnums ()
  (frequency
   (list 25 (integers :min -16 :max 16))
   (list 35 (apply #'elements *fixnum-boundary-values*))
   (list 40 (integers :min most-negative-fixnum :max most-positive-fixnum))))

(defun bignum-boundary-values (max-bits)
  (let ((vals (list 0 1 -1 2 -2 10 -10
                    (1+ most-positive-fixnum) (1- most-negative-fixnum))))
    (dolist (exp '(0 1 7 8 15 16 29 30 31 32 52 53 60 61 62 63 64 127 128 255 256))
      (when (<= exp max-bits)
        (let ((p (ash 1 exp)))
          (dolist (delta '(-1 0 1))
            (push (+ p delta) vals)
            (push (- (+ p delta)) vals)))))
    (dolist (exp '(1 2 3 6 9 18 19 38 76))
      (let ((p (expt 10 exp)))
        (when (<= (integer-length p) max-bits)
          (dolist (delta '(-1 0 1))
            (push (+ p delta) vals)
            (push (- (+ p delta)) vals)))))
    (unique-integers (nreverse vals))))

(defparameter *default-bignum-boundary-values* (bignum-boundary-values 256))

(defun bignums (&key (max-bits 256))
  (check-type max-bits (integer 1 *))
  (let ((boundaries (if (= max-bits 256)
                        *default-bignum-boundary-values*
                        (bignum-boundary-values max-bits))))
    (frequency
     (list 25 (apply #'elements boundaries))
     (list 35 (sized (lambda (size)
                       (let* ((bits (max 8 (min max-bits (* 4 (max 1 size)))))
                              (limit (1- (ash 1 bits))))
                         (integers :min (- limit) :max limit)))))
     (list 40 (integers :min (- (ash 1 max-bits)) :max (ash 1 max-bits))))))

(defun exact-integers ()
  (frequency
   (list 3 (integers))
   (list 4 (fixnums))
   (list 3 (bignums))))

(defun ratios (&key (max-bits 64))
  (check-type max-bits (integer 2 *))
  (let ((num-gen (one-of (integers :min -100 :max 100) (fixnums) (bignums :max-bits max-bits)))
        (den-gen (one-of (integers :min 2 :max 100)
                         (integers :min 2 :max (ash 1 (min max-bits 64))))))
    (such-that (lambda (r) (typep r 'ratio))
               (map-gen #'/ num-gen den-gen)
               :attempts 20)))

(defun rationals (&key (max-bits 64))
  (frequency
   (list 4 (exact-integers))
   (list 6 (ratios :max-bits max-bits))))

(defvar *swarm-seed* nil)

(defun validate-frequency-pairs (pairs)
  (unless (and pairs (every (lambda (p)
                              (and (listp p) (= 2 (length p))
                                   (typep (first p) 'unsigned-byte)
                                   (input-generator-p (second p))))
                            pairs))
    (error "Expected (nonnegative-weight generator) pairs"))
  (let ((sum (reduce #'+ pairs :key #'first)))
    (unless (plusp sum) (error "All generator weights are zero"))
    sum))

(defun frequency (&rest pairs)
  (let ((sum (validate-frequency-pairs pairs))
        (active (remove-if (lambda (p) (zerop (first p))) pairs)))
    (make-input-generator
     (lambda ()
       (let ((n (choice sum)))
         (dolist (pair pairs)
           (when (< n (first pair)) (return (draw-input (second pair))))
           (decf n (first pair)))))
     (and (every (lambda (p) (input-generator-enumerate (second p))) active)
          (lambda (emit)
            (dolist (pair active)
              (enumerate-inputs (second pair) emit)))))))

(defun swarm-active-indices (pairs seed-val)
  (let* ((w (splitmix-word (u64 seed-val)))
         (active nil)
         (positive nil))
    (loop for p in pairs for i from 0 do
      (when (plusp (first p))
        (push (cons i p) positive)
        (let ((bit-src (if (< i 64) w (splitmix-word (u64 (+ seed-val i))))))
          (when (logbitp (mod i 64) bit-src)
            (push (cons i p) active)))))
    (if active
        (nreverse active)
        (let* ((pos-vec (coerce (nreverse positive) 'simple-vector))
               (pick (svref pos-vec (mod w (length pos-vec)))))
          (list pick)))))

(defun swarm-frequency (&rest pairs)
  (let* ((sum (validate-frequency-pairs pairs))
         (active (remove-if (lambda (p) (zerop (first p))) pairs))
         (vec (coerce (mapcar #'second pairs) 'simple-vector))
         (count (length vec)))
    (make-input-generator
     (lambda ()
       (if *replaying-choices*
           (let ((idx (choice count)))
             (draw-input (svref vec idx)))
           (let* ((pool (if *swarm-seed*
                            (swarm-active-indices pairs (logxor *swarm-seed* count))
                            (loop for p in pairs for i from 0
                                  when (plusp (first p)) collect (cons i p))))
                  (pool-sum (if *swarm-seed*
                                (reduce #'+ pool :key (lambda (e) (first (cdr e))))
                                sum))
                  (pick (random-below pool-sum)))
             (dolist (entry pool)
               (let ((w (first (cdr entry))))
                 (when (< pick w)
                   (push (car entry) *choice-trace*)
                   (return (draw-input (second (cdr entry)))))
                 (decf pick w))))))
     (and (every (lambda (p) (input-generator-enumerate (second p))) active)
          (lambda (emit)
            (dolist (pair active)
              (enumerate-inputs (second pair) emit)))))))

(defun swarm-one-of (&rest gs)
  (unless gs (error "SWARM-ONE-OF requires at least one generator"))
  (apply #'swarm-frequency (mapcar (lambda (g) (list 1 g)) gs)))

(defun one-of (&rest gs)
  (unless gs (error "ONE-OF requires at least one generator"))
  (apply #'frequency (mapcar (lambda (g) (list 1 g)) gs)))
(defun option (g &key (nil-weight 1) (some-weight 4))
  (check-type g input-generator)
  (check-type nil-weight unsigned-byte)
  (check-type some-weight unsigned-byte)
  (frequency (list nil-weight (just nil))
             (list some-weight g)))
(defun with-corners (corners g &key (corner-weight 1) (gen-weight 4))
  (unless (and (listp corners) corners)
    (error "WITH-CORNERS requires a non-empty list of corners: ~S" corners))
  (check-type g input-generator)
  (check-type corner-weight unsigned-byte)
  (check-type gen-weight unsigned-byte)
  (frequency (list corner-weight (apply #'elements corners))
             (list gen-weight g)))
(defun enumerate-product (gs emit)
  (labels ((walk (tail rev)
             (if tail
                 (enumerate-inputs (car tail)
                     (lambda (v) (walk (cdr tail) (cons v rev))))
                 (funcall emit (reverse rev)))))
    (walk gs nil)))
(defun tuple (&rest gs)
  (let ((shrinkers (loop for g in gs for i from 0
                         when (input-generator-shrink g)
                           collect (cons i (input-generator-shrink g)))))
    (make-input-generator
     (lambda () (mapcar #'draw-input gs))
     (and (every #'input-generator-enumerate gs)
          (lambda (emit) (enumerate-product gs emit)))
     (and shrinkers
          (lambda (args)
            (when (listp args)
              (let ((cands nil))
                (dolist (entry shrinkers (nreverse cands))
                  (let* ((idx (car entry))
                         (shrink-fn (cdr entry))
                         (cur (nth idx args)))
                    (dolist (smaller (funcall shrink-fn cur))
                      (let ((copy (copy-list args)))
                        (setf (nth idx copy) smaller)
                        (push copy cands))))))))))))
(defun shrink-with (shrink-fn g)
  (check-type g input-generator)
  (make-input-generator (input-generator-produce g)
                        (input-generator-enumerate g)
                        shrink-fn))
(defun shrink-candidates (g value)
  (check-type g input-generator)
  (let ((fn (input-generator-shrink g)))
    (when fn (funcall fn value))))
(defun map-gen (fn g &rest more-gs)
  (check-type g input-generator)
  (dolist (mg more-gs) (check-type mg input-generator))
  (if (null more-gs)
      (make-input-generator (lambda () (funcall fn (draw-input g)))
                            (and (input-generator-enumerate g)
                                 (lambda (emit)
                                   (enumerate-inputs g (lambda (v) (funcall emit (funcall fn v)))))))
      (let ((gs (cons g more-gs)))
        (make-input-generator
         (lambda () (apply fn (mapcar #'draw-input gs)))
         (and (every #'input-generator-enumerate gs)
              (lambda (emit)
                (enumerate-product gs (lambda (args) (funcall emit (apply fn args))))))))))
(defun cons-of (car-gen cdr-gen)
  (map-gen #'cons car-gen cdr-gen))
(defmacro let-gen (bindings &body body)
  (unless (listp bindings)
    (error "LET-GEN bindings must be a list: ~S" bindings))
  (dolist (b bindings)
    (unless (and (consp b) (= (length b) 2)
                 (symbolp (first b))
                 (not (member (first b) lambda-list-keywords)))
      (error "Each LET-GEN binding must be (VAR GENERATOR): ~S" b)))
  (let ((draw (gensym "DRAW"))
        (size (gensym "SIZE")))
    `(generator (,draw ,size)
       (let* ,(loop for (var gen-form) in bindings
                    collect `(,var (,draw ,gen-form)))
         ,@body))))
(defun bind-gen (g fn)
  (check-type g input-generator)
  (make-input-generator (lambda () (draw-input (funcall fn (draw-input g))))))
(defun sized (fn) (make-input-generator (lambda () (draw-input (funcall fn *sample-size*)))))
(defun resize (n g)
  (check-type n unsigned-byte)
  (check-type g input-generator)
  (make-input-generator
   (lambda ()
     (let ((*sample-size* n))
       (draw-input g)))
   (input-generator-enumerate g)
   (input-generator-shrink g)))
(defun scale (fn g)
  (check-type g input-generator)
  (make-input-generator
   (lambda ()
     (let ((*sample-size* (max 0 (funcall fn *sample-size*))))
       (draw-input g)))
   (input-generator-enumerate g)
   (input-generator-shrink g)))
(defun no-shrink (g)
  (check-type g input-generator)
  (make-input-generator
   (lambda ()
     (let* ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
            (inner (if (and (consp old) (eq (car old) :no-shrink))
                       (cdr old)
                       old)))
       (multiple-value-bind (val trace)
           (let ((*remaining-replay-choices* (if (listp inner) inner nil))
                 (*choice-trace* nil))
             (values (funcall (input-generator-produce g))
                     (nreverse *choice-trace*)))
         (push (cons :no-shrink trace) *choice-trace*)
         val)))
   (input-generator-enumerate g)
   nil))
(defun such-that (pred g &key (attempts 10))
  (check-type g input-generator)
  (check-type attempts (integer 1 *))
  (make-input-generator
   (lambda ()
     (if *replaying-choices*
         (let ((x (draw-input g)))
           (if (funcall pred x) x (reject)))
         (loop repeat attempts do
           (let* ((saved-trace *choice-trace*)
                  (x (draw-input g)))
             (when (funcall pred x)
               (return x))
             (setq *choice-trace* saved-trace))
           finally (reject))))))
(defun such-that-maybe (pred g &key (attempts 10))
  (check-type g input-generator)
  (check-type attempts (integer 1 *))
  (make-input-generator
   (lambda ()
     (if *replaying-choices*
         (let ((flag (if (eql (pop *remaining-replay-choices*) 1) 1 0)))
           (push flag *choice-trace*)
           (if (zerop flag)
               nil
               (let ((x (draw-input g)))
                 (if (funcall pred x) x (reject)))))
         (loop repeat attempts do
           (let ((saved-trace *choice-trace*))
             (push 1 *choice-trace*)
             (handler-case
                 (let ((x (draw-input g)))
                   (when (funcall pred x)
                     (return x)))
               (rejected-draw () nil))
             (setq *choice-trace* saved-trace))
           finally (progn
                     (push 0 *choice-trace*)
                     (return nil)))))))
(defun list-of (g &key (min 0) max)
  (check-type g input-generator)
  (check-type min unsigned-byte)
  (when max (check-type max unsigned-byte) (when (< max min) (error "Invalid length range")))
  (let ((elem-shrink (input-generator-shrink g)))
    (make-input-generator
     (lambda ()
       (let* ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
              (children (and (consp old) (eq (car old) :sequence) (cdr old)))
              (upper (or max (+ min *sample-size*)))
              (n (if *replaying-choices* (max min (min upper (length children)))
                     (+ min (random-below (1+ (- upper min)))))))
         (multiple-value-bind (xs trace)
             (let ((*remaining-replay-choices* children) (*choice-trace* nil))
               (values (loop repeat n collect (draw-input g)) (nreverse *choice-trace*)))
           (push (cons :sequence trace) *choice-trace*) xs)))
     (and max (input-generator-enumerate g)
          (lambda (emit)
            (labels ((walk (remaining rev)
                       (if (zerop remaining)
                           (funcall emit (reverse rev))
                           (enumerate-inputs g (lambda (v) (walk (1- remaining) (cons v rev)))))))
              (loop for len from min to max do (walk len nil)))))
     (and elem-shrink
          (lambda (xs)
            (when (listp xs)
              (let ((len (length xs))
                    (cands nil))
                (when (> len min)
                  (loop for b = (- len min) then (floor b 2) while (plusp b) do
                    (loop for i from 0 to (- len b) by b do
                      (push (append (subseq xs 0 i) (subseq xs (+ i b))) cands))))
                (loop for x in xs for i from 0 do
                  (dolist (smaller (funcall elem-shrink x))
                    (let ((copy (copy-list xs)))
                      (setf (nth i copy) smaller)
                      (push copy cands))))
                (nreverse cands))))))))
(defun non-empty-list-of (g &key max)
  (list-of g :min 1 :max max))
(defun unique-list-of (g &key (min 0) max (test #'eql) (attempts 50))
  (check-type g input-generator)
  (check-type min unsigned-byte)
  (check-type attempts (integer 1 *))
  (when max
    (check-type max unsigned-byte)
    (when (< max min) (error "Invalid length range")))
  (make-input-generator
   (lambda ()
     (let* ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
            (children (and (consp old) (eq (car old) :sequence) (cdr old)))
            (upper (or max (+ min *sample-size*))))
       (if *replaying-choices*
           (let ((n (max min (min upper (length children)))))
             (multiple-value-bind (xs trace)
                 (let ((*remaining-replay-choices* children) (*choice-trace* nil))
                   (let ((out nil))
                     (dotimes (i n)
                       (declare (ignore i))
                       (let ((v (draw-input g)))
                         (when (member v out :test test) (reject))
                         (push v out)))
                     (values (nreverse out) (nreverse *choice-trace*))))
               (push (cons :sequence trace) *choice-trace*)
               xs))
           (let ((n (+ min (random-below (1+ (- upper min))))))
             (multiple-value-bind (xs trace)
                 (let ((*remaining-replay-choices* nil) (*choice-trace* nil))
                   (let ((out nil))
                     (dotimes (i n)
                       (declare (ignore i))
                       (let ((accepted nil))
                         (dotimes (try attempts)
                           (declare (ignore try))
                           (let ((saved *choice-trace*))
                             (handler-case
                                 (let ((v (draw-input g)))
                                   (unless (member v out :test test)
                                     (push v out)
                                     (setq accepted t)
                                     (return)))
                               (rejected-draw () nil))
                             (setq *choice-trace* saved)))
                         (unless accepted
                           (if (< (length out) min)
                               (reject)
                               (return)))))
                     (values (nreverse out) (nreverse *choice-trace*))))
               (push (cons :sequence trace) *choice-trace*)
               xs)))))))
(defun reconstruct-sequence-like (template items)
  (cond ((listp template) items)
        ((stringp template) (coerce items 'string))
        (t (make-array (length items)
                       :element-type (array-element-type template)
                       :initial-contents items))))
(defun subsequence-of (seq &key (min 0) max)
  (let* ((vec (coerce seq 'simple-vector))
         (len (length vec))
         (hi (if max (min max len) len)))
    (check-type min unsigned-byte)
    (when max (check-type max unsigned-byte))
    (when (and max (< max min))
      (error "Invalid subsequence length range ~D..~D" min max))
    (when (> min len)
      (error "SUBSEQUENCE-OF :min ~D exceeds sequence length ~D" min len))
    (make-input-generator
     (lambda ()
       (if (or *replaying-choices* (and (zerop min) (= hi len)))
           (let ((selected nil)
                 (count 0))
             (dotimes (i len)
               (when (= (choice 2) 1)
                 (push (svref vec i) selected)
                 (incf count)))
             (when (or (< count min) (> count hi))
               (reject))
             (reconstruct-sequence-like seq (nreverse selected)))
           (let* ((target (+ min (random-below (1+ (- hi min)))))
                  (indices (let ((a (make-array len)))
                             (dotimes (i len a) (setf (aref a i) i))))
                  (keep (make-array len :initial-element nil))
                  (selected nil))
             (dotimes (i target)
               (let ((j (+ i (random-below (- len i)))))
                 (rotatef (aref indices i) (aref indices j))
                 (setf (aref keep (aref indices i)) t)))
             (dotimes (i len)
               (let ((bit (if (aref keep i) 1 0)))
                 (push bit *choice-trace*)
                 (when (= bit 1)
                   (push (svref vec i) selected))))
             (reconstruct-sequence-like seq (nreverse selected)))))
     (lambda (emit)
       (labels ((walk (idx count rev)
                  (when (<= count hi)
                    (cond
                      ((= idx len)
                       (when (>= count min)
                         (funcall emit (reconstruct-sequence-like seq (reverse rev)))))
                      (t
                       (when (>= (+ count (- len idx 1)) min)
                         (walk (1+ idx) count rev))
                       (when (< count hi)
                         (walk (1+ idx) (1+ count) (cons (svref vec idx) rev))))))))
         (walk 0 0 nil))))))
(defun permutation-of (seq)
  (let* ((vec (coerce seq 'simple-vector))
         (len (length vec)))
    (make-input-generator
     (lambda ()
       (let ((copy (copy-seq vec)))
         (loop for i from 0 below (max 0 (1- len)) do
           (let ((offset (choice (- len i))))
             (unless (zerop offset)
               (rotatef (svref copy i) (svref copy (+ i offset))))))
         (reconstruct-sequence-like seq (coerce copy 'list)))))))
(defun vector-of (g &key (min 0) max (element-type t))
  (map-gen (lambda (xs)
             (if (eq element-type t)
                 (coerce xs 'vector)
                 (make-array (length xs) :element-type element-type :initial-contents xs)))
           (list-of g :min min :max max)))
(defun floats (&key (format 'double-float) min max)
  (let* ((one (coerce 1 format)) (zero (coerce 0 format))
         (limits (ecase format
                   (short-float (list least-positive-short-float least-positive-normalized-short-float most-positive-short-float))
                   (single-float (list least-positive-single-float least-positive-normalized-single-float most-positive-single-float))
                   (double-float (list least-positive-double-float least-positive-normalized-double-float most-positive-double-float))
                   (long-float (list least-positive-long-float least-positive-normalized-long-float most-positive-long-float))))
         (ulp (scale-float one (- 1 (float-digits one))))
         (near-one (list (- one (/ ulp 2)) one (+ one ulp)))
         (edges (append (list zero) near-one (mapcar (lambda (x) (/ x 2)) near-one) limits))
         (all-edges (append edges (mapcar #'- edges)))
         (lowest-exponent (nth-value 1 (integer-decode-float (second limits))))
         (highest-exponent (nth-value 1 (integer-decode-float (third limits))))
         (max-significand (integer-decode-float (third limits))))
    (if (or min max)
        (let* ((most-pos (third limits))
               (lo (coerce (or min (- most-pos)) format))
               (hi (coerce (or max most-pos) format)))
          (when (> lo hi)
            (error "Invalid float bounds ~S ~S" min max))
          (let* ((mid (+ (* lo (coerce 1/2 format)) (* hi (coerce 1/2 format))))
                 (bounded-edges
                   (remove-duplicates
                    (remove-if-not (lambda (x) (<= lo x hi))
                                   (append (list lo hi mid) all-edges))
                    :test #'eql)))
            (one-of (apply #'elements bounded-edges)
                    (generator (draw size)
                      (let* ((denom #x10000000)
                             (k (draw (integers :min 0 :max denom)))
                             (u (/ (coerce k format) (coerce denom format)))
                             (v (+ (* lo (- one u)) (* hi u))))
                        (max lo (min hi v)))))))
        (one-of (apply #'elements all-edges)
                (generator (draw size)
                  (let* ((m (draw (integers :min 0 :max max-significand)))
                         (e (draw (integers :min lowest-exponent :max highest-exponent)))
                         (value (scale-float (coerce m format) e)))
                    (if (draw (elements nil t)) (- value) value)))))))

(defun complexes (&key real-gen)
  (if real-gen
      (map-gen #'complex real-gen real-gen)
      (one-of
       (map-gen #'complex (rationals :max-bits 64) (rationals :max-bits 64))
       (map-gen #'complex (floats :format 'single-float) (floats :format 'single-float))
       (map-gen #'complex (floats :format 'double-float) (floats :format 'double-float))
       (map-gen #'complex (integers :min -10000 :max 10000) (floats :format 'double-float)))))

(defun valid-unicode-scalar-p (code)
  (and (<= 0 code)
       (< code char-code-limit)
       (not (<= #xD800 code #xDFFF))
       (not (null (code-char code)))))

(defun char-range-generator (lo hi)
  (unless (<= lo hi)
    (error "CHAR-RANGE lower bound ~D exceeds upper bound ~D" lo hi))
  (when (<= #xD800 lo #xDFFF)
    (if (> hi #xDFFF)
        (setq lo #xE000)
        (error "Character range lies entirely within UTF-16 surrogates")))
  (when (<= #xD800 hi #xDFFF)
    (setq hi #xD7FF))
  (let* ((spans-surrogate (and (< lo #xD800) (> hi #xDFFF)))
         (gap (if spans-surrogate #x800 0))
         (adjusted-hi (- hi gap)))
    (map-gen (lambda (index)
               (let ((code (if (and spans-surrogate (>= index #xD800))
                               (+ index gap)
                               index)))
                 (or (code-char code) #\Space)))
             (integers :min lo :max adjusted-hi))))

(defun characters (&key (unicode t) min max)
  (when min (check-type min character))
  (when max (check-type max character))
  (when (or min max)
    (let ((lo (if min (char-code min) 0))
          (hi (if max (char-code max) (1- (min char-code-limit #x110000)))))
      (return-from characters (char-range-generator lo hi))))
  (let* ((printable (char-range-generator 32 126))
         (ascii-edges (remove nil
                              (list #\a #\b #\A #\Space #\Newline #\Tab #\Return
                                    (code-char 0) #\" #\\ #\| #\( #\) #\' #\` #\, #\# #\: #\;
                                    (code-char 127))))
         (unicode-edges
           (loop for code in '(#x80 #xFF #x100 #x7FF #x800 #xD7FF #xE000 #xFFFD #xFFFF #x10000 #x1F600 #x10FFFF)
                 when (valid-unicode-scalar-p code)
                   collect (code-char code)))
         (max-scalar (1- (min char-code-limit #x110000))))
    (if (and unicode (> char-code-limit 128))
        (frequency
         (list 5 printable)
         (list 2 (apply #'elements ascii-edges))
         (list 1 (if unicode-edges (apply #'elements unicode-edges) printable))
         (list 2 (char-range-generator 0 max-scalar)))
        (frequency
         (list 7 printable)
         (list 3 (apply #'elements ascii-edges))))))

(defun printable-characters ()
  (char-range-generator 32 126))

(defparameter *alphanumeric-chars*
  (append (loop for code from (char-code #\a) to (char-code #\z) collect (code-char code))
          (loop for code from (char-code #\A) to (char-code #\Z) collect (code-char code))
          (loop for code from (char-code #\0) to (char-code #\9) collect (code-char code))))

(defun alphanumeric-characters ()
