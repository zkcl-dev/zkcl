  (:import-from #:zk-test #:report-status #:report-data #:failure-report #:check-failed)
  (:export #:defproperty #:for-all #:claim #:assume #:note #:target #:run #:check #:forall #:replay #:save-regression
           #:*default-corpus* #:*last-failure* #:recheck-last #:inspect-distribution
           #:report-status #:report-data #:failure-report #:check-failed
           #:just #:elements #:booleans #:nat #:integers #:fixnums #:bignums #:exact-integers
           #:ratios #:rationals #:floats #:complexes
           #:characters #:printable-characters #:alphanumeric-characters #:ascii-characters
           #:strings #:ascii-strings #:printable-strings #:symbols #:keywords #:octets #:bit-vectors #:functions
           #:describe-generated-function
           #:one-of #:frequency #:swarm-one-of #:swarm-frequency #:option #:with-corners #:tuple #:cons-of
           #:list-of #:non-empty-list-of #:unique-list-of #:subsequence-of #:permutation-of #:vector-of
           #:alists #:plists #:hash-tables #:arrays #:recursive #:grammar #:s-expressions
           #:type-gen #:defstruct-gen #:mutated-pair #:size-bounded-enumerator
           #:map-gen #:let-gen #:bind-gen #:sized #:resize #:scale #:no-shrink
           #:such-that #:such-that-maybe #:shrink-with #:shrink-candidates
