(defun arrays (element-gen &key (min-rank 1) (max-rank 2) (max-dim 6) (element-type t) adjustable fill-pointer)
  (check-type min-rank (integer 0 *))
  (check-type max-rank (integer 0 *))
  (check-type max-dim (integer 0 *))
  (when (integerp fill-pointer)
    (check-type fill-pointer (integer 0 *)))
  (when (> min-rank max-rank) (error "Invalid rank bounds ~D..~D" min-rank max-rank))
  (generator (draw size)
    (let* ((rank (draw (integers :min min-rank :max max-rank)))
           (dims (loop repeat rank collect (draw (integers :min 0 :max max-dim))))
           (total (reduce #'* dims :initial-value 1))
           (items (loop repeat total collect (draw element-gen)))
           (adj-p (if (eq adjustable :random) (draw (booleans)) adjustable))
           (fp (cond
                 ((not (= rank 1)) nil)
                 ((eq fill-pointer :random)
                  (and (draw (booleans)) (draw (integers :min 0 :max total))))
                 ((integerp fill-pointer) (min fill-pointer total))
                 (fill-pointer (draw (integers :min 0 :max total)))
                 (t nil)))
           (arr (apply #'make-array dims
                       :element-type element-type
                       :adjustable (not (null (or adj-p fp)))
                       (when fp (list :fill-pointer fp)))))
      (loop for x in items for i from 0 do (setf (row-major-aref arr i) x))
      arr)))

(defun hash-case-value (value &optional (h #xcbf29ce484222325) (depth 0))
  (if (>= depth 16)
      (hash-byte h #xff)
      (cond
        ((null value) (hash-byte h 0))
        ((eq value t) (hash-byte h 1))
        ((integerp value)
         (let ((h1 (hash-byte h (if (minusp value) 2 3)))
               (mag (abs value)))
           (loop while (plusp mag) do
             (setq h1 (hash-u64 h1 (ldb (byte 64 0) mag))
                   mag (ash mag -64)))
           h1))
        ((characterp value) (hash-u64 (hash-byte h 4) (char-code value)))
        ((symbolp value)
         (let ((pkg (symbol-package value)))
           (hash-text (hash-text (hash-byte h 5) (if pkg (package-name pkg) ""))
                      (symbol-name value))))
        ((typep value 'ratio)
         (hash-case-value (denominator value)
                          (hash-case-value (numerator value) (hash-byte h 6) (1+ depth))
                          (1+ depth)))
        ((floatp value)
         (multiple-value-bind (m e sign) (integer-decode-float value)
           (let ((s (if (zerop value) (if (minusp (float-sign value)) -1 1) sign)))
             (hash-case-value m (hash-case-value e (hash-byte h (if (minusp s) 7 8)) (1+ depth)) (1+ depth)))))
        ((complexp value)
         (hash-case-value (imagpart value)
                          (hash-case-value (realpart value) (hash-byte h 9) (1+ depth))
                          (1+ depth)))
        ((stringp value) (hash-text (hash-byte h 10) value))
        ((consp value)
         (hash-case-value (cdr value)
                          (hash-case-value (car value) (hash-byte h 11) (1+ depth))
                          (1+ depth)))
        ((arrayp value)
         (let ((h1 (hash-u64 (hash-byte h 12) (array-total-size value))))
           (dotimes (i (min 32 (array-total-size value)) h1)
             (setq h1 (hash-case-value (row-major-aref value i) h1 (1+ depth))))))
        (t (hash-u64 (hash-byte h 13) (logand (sxhash value) +mask64+))))))

(defparameter *generated-function-capacity* 4096)
(defvar *generated-function-table* (make-hash-table :test 'eq))
(defvar *generated-function-ring* (make-array 4096 :initial-element nil))
(defvar *generated-function-cursor* 0)

(defun register-generated-function (fn spec)
  (let* ((cap (length *generated-function-ring*))
         (evicted (aref *generated-function-ring* *generated-function-cursor*)))
    (when evicted (remhash evicted *generated-function-table*))
    (setf (aref *generated-function-ring* *generated-function-cursor*) fn
          (gethash fn *generated-function-table*) spec
          *generated-function-cursor* (mod (1+ *generated-function-cursor*) cap)))
  fn)

(defun find-generated-function-spec (fn)
  (gethash fn *generated-function-table*))

(defun describe-generated-function (fn)
  (when (functionp fn)
    (let ((spec (find-generated-function-spec fn)))
      (when spec
        (let* ((calls-box (fourth spec))
               (calls (and calls-box (reverse (car calls-box)))))
          (if calls
              (list :fn :arity (first spec)
                    :calls (mapcar (lambda (kv) (list (car kv) :-> (cdr kv))) calls)
                    :default (third spec)
                    :table (coerce (second spec) 'vector))
              (list :fn :arity (first spec)
                    :default (third spec)
                    :table (coerce (second spec) 'vector))))))))

(defun make-generated-function (arity entries default-val)
  (let* ((table (coerce entries 'simple-vector))
         (len (length table))
         (calls-box (list nil))
         (fn (lambda (&rest args)
               (when (and arity (/= (length args) arity))
                 (error "Generated function expected ~D argument~:P, got ~D" arity (length args)))
               (let* ((key (if (and arity (= arity 1)) (first args) args))
                      (res (if (zerop len)
                               default-val
                               (svref table (mod (hash-case-value key) len)))))
                 (when (and (< (length (car calls-box)) 32)
                            (not (assoc key (car calls-box) :test #'equal)))
                   (push (cons key res) (car calls-box)))
                 res))))
    (register-generated-function fn (list arity entries default-val calls-box))))

(defun functions (codomain-gen &key (arity 1) (max-entries 8))
  (when arity (check-type arity (integer 0 *)))
  (check-type max-entries (integer 0 *))
  (map-gen (lambda (default entries)
             (make-generated-function arity entries default))
           codomain-gen
           (list-of codomain-gen :min 0 :max max-entries)))

(defun octets (&key (min 0) max)
  (vector-of (integers :min 0 :max 255) :min min :max max :element-type '(unsigned-byte 8)))

(defun bit-vectors (&key (min 0) max)
  (vector-of (integers :min 0 :max 1) :min min :max max :element-type 'bit))

(defun wrap-recursive-level (leaf-gen branch-gen leaf-weight branch-weight)
  (make-input-generator
   (lambda ()
     (let* ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
            (tag-in (and (consp old) (eq (car old) :recursive) (second old)))
            (sub-in (and (consp old) (eq (car old) :recursive) (third old)))
            (total (+ leaf-weight branch-weight))
            (branch-choice
              (cond
                (*replaying-choices*
                 (if (and branch-gen (eql tag-in 1)) 1 0))
                ((null branch-gen) 0)
                ((< (random-below total) leaf-weight) 0)
                (t 1))))
       (multiple-value-bind (val subtrace)
           (let ((*remaining-replay-choices* (if (listp sub-in) sub-in nil))
                 (*choice-trace* nil))
             (values (draw-input (if (zerop branch-choice) leaf-gen branch-gen))
                     (nreverse *choice-trace*)))
         (push (list :recursive branch-choice subtrace) *choice-trace*)
         val)))))

(defun recursive (leaf-gen step-fn &key (max-depth 4) (leaf-weight 1) (branch-weight 1))
  (check-type leaf-gen input-generator)
  (check-type max-depth (integer 0 *))
  (check-type leaf-weight unsigned-byte)
  (check-type branch-weight unsigned-byte)
  (unless (plusp (+ leaf-weight branch-weight))
    (error "RECURSIVE requires positive total weight"))
  (let ((levels (make-array (1+ max-depth))))
    (setf (aref levels 0) (wrap-recursive-level leaf-gen nil leaf-weight branch-weight))
    (loop for d from 1 to max-depth do
      (setf (aref levels d)
            (wrap-recursive-level leaf-gen (funcall step-fn (aref levels (1- d)))
                                  leaf-weight branch-weight)))
    (sized (lambda (size)
             (aref levels (min max-depth (ceiling size 15)))))))

(defun s-expressions (&key (max-depth 3))
  (let ((atom-gen (one-of (booleans)
                          (integers :min -100 :max 100)
                          (ratios :max-bits 32)
                          (floats :format 'double-float)
                          (characters :unicode t)
                          (strings :min 0 :max 12 :unicode t)
                          (keywords :min 0 :max 10))))
    (recursive atom-gen
               (lambda (child)
                 (one-of (list-of child :min 0 :max 5)
                         (cons-of child child)
                         (vector-of child :min 0 :max 4)))
               :max-depth max-depth)))

(defun grammar-production-contains-nt-p (form nt-table)
  (cond
    ((symbolp form) (not (null (gethash form nt-table))))
    ((consp form)
     (or (grammar-production-contains-nt-p (car form) nt-table)
         (grammar-production-contains-nt-p (cdr form) nt-table)))))

(defun grammar (rules start &key (max-depth 5))
  (check-type max-depth unsigned-byte)
  (unless (and (listp rules) (every #'consp rules))
    (error "GRAMMAR expected non-empty alist of (NONTERMINAL PROD ...), got ~S" rules))
  (let ((rule-map (make-hash-table :test 'eq)))
    (dolist (entry rules)
      (unless (and (symbolp (car entry)) (cdr entry))
        (error "Invalid GRAMMAR rule ~S" entry))
      (when (gethash (car entry) rule-map)
        (error "Duplicate GRAMMAR nonterminal ~S" (car entry)))
      (setf (gethash (car entry) rule-map) t))
    (unless (gethash start rule-map)
      (error "Unknown start nonterminal ~S in GRAMMAR" start))
    (dolist (entry rules)
      (let* ((nt (car entry))
             (prods (coerce (cdr entry) 'simple-vector))
             (term-indices (loop for p across prods for i from 0
                                 unless (grammar-production-contains-nt-p p rule-map)
                                 collect i)))
        (setf (gethash nt rule-map)
              (cons prods (coerce term-indices 'simple-vector)))))
    (labels ((expand (nt depth)
               (let* ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
                      (rec-p (and (consp old) (eq (car old) :recursive)))
                      (saved-idx (and rec-p (second old)))
                      (saved-nt (and rec-p (third old)))
                      (saved-sub (and rec-p (fourth old)))
                      (entry (gethash nt rule-map))
                      (all-vec (car entry))
                      (term-vec (cdr entry))
                      (total (length all-vec)))
                 (when (and rec-p (not (eq saved-nt nt)))
                   (reject))
                 (let ((chosen-idx
                         (cond
                           (rec-p (if (typep saved-idx 'unsigned-byte) (min saved-idx (1- total)) 0))
                           ((and (>= depth max-depth) (plusp (length term-vec)))
                            (svref term-vec (random-below (length term-vec))))
                           (t (random-below total)))))
                   (multiple-value-bind (val subtrace)
                       (let ((*remaining-replay-choices* (if (listp saved-sub) saved-sub nil))
                             (*choice-trace* nil))
                         (labels ((eval-elem (el)
                                    (cond
                                      ((and (symbolp el) (gethash el rule-map))
                                       (expand el (1+ depth)))
                                      ((typep el 'input-generator)
                                       (draw-input el))
                                      ((consp el)
                                       (cons (eval-elem (car el)) (eval-elem (cdr el))))
                                      (t el))))
                           (values (eval-elem (svref all-vec chosen-idx))
                                   (nreverse *choice-trace*))))
                     (push (list :recursive chosen-idx nt subtrace) *choice-trace*)
                     val)))))
      (make-input-generator (lambda () (expand start 0))))))

(defun parse-numeric-bound (bound lower-p integer-p)
  (cond
    ((or (null bound) (eq bound '*)) (values nil nil))
    ((and (consp bound) (null (cdr bound)) (realp (car bound)))
     (if integer-p
         (values (if lower-p (1+ (car bound)) (1- (car bound))) nil)
         (values (car bound) t)))
    ((realp bound) (values bound nil))
    (t (error "Invalid numeric type bound ~S" bound))))

(defun apply-exclusive-real-bounds (gen lo lo-excl hi hi-excl)
  (if (or lo-excl hi-excl)
      (such-that (lambda (x)
                   (and (or (not lo-excl) (> x lo))
                        (or (not hi-excl) (< x hi))))
                 gen :attempts 25)
      gen))

(defun type-gen (type-spec)
  (cond
    ((symbolp type-spec)
     (case type-spec
       ((null) (just nil))
       ((boolean) (booleans))
       ((bit) (integers :min 0 :max 1))
       ((fixnum) (fixnums))
       ((bignum) (such-that (lambda (x) (typep x 'bignum)) (bignums) :attempts 20))
       ((integer) (exact-integers))
       ((ratio) (ratios))
       ((rational) (rationals))
       ((short-float single-float double-float long-float) (floats :format type-spec))
       ((float) (one-of (floats :format 'single-float) (floats :format 'double-float)))
       ((real) (one-of (exact-integers) (rationals) (floats :format 'double-float)))
       ((complex) (complexes))
       ((number) (one-of (exact-integers) (rationals) (floats :format 'double-float) (complexes)))
       ((character) (characters))
       ((base-char) (ascii-characters))
       ((standard-char) (one-of (just #\Newline) (printable-characters)))
       ((string simple-string base-string) (strings))
       ((keyword) (keywords))
       ((symbol) (symbols))
       ((cons) (cons-of (s-expressions :max-depth 2) (s-expressions :max-depth 2)))
       ((list) (list-of (s-expressions :max-depth 2) :max 6))
       ((vector simple-vector) (vector-of (s-expressions :max-depth 2) :max 6))
       ((bit-vector simple-bit-vector) (vector-of (integers :min 0 :max 1) :max 16 :element-type 'bit))
       ((array simple-array) (arrays (s-expressions :max-depth 1)))
       ((hash-table) (hash-tables (keywords :max 6) (s-expressions :max-depth 1) :max 6))
       ((atom) (one-of (just nil) (booleans) (exact-integers) (strings :max 6) (keywords) (characters)))
       ((sequence) (one-of (list-of (s-expressions :max-depth 1) :max 5)
                           (vector-of (s-expressions :max-depth 1) :max 5)
                           (strings :max 8)))
       ((t) (s-expressions :max-depth 2))
       (otherwise (error "Unsupported type specifier for TYPE-GEN: ~S" type-spec))))
    ((consp type-spec)
     (let ((head (car type-spec))
           (args (cdr type-spec)))
       (case head
         ((eql)
          (unless (= (length args) 1) (error "Invalid EQL type ~S" type-spec))
          (just (first args)))
         ((member)
          (unless args (error "Invalid empty MEMBER type ~S" type-spec))
          (apply #'elements args))
         ((mod)
          (unless (and (= (length args) 1) (integerp (first args)) (plusp (first args)))
            (error "Invalid MOD type ~S" type-spec))
          (integers :min 0 :max (1- (first args))))
         ((unsigned-byte)
          (let ((bits (first args)))
            (if (or (null bits) (eq bits '*))
                (nat)
                (integers :min 0 :max (1- (ash 1 bits))))))
         ((signed-byte)
          (let ((bits (first args)))
            (if (or (null bits) (eq bits '*))
                (integers)
                (let ((lim (ash 1 (1- bits))))
                  (integers :min (- lim) :max (1- lim))))))
         ((integer)
          (multiple-value-bind (lo lo-e) (parse-numeric-bound (first args) t t)
            (declare (ignore lo-e))
            (multiple-value-bind (hi hi-e) (parse-numeric-bound (second args) nil t)
              (declare (ignore hi-e))
              (integers :min lo :max hi))))
         ((rational)
          (multiple-value-bind (lo lo-e) (parse-numeric-bound (first args) t nil)
            (multiple-value-bind (hi hi-e) (parse-numeric-bound (second args) nil nil)
              (if (and (null lo) (null hi))
                  (rationals)
                  (let ((base (one-of (integers :min (and lo (ceiling lo))
                                                :max (and hi (floor hi)))
                                      (such-that (lambda (r)
                                                   (and (or (null lo) (>= r lo))
                                                        (or (null hi) (<= r hi))))
                                                 (rationals :max-bits 32)
                                                 :attempts 30))))
                    (apply-exclusive-real-bounds base lo lo-e hi hi-e))))))
         ((short-float single-float double-float long-float float real)
          (let ((fmt (if (member head '(float real)) 'double-float head)))
            (multiple-value-bind (lo lo-e) (parse-numeric-bound (first args) t nil)
              (multiple-value-bind (hi hi-e) (parse-numeric-bound (second args) nil nil)
                (let ((fgen (floats :format fmt :min lo :max hi)))
                  (if (eq head 'real)
                      (let ((rgen (if (and (null lo) (null hi))
                                      (one-of (exact-integers) (rationals) fgen)
                                      (one-of fgen
                                              (integers :min (and lo (ceiling lo))
                                                        :max (and hi (floor hi)))))))
                        (apply-exclusive-real-bounds rgen lo lo-e hi hi-e))
                      (apply-exclusive-real-bounds fgen lo lo-e hi hi-e)))))))
         ((or)
          (unless args (error "Invalid empty OR type ~S" type-spec))
          (if (member 'null args)
              (let ((others (remove 'null args)))
                (if others
                    (apply #'one-of (just nil) (mapcar #'type-gen others))
                    (just nil)))
              (apply #'one-of (mapcar #'type-gen args))))
         ((and)
          (unless args (error "Invalid empty AND type ~S" type-spec))
          (if (null (cdr args))
              (type-gen (first args))
              (let ((rest-types (cdr args)))
                (such-that (lambda (x) (every (lambda (tp) (typep x tp)) rest-types))
                           (type-gen (first args))
                           :attempts 40))))
         ((not)
          (unless (= (length args) 1) (error "Invalid NOT type ~S" type-spec))
          (let ((forbidden (first args)))
            (such-that (lambda (x) (not (typep x forbidden)))
                       (s-expressions :max-depth 2)
                       :attempts 40)))
         ((cons)
          (let ((car-t (if (or (null (first args)) (eq (first args) '*)) t (first args)))
                (cdr-t (if (or (null (second args)) (eq (second args) '*)) t (second args))))
            (cons-of (type-gen car-t) (type-gen cdr-t))))
         ((vector)
          (let* ((elem-t (if (or (null (first args)) (eq (first args) '*)) t (first args)))
                 (size (second args))
                 (exact-size (and size (not (eq size '*)) size)))
            (vector-of (type-gen elem-t)
                       :min (or exact-size 0)
                       :max (or exact-size 6)
                       :element-type elem-t)))
         ((simple-vector)
          (let* ((size (first args))
                 (exact-size (and size (not (eq size '*)) size)))
            (vector-of (s-expressions :max-depth 2)
                       :min (or exact-size 0)
                       :max (or exact-size 6))))
         ((string simple-string base-string)
          (let* ((size (first args))
                 (exact-size (and size (not (eq size '*)) size)))
            (strings :min (or exact-size 0)
                     :max (or exact-size 12)
                     :unicode (not (eq head 'base-string)))))
         ((bit-vector simple-bit-vector)
          (let* ((size (first args))
                 (exact-size (and size (not (eq size '*)) size)))
            (vector-of (integers :min 0 :max 1)
                       :min (or exact-size 0)
                       :max (or exact-size 16)
                       :element-type 'bit)))
         ((array simple-array)
          (let* ((elem-t (if (or (null (first args)) (eq (first args) '*)) t (first args)))
                 (dims (second args)))
            (cond
              ((or (null dims) (eq dims '*))
               (arrays (type-gen elem-t) :element-type elem-t))
              ((integerp dims)
               (arrays (type-gen elem-t) :min-rank dims :max-rank dims :element-type elem-t))
              ((listp dims)
               (let ((rank (length dims)))
                 (such-that (lambda (a)
                              (every (lambda (d spec) (or (eq spec '*) (= d spec)))
                                     (array-dimensions a) dims))
                            (arrays (type-gen elem-t)
                                    :min-rank rank :max-rank rank
                                    :max-dim (reduce #'max dims
                                                     :key (lambda (d) (if (integerp d) d 6))
                                                     :initial-value 0)
                                    :element-type elem-t)
                            :attempts 40)))
              (t (error "Invalid ARRAY dimension specifier ~S" dims)))))
         ((complex)
          (let ((part-t (first args)))
            (complexes :real-gen (type-gen (if (or (null part-t) (eq part-t '*))
                                               'double-float
                                               part-t)))))
         ((satisfies)
          (unless (and (= (length args) 1) (symbolp (first args)))
            (error "Invalid SATISFIES type ~S" type-spec))
          (such-that (symbol-function (first args)) (s-expressions :max-depth 2) :attempts 40))
         (otherwise (error "Unsupported compound type specifier for TYPE-GEN: ~S" type-spec)))))
    (t (error "Invalid type specifier for TYPE-GEN: ~S" type-spec))))

(defmacro defstruct-gen (name constructor &rest slot-specs)
  (let ((vars nil)
        (gens nil)
        (call-args nil))
    (dolist (spec slot-specs)
      (unless (and (consp spec) (= (length spec) 2) (symbolp (first spec)))
        (error "Expected (SLOT GENERATOR) or (:SLOT GENERATOR) in DEFSTRUCT-GEN: ~S" spec))
      (let ((slot (first spec))
            (gen-form (second spec))
            (var (gensym "SLOT")))
        (push var vars)
        (push gen-form gens)
        (if (keywordp slot)
            (progn (push slot call-args) (push var call-args))
            (push var call-args))))
    (setq vars (nreverse vars)
          gens (nreverse gens)
          call-args (nreverse call-args))
    `(defun ,name ()
       ,(if gens
            `(map-gen (lambda ,vars (,constructor ,@call-args)) ,@gens)
            `(just (,constructor))))))

(defun apply-sequence-edits (seq edits)
  (let ((items (coerce seq 'list)))
    (dolist (edit edits)
      (let ((op (first edit))
            (len (length items)))
        (case op
          (:delete
           (when (plusp len)
             (let ((pos (mod (second edit) len)))
               (setq items (append (subseq items 0 pos) (subseq items (1+ pos)))))))
          (:swap
           (when (>= len 2)
             (let ((i (mod (second edit) len))
                   (j (mod (third edit) len)))
               (when (/= i j)
                 (let ((vec (coerce items 'vector)))
                   (rotatef (aref vec i) (aref vec j))
                   (setq items (coerce vec 'list)))))))
          (:duplicate
           (when (plusp len)
             (let* ((pos (mod (second edit) len))
                    (val (nth pos items)))
               (setq items (append (subseq items 0 pos) (list val) (subseq items pos))))))
          (:insert
           (let ((pos (mod (second edit) (1+ len)))
                 (val (third edit)))
             (setq items (append (subseq items 0 pos) (list val) (subseq items pos)))))
          (:replace
           (when (plusp len)
             (let ((pos (mod (second edit) len))
                   (val (third edit))
                   (copy (copy-list items)))
               (setf (nth pos copy) val)
               (setq items copy)))))))
    (reconstruct-sequence-like seq items)))

(defun mutated-pair (base-gen &key (max-edits 5) element-gen)
  (check-type base-gen input-generator)
  (check-type max-edits unsigned-byte)
  (when element-gen (check-type element-gen input-generator))
  (let* ((pos-gen (nat :max 64))
         (ops (list (map-gen (lambda (p) (list :delete p)) pos-gen)
                    (map-gen (lambda (a b) (list :swap a b)) pos-gen pos-gen)
                    (map-gen (lambda (p) (list :duplicate p)) pos-gen)))
         (all-ops (if element-gen
                      (append ops
                              (list (map-gen (lambda (p v) (list :insert p v)) pos-gen element-gen)
                                    (map-gen (lambda (p v) (list :replace p v)) pos-gen element-gen)))
                      ops))
         (edit-gen (apply #'one-of all-ops)))
    (let-gen ((base base-gen)
              (edits (list-of edit-gen :min 0 :max max-edits)))
      (list base (apply-sequence-edits base edits)))))

(defun size-bounded-enumerator (leaf-gen step-fn &key (max-depth 2))
  (check-type leaf-gen input-generator)
  (check-type max-depth (integer 0 *))
  (unless (input-generator-enumerate leaf-gen)
    (error "SIZE-BOUNDED-ENUMERATOR requires an enumerable leaf generator"))
  (let ((levels (make-array (1+ max-depth))))
    (setf (aref levels 0) leaf-gen)
    (loop for d from 1 to max-depth do
      (let ((branch (funcall step-fn (aref levels (1- d)))))
        (unless (input-generator-enumerate branch)
          (error "SIZE-BOUNDED-ENUMERATOR step function must return an enumerable generator at depth ~D" d))
        (setf (aref levels d) (one-of leaf-gen branch))))
    (let ((top (aref levels max-depth)))
      (make-input-generator
       (input-generator-produce top)
       (lambda (emit)
         (let ((seen (make-hash-table :test 'equal)))
           (loop for d from 0 to max-depth do
             (enumerate-inputs (aref levels d)
               (lambda (v)
                 (unless (gethash v seen)
                   (setf (gethash v seen) t)
                   (funcall emit v)))))))
       (input-generator-shrink top)))))

(defun sample (g &key (count 10) (seed (fresh-seed)) (size 20) (max-discards 1000))
  (check-type count unsigned-byte)
  (check-type size unsigned-byte)
  (check-type seed (unsigned-byte 64))
  (check-type max-discards unsigned-byte)
  (let ((results nil)
        (collected 0)
        (discards 0))
    (loop for i from 0 while (< collected count) do
      (handler-case
          (progn
            (push (generate-inputs g (trial-seed seed 'sample i) size) results)
            (incf collected))
        (rejected-draw ()
          (incf discards)
          (when (> discards max-discards)
            (error "SAMPLE exhausted discard budget (~D)" max-discards)))))
    (nreverse results)))
