(in-package #:zk-pbt)
(defvar *observed-labels* nil)
(defvar *collecting-labels* nil)
(defvar *collected-notes* nil)
(defvar *collecting-notes* nil)
(defvar *observed-targets* nil)
(defvar *collecting-targets* nil)
(defvar *condition-key-function* nil)
(defvar *default-corpus* nil)
(defvar *last-failure* nil)
(define-condition property-violation (error)
  ((key :initarg :key :reader property-violation-key)
   (details :initarg :details :initform nil :reader violation-details)))
(define-condition machine-callback-error (error)
  ((cause :initarg :cause :reader machine-callback-cause)
   (prior :initarg :prior :initform nil :reader preceding-failure))
  (:report (lambda (c s) (format s "State-machine callback or command validation: ~A" (machine-callback-cause c)))))

(define-condition assumption-rejected (rejected-draw) ())

(defmacro claim (key form &optional details)
  `(or ,form (error 'property-violation :key ,key :details ,details)))

(defmacro assume (form)
  `(or ,form
       (progn
         (signal 'assumption-rejected)
         (error "ZK-PBT:ASSUME rejected outside a property run"))))

(defun note (datum &rest args)
  (when *collecting-notes*
    (push (if args (apply #'format nil datum args) (princ-to-string datum))
          *collected-notes*))
  nil)

(defun target (score &optional (label :default))
  (check-type score real)
  (when *collecting-targets*
    (let ((entry (assoc label *observed-targets* :test #'equal)))
      (if entry
          (when (> score (cdr entry))
            (setf (cdr entry) score))
          (push (cons label score) *observed-targets*))))
  score)

(defun classify (label predicate)
  (when (and *collecting-labels* predicate) (pushnew label *observed-labels* :test #'equal))
  predicate)

(defun collect (value)
  (classify value t)
  value)

(defun tabulate (group &rest values)
  (dolist (v values (first values))
    (classify (cons group v) t)))

(defun format-range-bucket (value step)
  (if step
      (let* ((lo (* step (floor value step)))
             (hi (+ lo step -1)))
        (format nil "~D..~D" lo hi))
      (cond
        ((zerop value) "0")
        ((plusp value)
         (let ((lo 1))
           (loop while (>= value (* lo 10)) do (setq lo (* lo 10)))
           (if (= lo 1)
               (if (= value 1) "1" "2..9")
               (format nil "~D..~D" lo (1- (* lo 10))))))
        (t
         (let ((lo 1) (mag (- value)))
           (loop while (>= mag (* lo 10)) do (setq lo (* lo 10)))
           (if (= lo 1)
               (if (= mag 1) "-1" "-9..-2")
               (format nil "-~D..-~D" (1- (* lo 10)) lo)))))))

(defun collect-range (group value &key step)
  (check-type value integer)
  (when step (check-type step (integer 1 *)))
  (tabulate group (format-range-bucket value step))
  value)

(defstruct (property (:constructor make-property (name arity options condition-key &optional context-fn (expect :passed) defaults)))
  name arity options condition-key context-fn expect defaults)

(defun register-property (name arity options condition-key &optional context-fn (expect :passed) defaults)
  (let ((definition (make-property name arity options condition-key context-fn expect defaults))
        (predicate (symbol-function name)))
    (zk-test::register-test-entry name :property
      (lambda (&rest settings) (apply #'execute-property definition predicate settings))
      definition)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun parse-property-params (params)
    (cond
      ((every (lambda (v) (and (symbolp v) (not (member v lambda-list-keywords)))) params)
       (values params nil))
      ((every (lambda (v) (and (consp v) (= (length v) 2) (symbolp (first v))
                               (not (member (first v) lambda-list-keywords))))
              params)
       (values (mapcar #'first params)
               `(tuple ,@(mapcar #'second params))))
      (t (error "Properties take fixed positional symbols or (VAR GENERATOR) bindings: ~S" params))))

  (defun parse-property-clauses (param-names body allow-run-options-p)
    (let ((doc nil) (generate nil) (enum nil) (examples nil) (cover nil)
          (condition-key nil) (context-fn nil) (expect :passed)
          (defaults nil) (exec-args nil)
          (check-supplied-p nil) (check-val t)
          (name-val 'for-all)
          (seen nil))
      (when (and (stringp (car body)) (cdr body))
        (setq doc (pop body)))
      (loop while (and (consp (car body)) (keywordp (caar body))) do
        (let* ((option (pop body)) (key (car option)) (args (cdr option)))
          (when (and (not (eq key :cover)) (member key seen))
            (error "Repeated property option ~S" key))
          (push key seen)
          (case key
            ((:generate :enumerate)
             (unless (= (length args) 1) (error "Expected one generator in ~S" option))
             (if (eq key :generate) (setq generate (first args)) (setq enum (first args))))
            (:failure-key
             (unless (= 1 (length args)) (error "Expected a condition key function in ~S" option))
             (setq condition-key (car args)))
            (:context
             (unless (= 1 (length args)) (error "Expected a context rendering function in ~S" option))
             (setq context-fn (car args)))
            (:expect
             (unless (and (= 1 (length args))
                          (member (car args) '(:passed :falsified :insufficient)))
               (error "Expected :expect to be :passed, :falsified, or :insufficient in ~S" option))
             (setq expect (car args)))
            (:examples
             (dolist (row args)
               (unless (and (listp row) (= (length row) (length param-names)))
                 (error "Each :examples entry must be an argument list of length ~D: ~S"
                        (length param-names) row)))
             (setq examples args))
            (:cover
             (let* ((argc (length args))
                    (label (first args))
                    (marker (second args))
                    (fraction (third args))
                    (conf (when (= argc 5)
                            (unless (eq (fourth args) :confidence)
                              (error "Expected :confidence in ~S" option))
                            (fifth args))))
               (unless (and (member argc '(3 5))
                            (eq marker :at-least)
                            (rationalp fraction) (<= 0 fraction 1)
                            (or (null conf) (and (realp conf) (< 0 conf 1)))
                            (not (assoc label cover :test #'equal)))
                 (error "Invalid coverage goal ~S" option))
               (push (list label fraction conf) cover)))
            ((:trials :max-size :max-discards :max-discard-ratio :max-shrinks :max-enumerated
              :timeout-ms :auto-save :max-coverage-trials)
             (unless (= (length args) 1) (error "Expected one value in ~S" option))
             (push (first args) defaults)
             (push key defaults))
            ((:seed :corpus)
             (unless allow-run-options-p (error "Option ~S is only valid in FOR-ALL" key))
             (unless (= (length args) 1) (error "Expected one value in ~S" option))
             (push (first args) exec-args)
             (push key exec-args))
            (:check
             (unless allow-run-options-p (error "Option ~S is only valid in FOR-ALL" key))
             (unless (= (length args) 1) (error "Expected one value in ~S" option))
             (setq check-val (first args) check-supplied-p t))
            (:name
             (unless allow-run-options-p (error "Option ~S is only valid in FOR-ALL" key))
             (unless (= (length args) 1) (error "Expected one value in ~S" option))
             (setq name-val (first args)))
            (otherwise (error "Unknown property option ~S" key)))))
      (values doc generate enum examples cover condition-key context-fn expect
              defaults exec-args check-val check-supplied-p name-val body))))

(defmacro defproperty (name params &body body)
  (multiple-value-bind (param-names inline-generate) (parse-property-params params)
    (multiple-value-bind (doc generate enum examples cover condition-key context-fn expect
                              defaults exec-args check-val check-supplied-p name-val body)
        (parse-property-clauses param-names body nil)
      (declare (ignore exec-args check-val check-supplied-p name-val))
      (when (and generate inline-generate)
        (error "Cannot combine (:generate ...) with (VAR GENERATOR) bindings"))
      (let ((final-generate (or generate inline-generate)))
        (when (and cover (not final-generate)) (error "Random coverage requires :generate"))
        `(progn
           (defun ,name ,param-names
             ,@(when doc (list doc))
             ,@body)
           (register-property ',name ,(length param-names)
             (lambda () (values ,final-generate ,enum ',examples ',cover))
             ,condition-key ,context-fn ',expect
             ,(when defaults `(list ,@defaults))))))))

(defmacro for-all (params &body body)
  (multiple-value-bind (param-names inline-generate) (parse-property-params params)
    (multiple-value-bind (doc generate enum examples cover condition-key context-fn expect
                              defaults exec-args check-val check-supplied-p name-val body)
        (parse-property-clauses param-names body t)
      (declare (ignore doc check-supplied-p))
      (when (and generate inline-generate)
        (error "Cannot combine (:generate ...) with (VAR GENERATOR) bindings"))
      (let ((final-generate (or generate inline-generate))
            (name-expr (if (and (symbolp name-val) (not (keywordp name-val))
                                (not (member name-val '(t nil))))
                           (list 'quote name-val)
                           name-val))
            (prop-var (gensym "PROP"))
            (pred-var (gensym "PRED"))
            (raw-var (gensym "RAW"))
            (rep-var (gensym "REPORT"))
            (check-var (gensym "CHECK")))
        (when (and cover (not final-generate)) (error "Random coverage requires :generate"))
        `(let* ((,prop-var (make-property ,name-expr ,(length param-names)
                                          (lambda () (values ,final-generate ,enum ',examples ',cover))
                                          ,condition-key ,context-fn ',expect
                                          ,(when defaults `(list ,@defaults))))
                (,pred-var (lambda ,param-names ,@body))
                (,check-var ,check-val)
                (,raw-var (apply #'execute-property ,prop-var ,pred-var
                                 (append (list ,@exec-args)
                                         (nth-value 1 (zk-test::split-keyword-option zk-test:*run-options* :filter)))))
                (,rep-var (zk-test::make-report (report-status ,raw-var)
                            (append (report-data ,raw-var)
                                    (list :forall-property (cons ,prop-var ,pred-var))))))
           (unless (eq (report-status ,rep-var) :passed)
             (setq *last-failure* ,rep-var))
           (if ,check-var
               (if (eq (report-status ,rep-var) :passed)
                   (values t ,rep-var)
                   (error 'check-failed :report ,rep-var))
               ,rep-var))))))

(defun run (name &rest options)
  (unless (zk-test::entry-info name :property) (error "Unknown property ~S" name))
  (apply #'zk-test:run name options))
(defun check (name &rest options)
  (unless (zk-test::entry-info name :property) (error "Unknown property ~S" name))
  (apply #'zk-test:check name options))

(defun observe-property (function args arity)
  (unless (and (listp args) (= arity (length args)))
    (error "Expected ~D-element argument list for property, got ~S; wrap single generators with ZK-PBT:TUPLE"
           arity args))
  (let ((*collecting-labels* t) (*observed-labels* nil)
        (*collecting-notes* t) (*collected-notes* nil)
        (*collecting-targets* t) (*observed-targets* nil))
    (handler-case
        (values (unless (apply function args) '(:predicate))
                *observed-labels*
                nil
                (nreverse *collected-notes*)
                *observed-targets*)
      (machine-callback-error (c) (error c))
      (zk-test::assertion-failure (c)
        (values (list :assertion (zk-test::assertion-form c))
                *observed-labels*
                (zk-test::assertion-details c)
                (nreverse *collected-notes*)
                *observed-targets*))
      (property-violation (c)
        (values (list :claim (property-violation-key c))
                *observed-labels*
                (violation-details c)
                (nreverse *collected-notes*)
                *observed-targets*))
      (error (c)
        (values (if *condition-key-function*
                    (list :condition (class-name (class-of c)) (funcall *condition-key-function* c))
                    (list :condition (class-name (class-of c))))
                *observed-labels*
                c
                (nreverse *collected-notes*)
                *observed-targets*)))))

(defun remove-list-range (items start count)
  (let ((end (+ start count))
        (out nil))
    (loop for item in items for i from 0 do
      (when (or (< i start) (>= i end))
        (push item out)))
    (nreverse out)))

(defun trace-tag (node)
  (and (consp node)
       (member (car node) '(:sequence :recursive :no-shrink) :test #'eq)
       (car node)))

(defun trace-children (node)
  (if (trace-tag node) (cdr node) node))

(defun rewrap-trace (tag children)
  (if tag (cons tag children) children))

(defun trace-node-at (trace addr)
  (let ((cur trace))
    (dolist (idx addr cur)
      (unless (consp cur) (return-from trace-node-at nil))
      (let ((items (trace-children cur)))
        (unless (< idx (length items)) (return-from trace-node-at nil))
        (setq cur (nth idx items))))))

(defun replace-trace-at (trace addr replacement)
  (if (null addr)
      replacement
      (let* ((tag (trace-tag trace))
             (items (trace-children trace))
             (idx (car addr))
             (rest (cdr addr))
             (updated (loop for item in items for i from 0
                            collect (if (= i idx)
                                        (replace-trace-at item rest replacement)
                                        item))))
        (rewrap-trace tag updated))))

(defun collect-descendant-recursive-nodes (node)
  (let ((out nil))
    (labels ((walk (x top-p)
               (when (consp x)
                 (let ((tag (trace-tag x)))
                   (unless (eq tag :no-shrink)
                     (when (and (not top-p) (eq tag :recursive))
                       (push x out))
                     (dolist (child (trace-children x))
                       (walk child nil)))))))
      (walk node t))
    out))

(defun trace-node-rank (x)
  (cond ((integerp x) 0)
        ((symbolp x) 1)
        ((consp x) 2)
        (t 3)))

(defun trace-less-p (a b)
  (let ((ra (trace-node-rank a))
        (rb (trace-node-rank b)))
    (cond
      ((/= ra rb) (< ra rb))
      ((= ra 0) (< a b))
      ((= ra 1) (string< (symbol-name a) (symbol-name b)))
      ((= ra 2)
       (loop
         (when (and (null a) (null b)) (return nil))
         (when (null a) (return t))
         (when (null b) (return nil))
         (when (or (not (consp a)) (not (consp b)))
           (return (trace-less-p a b)))
         (cond ((trace-less-p (car a) (car b)) (return t))
               ((trace-less-p (car b) (car a)) (return nil)))
         (setq a (cdr a) b (cdr b)))))))

(defun swap-list-adjacent (items idx)
  (loop for rest on items for i from 0
        collect (cond
                  ((= i idx) (second rest))
                  ((= i (1+ idx)) (nth idx items))
                  (t (car rest)))))

(defun collect-positive-integer-addresses (trace)
  (let ((by-value (make-hash-table :test 'eql))
        (values nil))
    (labels ((walk (node rev-addr)
               (cond
                 ((and (integerp node) (plusp node))
                  (let ((addr (reverse rev-addr)))
                    (unless (gethash node by-value)
                      (push node values))
                    (push addr (gethash node by-value))))
                 ((consp node)
                  (unless (eq (trace-tag node) :no-shrink)
                    (loop for child in (trace-children node) for i from 0 do
                      (walk child (cons i rev-addr))))))))
      (walk trace nil))
    (loop for v in (sort values #'>)
          for addrs = (nreverse (gethash v by-value))
          when (>= (length addrs) 2)
            collect (cons v addrs))))

(defun trace-complexity (node)
  (cond
    ((integerp node) (1+ (abs node)))
    ((consp node)
     (let ((sum 1))
       (dolist (child (trace-children node) sum)
         (incf sum (trace-complexity child)))))
    (t 1)))

(defun replace-all-trace-addrs (trace addrs replacement)
  (let ((cur trace))
    (dolist (addr addrs cur)
      (setq cur (replace-trace-at cur addr replacement)))))

(defun collect-all-positive-integer-addrs (trace)
  (let ((out nil))
    (labels ((walk (node rev-addr)
               (cond
                 ((and (integerp node) (plusp node))
                  (push (cons (reverse rev-addr) node) out))
                 ((consp node)
                  (unless (eq (trace-tag node) :no-shrink)
                    (loop for child in (trace-children node) for i from 0 do
                      (walk child (cons i rev-addr))))))))
      (walk trace nil))
    (nreverse out)))

(defun collect-integer-addresses (trace)
  (let ((out nil))
    (labels ((walk (node rev-addr)
               (cond
                 ((integerp node)
                  (push (cons (reverse rev-addr) node) out))
                 ((consp node)
                  (unless (eq (trace-tag node) :no-shrink)
                    (loop for child in (trace-children node) for i from 0 do
                      (walk child (cons i rev-addr))))))))
      (walk trace nil))
    (nreverse out)))

(defun mutate-trace-path (path stream-seed)
  (let ((int-addrs (collect-integer-addresses path)))
    (if (null int-addrs)
        path
        (let* ((w0 (splitmix-word (u64 stream-seed)))
               (w1 (splitmix-word w0))
               (vec (coerce int-addrs 'simple-vector))
               (entry (svref vec (mod w0 (length vec))))
               (addr (car entry))
               (val (cdr entry))
               (delta (- (mod w1 17) 8))
               (next-val (max 0 (+ val (if (zerop delta) 1 delta)))))
          (replace-trace-at path addr next-val)))))

(defun zero-sequence-items (items)
  (let ((changed 0))
    (let ((zeroed
            (loop for item in items
                  collect (cond
                            ((and (integerp item) (plusp item))
                             (incf changed)
                             0)
                            ((and (consp item) (null (cdr item))
                                  (integerp (car item)) (plusp (car item)))
                             (incf changed)
                             (list 0))
                            (t item)))))
      (values zeroed changed))))

(defun collect-generated-functions (root)
  (let ((seen (make-hash-table :test 'eq))
        (out nil))
    (labels ((walk (x)
               (cond
                 ((null x) nil)
                 ((and (functionp x) (find-generated-function-spec x))
                  (unless (gethash x seen)
                    (setf (gethash x seen) t)
                    (push x out)))
                 ((or (numberp x) (characterp x) (symbolp x) (stringp x)) nil)
                 ((or (consp x) (arrayp x) (hash-table-p x))
                  (unless (gethash x seen)
                    (setf (gethash x seen) t)
                    (cond
                      ((consp x) (walk (car x)) (walk (cdr x)))
                      ((arrayp x)
                       (dotimes (i (array-total-size x))
                         (walk (row-major-aref x i))))
                      ((hash-table-p x)
                       (maphash (lambda (k v) (walk k) (walk v)) x))))))))
      (walk root))
    (nreverse out)))

(defun sync-generated-function-calls (dst src)
  (let ((dfns (collect-generated-functions dst))
        (sfns (collect-generated-functions src)))
    (loop for df in dfns for sf in sfns do
      (let ((dspec (find-generated-function-spec df))
            (sspec (find-generated-function-spec sf)))
        (when (and dspec sspec (fourth dspec) (fourth sspec))
          (setf (car (fourth dspec)) (copy-list (car (fourth sspec)))))))))

(defun normal-quantile (p)
  (let* ((pf (float p 1.0d0))
         (a1 -3.969683028665376d+01) (a2  2.209460984245205d+02)
         (a3 -2.759285104469687d+02) (a4  1.383577518672690d+02)
         (a5 -3.066479806614716d+01) (a6  2.506628277459239d+00)
         (b1 -5.447609879822406d+01) (b2  1.615858368580409d+02)
         (b3 -1.556989798598866d+02) (b4  6.680131188771972d+01)
         (b5 -1.328068155288572d+01)
         (c1 -7.784894002430293d-03) (c2 -3.223964580411365d-01)
         (c3 -2.400758277161838d+00) (c4 -2.549732539343734d+00)
         (c5  4.374664141464968d+00) (c6  2.938163982698783d+00)
         (d1  7.784695709041462d-03) (d2  3.224671290700398d-01)
         (d3  2.445134137142996d+00) (d4  3.754408661907416d+00)
         (plow 0.02425d0) (phigh (- 1.0d0 0.02425d0)))
    (cond
      ((< pf plow)
       (let ((q (sqrt (* -2.0d0 (log pf)))))
         (/ (+ (* (+ (* (+ (* (+ (* (+ (* c1 q) c2) q) c3) q) c4) q) c5) q) c6)
            (+ (* (+ (* (+ (* (+ (* d1 q) d2) q) d3) q) d4) q) 1.0d0))))
      ((> pf phigh)
       (let ((q (sqrt (* -2.0d0 (log (- 1.0d0 pf))))))
         (- (/ (+ (* (+ (* (+ (* (+ (* (+ (* c1 q) c2) q) c3) q) c4) q) c5) q) c6)
               (+ (* (+ (* (+ (* (+ (* d1 q) d2) q) d3) q) d4) q) 1.0d0)))))
      (t
       (let* ((q (- pf 0.5d0))
              (r (* q q)))
         (/ (* (+ (* (+ (* (+ (* (+ (* (+ (* a1 r) a2) r) a3) r) a4) r) a5) r) a6) q)
            (+ (* (+ (* (+ (* (+ (* (+ (* b1 r) b2) r) b3) r) b4) r) b5) r) 1.0d0)))))))

(defun wilson-interval (observed n confidence)
  (let* ((z (normal-quantile confidence))
         (nf (float n 1.0d0))
         (phat (/ (float observed 1.0d0) nf))
         (z2 (* z z))
         (denom (+ 1.0d0 (/ z2 nf)))
         (center (/ (+ phat (/ z2 (* 2.0d0 nf))) denom))
         (margin (/ (* z (sqrt (+ (/ (* phat (- 1.0d0 phat)) nf)
                                  (/ z2 (* 4.0d0 nf nf)))))
                    denom)))
    (values (max 0.0d0 (- center margin))
            (min 1.0d0 (+ center margin)))))

(defun try-encode-case-value (value)
  (handler-case (values (encode-case-value value) t) (error () (values nil nil))))

(defun enumeration-case (property index)
  (let ((n 0) (g (nth-value 1 (funcall (property-options property)))))
    (enumerate-inputs g (lambda (args)
                          (when (= n index) (return-from enumeration-case args))
                          (incf n)))
    (error "Enumeration no longer contains case ~D" index)))

(defun render-counterexample-context (context-fn args)
  (when context-fn
    (handler-case (apply context-fn args)
      (error (c) (format nil "<context error: ~A>" c)))))

(defun example-case (property index)
  (let ((examples (nth-value 2 (funcall (property-options property)))))
    (if (< index (length examples))
        (nth index examples)
        (error "Examples no longer contain case ~D" index))))

(defun analyze-failure (property observe source input-generator initial-path stream size index
                        original encoded-p failure details budget &optional deadline)
  (let ((best initial-path) (reduced original) (reduced-encoded-p encoded-p)
        (domain-args nil) (domain-args-p nil)
        (attempts 0) (paths (make-hash-table :test 'equal))
        (inputs (make-hash-table :test 'equal)) (reason :no-generator))
    (labels ((rebuild (path data supported)
               (cond (supported (decode-case-value data))
                     (domain-args-p (clone-arguments domain-args))
                     (input-generator (generate-inputs input-generator stream size path))
                     ((eq source :enumerated) (enumeration-case property index))
                     ((eq source :examples) (example-case property index))
                     (t (error "Cannot reconstruct case without an input codec"))))
             (make-rebuilder ()
               (lambda (which)
                 (ecase which
                   (:original (rebuild initial-path original encoded-p))
                   (:reduced (rebuild best reduced reduced-encoded-p)))))
             (confirm (path data supported)
               (let ((run-args (clone-arguments (rebuild path data supported))))
                 (multiple-value-bind (outcome labels detail notes targets)
                     (funcall observe run-args)
                   (declare (ignore labels targets))
                   (unless (equal outcome failure)
                     (return-from analyze-failure
                       (values :unstable
                               (list :failure failure :observed outcome
                                     :original (and encoded-p (decode-case-value original))
                                     :original-available (not (null encoded-p))
                                     :rebuild (make-rebuilder)))))
                   (values detail notes run-args)))))
      (handler-case
          (progn
            (confirm initial-path original encoded-p)
            (when input-generator
              (setf (gethash initial-path paths) t)
              (when encoded-p
                (setf (gethash original inputs) (cons t (trace-complexity initial-path))))
              (block shrink
                (labels ((try-candidate (path)
                           (when (and deadline (>= (get-internal-real-time) deadline))
                             (setf reason :timeout)
                             (return-from shrink))
                           (when (>= attempts budget)
                             (setf reason :budget)
                             (return-from shrink))
                           (when (gethash path paths)
                             (return-from try-candidate nil))
                           (incf attempts)
                           (setf (gethash path paths) t)
                           (handler-case
                               (multiple-value-bind (args actual-path)
                                   (generate-inputs input-generator stream size path)
                                 (when (and (not (equal actual-path path))
                                            (gethash actual-path paths))
                                   (return-from try-candidate nil))
                                 (setf (gethash actual-path paths) t)
                                 (multiple-value-bind (data ok) (try-encode-case-value args)
                                   (let* ((cand-cost (trace-complexity actual-path))
                                          (cached (and ok (gethash data inputs))))
                                     (when (and cached
                                                (or (null (car cached))
                                                    (>= cand-cost (cdr cached))))
                                       (return-from try-candidate nil))
                                     (let ((failed-p (equal failure (funcall observe (clone-arguments args)))))
                                       (when ok
                                         (setf (gethash data inputs)
                                               (if failed-p
                                                   (cons t (if (and cached (car cached))
                                                               (min cand-cost (cdr cached))
                                                               cand-cost))
                                                   (cons nil 0))))
                                       (when failed-p
                                         (setf best actual-path reduced data reduced-encoded-p ok)
                                         t)))))
                             (rejected-draw () nil)))
                         (shrink-integer-at (addr)
                           (let ((c (trace-node-at best addr)))
                             (when (and (integerp c) (plusp c))
                               (when (try-candidate (replace-trace-at best addr 0))
                                 (return-from shrink-integer-at t))
                               (let ((hi (trace-node-at best addr)))
                                 (unless (and (integerp hi) (plusp hi))
                                   (return-from shrink-integer-at nil))
                                 (when (and (> hi 1) (try-candidate (replace-trace-at best addr 1)))
                                   (return-from shrink-integer-at t))
                                 (let ((lo (if (> hi 1) 2 1))
                                       (any-improved nil))
                                   (loop while (< lo hi) do
                                     (let* ((mid (floor (+ lo hi) 2))
                                            (cand (replace-trace-at best addr mid)))
                                       (if (try-candidate cand)
                                           (let ((cur (trace-node-at best addr)))
                                             (setq any-improved t)
                                             (if (and (integerp cur) (< cur hi))
                                                 (setq hi cur)
                                                 (return)))
                                           (setq lo (1+ mid)))))
                                   any-improved)))))
                         (shrink-shared-integers (addrs hi)
                           (when (try-candidate (replace-all-trace-addrs best addrs 0))
                             (return-from shrink-shared-integers t))
                           (when (and (> hi 1)
                                      (every (lambda (a) (integerp (trace-node-at best a))) addrs)
                                      (try-candidate (replace-all-trace-addrs best addrs 1)))
                             (return-from shrink-shared-integers t))
                           (let ((lo (if (> hi 1) 2 1))
                                 (any-improved nil))
                             (loop while (and (< lo hi)
                                              (every (lambda (a) (integerp (trace-node-at best a))) addrs))
                                   do (let ((mid (floor (+ lo hi) 2)))
                                        (if (try-candidate (replace-all-trace-addrs best addrs mid))
                                            (setq any-improved t hi mid)
                                            (setq lo (1+ mid)))))
                             any-improved))
                         (redistribute-pair (addr1 v1 addr2 v2)
                           (let ((sum (+ v1 v2)))
                             (cond
                               ((try-candidate (replace-trace-at (replace-trace-at best addr1 0) addr2 sum)) t)
                               ((try-candidate (replace-trace-at (replace-trace-at best addr1 sum) addr2 0)) t)
                               ((and (> v1 1)
                                     (let ((half (floor v1 2)))
                                       (try-candidate (replace-trace-at (replace-trace-at best addr1 half)
                                                                        addr2 (- sum half)))))
                                t))))
                         (shrink-at (addr)
                           (let ((node (trace-node-at best addr)))
                             (cond
                               ((and (integerp node) (plusp node))
                                (shrink-integer-at addr))
                               ((consp node)
                                (let ((tag (trace-tag node))
                                      (improved nil))
                                  (when (eq tag :no-shrink)
                                    (return-from shrink-at nil))
                                  (when (eq tag :recursive)
                                    (dolist (desc (collect-descendant-recursive-nodes node))
                                      (when (try-candidate (replace-trace-at best addr desc))
                                        (setq improved t)
                                        (return))))
                                  (when (eq tag :sequence)
                                    (block seq-blocks
                                      (loop
                                        (let* ((cur (trace-node-at best addr))
                                               (items (and (consp cur) (eq (trace-tag cur) :sequence) (trace-children cur)))
                                               (len (length items))
                                               (block-improved nil))
                                          (when (zerop len) (return-from seq-blocks))
                                          (block one-block
                                            (loop for b = len then (floor b 2) while (plusp b) do
                                              (loop for i from 0 to (- len b) by b do
                                                (when (try-candidate
                                                       (replace-trace-at best addr
                                                                         (cons :sequence (remove-list-range items i b))))
                                                  (setq improved t block-improved t)
                                                  (return-from one-block)))))
                                          (unless block-improved (return-from seq-blocks)))))
                                    (let* ((cur (trace-node-at best addr))
                                           (items (and (consp cur) (eq (trace-tag cur) :sequence) (trace-children cur))))
                                      (multiple-value-bind (zeroed changed) (zero-sequence-items items)
                                        (when (and (>= changed 2)
                                                   (try-candidate (replace-trace-at best addr (cons :sequence zeroed))))
                                          (setq improved t))))
                                    (let* ((cur (trace-node-at best addr))
                                           (items (and (consp cur) (eq (trace-tag cur) :sequence) (trace-children cur)))
                                           (len (length items)))
                                      (when (> len 1)
                                        (let ((min-item (car items)))
                                          (dolist (it (cdr items))
                                            (when (trace-less-p it min-item) (setq min-item it)))
                                          (loop for i from 0 below len do
                                            (let* ((latest (trace-node-at best addr))
                                                   (cur-items (and (consp latest) (eq (trace-tag latest) :sequence)
                                                                   (trace-children latest))))
                                              (when (and (< i (length cur-items))
                                                         (trace-less-p min-item (nth i cur-items))
                                                         (try-candidate
                                                          (replace-trace-at best addr
                                                                            (cons :sequence
                                                                                  (loop for x in cur-items for idx from 0
                                                                                        collect (if (= idx i) min-item x))))))
                                                (setq improved t)))))
                                        (loop for i from 0 below (1- len) do
                                          (let* ((latest (trace-node-at best addr))
                                                 (cur-items (and (consp latest) (eq (trace-tag latest) :sequence)
                                                                 (trace-children latest))))
                                            (when (and (< (1+ i) (length cur-items))
                                                       (trace-less-p (nth (1+ i) cur-items) (nth i cur-items))
                                                       (try-candidate
                                                        (replace-trace-at best addr
                                                                          (cons :sequence (swap-list-adjacent cur-items i)))))
                                              (setq improved t)))))))
                                  (loop for i from 0 do
                                    (let* ((cur (trace-node-at best addr))
                                           (items (and (consp cur) (trace-children cur))))
                                      (when (>= i (length items)) (return))
                                      (when (shrink-at (append addr (list i)))
                                        (setq improved t))))
                                  improved))))))
                  (loop
                    (let ((node-improved nil)
                          (shared-improved nil)
                          (redist-improved nil))
                      (loop while (shrink-at nil) do (setq node-improved t))
                      (dolist (group (collect-positive-integer-addresses best))
                        (when (shrink-shared-integers (cdr group) (car group))
                          (setq shared-improved t)))
                      (let ((pos-addrs (collect-all-positive-integer-addrs best)))
                        (loop for pair on pos-addrs
                              for count from 0 below 16
                              while (cdr pair) do
                                (let ((a1 (caar pair)) (v1 (cdar pair))
                                      (a2 (caadr pair)) (v2 (cdadr pair)))
                                  (when (and (integerp (trace-node-at best a1))
                                             (integerp (trace-node-at best a2))
                                             (redistribute-pair a1 v1 a2 v2))
                                    (setq redist-improved t)
                                    (return)))))
                      (unless (or node-improved shared-improved redist-improved)
                        (setf reason :exhausted)
                        (return-from shrink))))))
              (let ((domain-shrinker (input-generator-shrink input-generator)))
                (when (and domain-shrinker (< attempts budget))
                  (let ((current-args (rebuild best reduced reduced-encoded-p))
                        (domain-inputs (make-hash-table :test 'equal)))
                    (when reduced-encoded-p
                      (setf (gethash reduced domain-inputs) t))
                    (block domain-shrink
                      (loop
                        (let ((improved nil))
                          (dolist (cand-args (funcall domain-shrinker current-args))
                            (when (and deadline (>= (get-internal-real-time) deadline))
                              (setf reason :timeout)
                              (return-from domain-shrink))
                            (when (>= attempts budget)
                              (setf reason :budget)
                              (return-from domain-shrink))
                            (unless (equal cand-args current-args)
                              (incf attempts)
                              (handler-case
                                  (multiple-value-bind (data ok) (try-encode-case-value cand-args)
                                    (unless (and ok (gethash data domain-inputs))
                                      (when ok (setf (gethash data domain-inputs) t))
                                      (when (equal failure (funcall observe (clone-arguments cand-args)))
                                        (setq current-args cand-args
                                              domain-args cand-args
                                              domain-args-p t
                                              reduced data
                                              reduced-encoded-p ok
                                              improved t)
                                        (return))))
                                (rejected-draw () nil))))
                          (unless improved
                            (setf reason :exhausted)
                            (return-from domain-shrink)))))))))
            (multiple-value-bind (reduced-details reduced-notes eval-args)
                (confirm best reduced reduced-encoded-p)
              (multiple-value-bind (reduced-value rebuild-err)
                  (handler-case (values (rebuild best reduced reduced-encoded-p) nil)
                    (error (c) (values nil c)))
                (let* ((original-value (and encoded-p (decode-case-value original)))
                       (context-text (render-counterexample-context (property-context-fn property) reduced-value))
                       (regression-case (and encoded-p reduced-encoded-p
                                             (list (encode-case-value (property-name property))
                                                   (encode-case-value failure) original reduced))))
                  (when (and reduced-value eval-args (contains-generated-function-p reduced-value))
                    (sync-generated-function-calls reduced-value eval-args))
                  (values :falsified
                          (append
                           (list :failure failure :original-details details :details reduced-details
                                 :original original-value
                                 :original-available (not (null encoded-p))
                                 :reduced reduced-value
                                 :reduced-available (or reduced-encoded-p (not (null reduced-value)))
                                 :context context-text
                                 :choices best :shrinks attempts :shrink-stop reason
                                 :persistable (not (null regression-case)) :regression-case regression-case
                                 :rebuild (unless regression-case (make-rebuilder)))
                           (when rebuild-err (list :rebuild-error rebuild-err))
                           (when reduced-notes (list :notes reduced-notes))))))))
        (machine-callback-error (c)
          (values :error (list :condition c
                               :prior (or (preceding-failure c) failure)
                               :original (and encoded-p (decode-case-value original))
                               :original-available (not (null encoded-p)))))
        (error (c)
          (values :error (list :condition c
                               :prior failure
                               :original (and encoded-p (decode-case-value original))
                               :original-available (not (null encoded-p)))))))))

(defun apply-property-expectation (expect report)
  (let ((status (report-status report))
        (data (report-data report)))
    (cond
      ((or (eq expect :passed) (eq status :error)) report)
      ((eq status expect)
       (zk-test::make-report :passed
         (list :name (getf data :name)
               :seed (getf data :seed)
               :counts (getf data :counts)
               :coverage (getf data :coverage)
               :expected-outcome expect
               :observed-status status
               :reduced (getf data :reduced)
               :failure (getf data :failure))))
      (t
       (zk-test::make-report :falsified
         (list :name (getf data :name)
               :seed (getf data :seed)
               :counts (getf data :counts)
               :coverage (getf data :coverage)
               :failure (list :unexpected-outcome status :expected expect)
               :reason (getf data :reason)))))))

(defun execute-property (property function
                         &key (seed (fresh-seed))
                              (trials nil trials-supplied-p)
                              (max-size nil max-size-supplied-p)
                              (max-discards nil discards-supplied-p)
                              (max-discard-ratio nil ratio-supplied-p)
                              (max-shrinks nil max-shrinks-supplied-p)
                              (max-enumerated nil max-enumerated-supplied-p)
                              (timeout-ms nil timeout-supplied-p)
                              (auto-save nil auto-save-supplied-p)
                              (max-coverage-trials nil max-cov-supplied-p)
                              (corpus nil corpus-supplied-p))
  (let* ((defaults (property-defaults property))
         (trials (if trials-supplied-p trials (getf defaults :trials 100)))
         (max-size (if max-size-supplied-p max-size (getf defaults :max-size 100)))
         (max-discards (if discards-supplied-p max-discards (getf defaults :max-discards 1000)))
         (max-discard-ratio (if ratio-supplied-p
                                max-discard-ratio
                                (if (eq (getf defaults :max-discard-ratio :absent) :absent)
                                    10
                                    (getf defaults :max-discard-ratio))))
         (max-shrinks (if max-shrinks-supplied-p max-shrinks (getf defaults :max-shrinks 1000)))
         (max-enumerated (if max-enumerated-supplied-p max-enumerated (getf defaults :max-enumerated 10000)))
         (timeout-ms (if timeout-supplied-p timeout-ms (getf defaults :timeout-ms nil)))
         (auto-save (if auto-save-supplied-p auto-save (getf defaults :auto-save nil)))
         (max-coverage-trials (if max-cov-supplied-p
                                  max-coverage-trials
                                  (getf defaults :max-coverage-trials (* 10 (max 1 trials)))))
         (effective-corpus (if corpus-supplied-p corpus *default-corpus*))
         (has-discards (or discards-supplied-p (not (eq (getf defaults :max-discards :absent) :absent))))
         (has-ratio (or ratio-supplied-p (not (eq (getf defaults :max-discard-ratio :absent) :absent)))))
    (check-type seed (unsigned-byte 64))
    (dolist (b (list trials max-size max-discards max-shrinks max-enumerated max-coverage-trials))
      (check-type b unsigned-byte))
    (when max-discard-ratio (check-type max-discard-ratio unsigned-byte))
    (when timeout-ms (check-type timeout-ms (integer 0 *)))
    (let* ((*condition-key-function* (property-condition-key property))
           (name (property-name property)) (arity (property-arity property))
           (expect (property-expect property))
           (deadline (when timeout-ms
                       (+ (get-internal-real-time)
                          (round (* timeout-ms internal-time-units-per-second) 1000))))
           (discard-limit (cond (discards-supplied-p max-discards)
                                (ratio-supplied-p
                                 (if max-discard-ratio
                                     (* max-discard-ratio (max 1 trials))
                                     max-discards))
                                ((and has-discards has-ratio)
                                 (if max-discard-ratio
                                     (max max-discards (* max-discard-ratio (max 1 trials)))
                                     max-discards))
                                (has-discards max-discards)
                                (has-ratio
                                 (if max-discard-ratio
                                     (* max-discard-ratio (max 1 trials))
                                     max-discards))
                                (t (max max-discards (* max-discard-ratio (max 1 trials))))))
           (counts (list :examples 0 :regression 0 :enumerated 0 :random 0 :discarded 0))
           (labels (make-hash-table :test 'equal))
           (max-targets (make-hash-table :test 'equal))
           (best-target-score nil)
           (best-target-path nil)
           (next-trial-index 0)
           (stop-reason nil)
           (coverage-status nil))
      (labels
          ((observe (arguments) (observe-property function arguments arity))
           (targets-alist ()
             (loop for k being the hash-keys of max-targets using (hash-value v)
                   collect (cons k v)))
           (record-targets (observed-targets path)
             (when observed-targets
               (let ((sum 0))
                 (dolist (entry observed-targets)
                   (incf sum (cdr entry))
                   (multiple-value-bind (cur present) (gethash (car entry) max-targets)
                     (when (or (not present) (> (cdr entry) cur))
                       (setf (gethash (car entry) max-targets) (cdr entry)))))
                 (when (and path (or (null best-target-score) (> sum best-target-score)))
                   (setq best-target-score sum
                         best-target-path path)))))
           (make-property-report (status &rest data)
             (let ((targets (targets-alist)))
               (zk-test::make-report status
                 (append (list :name name :seed seed :counts counts :coverage
                               (loop for k being the hash-keys of labels using (hash-value v) collect (cons k v)))
                         (when targets (list :targets targets))
                         (when stop-reason (list :stop-reason stop-reason))
                         (when coverage-status (list :coverage-status coverage-status))
                         data))))
           (finalize-report (report)
             (let ((final (apply-property-expectation expect report)))
               (unless (eq (report-status final) :passed)
                 (setq *last-failure* final))
               (when (and auto-save effective-corpus
                          (eq (report-status final) :falsified)
                          (getf (report-data final) :persistable))
                 (let ((saved-path (save-regression final effective-corpus)))
                   (setq final (zk-test::make-report (report-status final)
                                 (append (report-data final) (list :saved-regression saved-path))))
                   (setq *last-failure* final)))
               final))
           (finish (status &rest data)
             (return-from execute-property
               (finalize-report (apply #'make-property-report status data))))
           (attempt (source arguments &optional gen path stream size index)
             (let ((ordinal (or index (getf counts source))))
               (multiple-value-bind (failure observed details notes observed-targets)
                   (observe (clone-arguments arguments))
                 (declare (ignore notes))
                 (incf (getf counts source))
                 (when (eq source :random)
                   (dolist (label observed) (incf (gethash label labels 0)))
                   (record-targets observed-targets path))
                 (when failure
                   (multiple-value-bind (encoded ok) (try-encode-case-value arguments)
                     (multiple-value-bind (status data)
                         (analyze-failure property #'observe source gen path stream size ordinal
                                          encoded ok failure details max-shrinks deadline)
                       (apply #'finish status :source source :size size :index ordinal data)))))))
           (run-one-random-trial (gen max-sz total-hint)
             (when (and deadline (>= (get-internal-real-time) deadline))
               (return-from run-one-random-trial :timeout))
             (let* ((i next-trial-index)
                    (random-stream-seed (trial-seed seed name i))
                    (denom (max 1 (1- total-hint)))
                    (size (if (<= total-hint 1) max-sz
                              (floor (* max-sz (min i (1- total-hint))) denom)))
                    (use-hill-climb (and best-target-path (oddp i))))
               (incf next-trial-index)
               (handler-case
                   (let ((*swarm-seed* random-stream-seed))
                     (if use-hill-climb
                         (let ((cand-path (mutate-trace-path best-target-path random-stream-seed)))
                           (multiple-value-bind (arguments actual-path)
                               (generate-inputs gen random-stream-seed size cand-path)
                             (attempt :random arguments gen actual-path random-stream-seed size i)))
                         (multiple-value-bind (arguments initial-choice-trace)
                             (generate-inputs gen random-stream-seed size)
                           (attempt :random arguments gen initial-choice-trace random-stream-seed size i))))
                 (rejected-draw ()
                   (incf (getf counts :discarded))
                   (when (>= (getf counts :discarded) discard-limit)
                     (finish :insufficient :reason :discard-budget))))
               :ok)))
        (finalize-report
         (handler-case
             (multiple-value-bind (random-generator finite-enumerator examples goals) (funcall (property-options property))
               (when goals
                 (setq coverage-status (if (and random-generator (plusp trials)) :checked :not-run)))
               (dolist (arguments examples)
                 (handler-case (attempt :examples arguments)
                   (assumption-rejected () (error "Example ~S violated ZK-PBT:ASSUME" arguments))))
               (when effective-corpus
                 (dolist (file (sort (directory (case-file-path effective-corpus :wild "zkcase")) #'string< :key #'namestring))
                   (let ((regression-case (read-regression-case file)))
                     (when (equal (encode-case-value name) (first regression-case))
                       (handler-case (attempt :regression (decode-case-value (fourth regression-case)))
                         (assumption-rejected () (error "Regression case in ~A violated ZK-PBT:ASSUME" file)))))))
               (when finite-enumerator
                 (enumerate-inputs finite-enumerator
                   (lambda (arguments)
                     (when (>= (getf counts :enumerated) max-enumerated)
                       (finish :insufficient :reason :enumeration-budget))
                     (when (and deadline (>= (get-internal-real-time) deadline))
                       (finish :insufficient :reason :timeout))
                     (handler-case (attempt :enumerated arguments)
                       (assumption-rejected ()
                         (incf (getf counts :discarded)))))))
               (when random-generator
                 (loop while (< (getf counts :random) trials) do
                   (when (eq :timeout (run-one-random-trial random-generator max-size trials))
                     (setq stop-reason :timeout)
                     (when (zerop (getf counts :random))
                       (finish :insufficient :reason :timeout))
                     (return))))
               (when (and random-generator (plusp (getf counts :random)))
                 (loop for goal in goals do
                   (let ((label (first goal))
                         (target-p (second goal))
                         (conf (third goal)))
                     (if (or (null conf) (eq stop-reason :timeout))
                         (let* ((random-count (getf counts :random))
                                (observed (gethash label labels 0))
                                (required (ceiling (* target-p random-count))))
                           (when (< observed (* target-p random-count))
                             (finish :insufficient :reason :coverage
                                     :goal (cons label target-p)
                                     :observed-count observed :required-count required)))
                         (block cov-check
                           (loop
                             (let* ((random-count (getf counts :random))
                                    (observed (gethash label labels 0))
                                    (required (ceiling (* target-p random-count))))
                               (multiple-value-bind (lower upper)
                                   (wilson-interval observed random-count conf)
                                 (cond
                                   ((>= lower target-p) (return-from cov-check))
                                   ((< upper target-p)
                                    (finish :insufficient :reason :coverage
                                            :goal (cons label target-p)
                                            :observed-count observed :required-count required))
                                   ((>= random-count max-coverage-trials)
                                    (when (< observed (* target-p random-count))
                                      (finish :insufficient :reason :coverage
                                              :goal (cons label target-p)
                                              :observed-count observed :required-count required))
                                    (return-from cov-check))
                                   (t
                                    (let ((batch-end (min max-coverage-trials (+ random-count 50))))
                                      (loop while (< (getf counts :random) batch-end) do
                                        (when (eq :timeout (run-one-random-trial random-generator max-size max-coverage-trials))
                                          (setq stop-reason :timeout)
                                          (let* ((cur-n (getf counts :random))
                                                 (cur-obs (gethash label labels 0))
                                                 (cur-req (ceiling (* target-p cur-n))))
                                            (when (< cur-obs (* target-p cur-n))
                                              (finish :insufficient :reason :coverage
                                                      :goal (cons label target-p)
                                                      :observed-count cur-obs :required-count cur-req)))
                                          (return-from cov-check))))))))))))))
               (if (every #'zerop (mapcar (lambda (k) (getf counts k)) '(:examples :regression :enumerated :random)))
                   (make-property-report :insufficient :reason :no-cases)
                   (make-property-report :passed)))
           (machine-callback-error (c) (make-property-report :error :condition c :prior (preceding-failure c)))
           (error (c) (make-property-report :error :condition c))))))))

(defun forall (generator predicate &key (seed (fresh-seed)) (trials 100) (max-size 100)
                                    (max-discards 1000 discards-supplied-p) (max-discard-ratio 10)
                                    (max-shrinks 1000) (timeout-ms nil) (auto-save nil) (corpus nil corpus-supplied-p)
                                    (check t) (name 'forall) context failure-key (expect :passed))
  (let* ((wrapped-gen (tuple generator))
         (prop (make-property name 1 (lambda () (values wrapped-gen nil nil nil))
                              failure-key context expect))
         (extra (append (when discards-supplied-p (list :max-discards max-discards))
                        (when timeout-ms (list :timeout-ms timeout-ms))
                        (when auto-save (list :auto-save auto-save))
                        (when corpus-supplied-p (list :corpus corpus))))
         (raw-report (apply #'execute-property prop predicate
                            :seed seed :trials trials :max-size max-size
                            :max-discard-ratio max-discard-ratio
                            :max-shrinks max-shrinks
                            extra))
         (report (zk-test::make-report (report-status raw-report)
                   (append (report-data raw-report) (list :forall-property (cons prop predicate))))))
    (unless (eq (report-status report) :passed)
      (setq *last-failure* report))
    (if check
        (if (eq (report-status report) :passed)
            (values t report)
            (error 'check-failed :report report))
        report)))

(defun recheck-last (&key (case :reduced))
  (unless *last-failure*
    (error "No previous failed property report in *LAST-FAILURE*"))
  (replay *last-failure* :case case))

(defun run-with-bytes (name bytes &key (size nil size-p) (max-shrinks nil max-shrinks-p)
                                  (timeout-ms nil timeout-p) check)
  (let ((property (zk-test::entry-info name :property)))
    (unless property (error "Unknown property ~S" name))
    (multiple-value-bind (random-generator finite-enumerator examples goals)
        (funcall (property-options property))
      (declare (ignore finite-enumerator examples goals))
      (unless random-generator
        (error "Property ~S has no random generator" name))
      (let* ((defaults (property-defaults property))
             (effective-size (if size-p size (getf defaults :max-size 20)))
             (effective-shrinks (if max-shrinks-p max-shrinks (getf defaults :max-shrinks 1000)))
             (effective-timeout (if timeout-p timeout-ms (getf defaults :timeout-ms nil)))
             (deadline (when effective-timeout
                         (+ (get-internal-real-time)
                            (ceiling (* effective-timeout internal-time-units-per-second) 1000))))
             (expect (property-expect property))
             (*condition-key-function* (property-condition-key property))
             (arity (property-arity property))
             (function (symbol-function name))
             (bytes-consumed 0)
             (args nil)
             (path nil)
             (rejected nil))
        (flet ((observe (arguments)
                 (observe-property function arguments arity))
               (finalize (raw)
                 (let ((report (apply-property-expectation expect raw)))
                   (unless (eq (report-status report) :passed)
                     (setq *last-failure* report))
                   (if check
                       (if (eq (report-status report) :passed)
                           (values t report)
                           (error 'check-failed :report report))
                       report))))
          (handler-case
              (multiple-value-setq (args path bytes-consumed)
                (generate-from-bytes random-generator bytes :size effective-size))
            (rejected-draw ()
              (setq rejected t)))
          (when rejected
            (return-from run-with-bytes
              (finalize (zk-test::make-report :insufficient
                          (list :name name :counts '(:bytes 0 :discarded 1)
                                :reason :rejected-draw :bytes-consumed bytes-consumed)))))
          (handler-case
              (multiple-value-bind (failure observed details notes observed-targets)
                  (observe (clone-arguments args))
                (declare (ignore notes observed-targets))
                (let ((coverage (mapcar (lambda (l) (cons l 1)) observed)))
                  (if failure
                      (multiple-value-bind (encoded ok) (try-encode-case-value args)
                        (multiple-value-bind (status data)
                            (analyze-failure property #'observe :bytes random-generator path 0
                                             effective-size 0 encoded ok failure details
                                             effective-shrinks deadline)
                          (finalize (zk-test::make-report status
                                      (append (list :name name :counts '(:bytes 1 :discarded 0)
                                                    :bytes-consumed bytes-consumed
                                                    :coverage coverage :source :bytes :size effective-size)
                                              data)))))
                      (finalize (zk-test::make-report :passed
                                  (list :name name :counts '(:bytes 1 :discarded 0)
                                        :bytes-consumed bytes-consumed
                                        :coverage coverage))))))
            (assumption-rejected ()
              (finalize (zk-test::make-report :insufficient
                          (list :name name :counts '(:bytes 0 :discarded 1)
                                :reason :assumption-rejected :bytes-consumed bytes-consumed))))
            (machine-callback-error (c)
              (finalize (zk-test::make-report :error
                          (list :name name :counts '(:bytes 0 :discarded 0)
                                :bytes-consumed bytes-consumed
                                :condition c :prior (preceding-failure c)))))
            (error (c)
              (finalize (zk-test::make-report :error
                          (list :name name :counts '(:bytes 0 :discarded 0)
                                :bytes-consumed bytes-consumed :condition c))))))))))

(defun mutate-fuzz-bytes (vec pool state-cell max-len)
  (labels ((next-u64 ()
             (multiple-value-bind (w next) (splitmix-word (car state-cell))
               (setf (car state-cell) next)
               w))
           (next-below (n)
             (mod (next-u64) n)))
    (let* ((len (length vec))
           (interesting #(0 1 2 15 16 127 128 254 255))
           (op (if (zerop len) 3 (next-below 6))))
      (case op
        (0
         (let ((copy (copy-seq vec))
               (idx (next-below len))
               (bit (next-below 8)))
           (setf (aref copy idx) (logxor (aref copy idx) (ash 1 bit)))
           copy))
        (1
         (let ((copy (copy-seq vec))
               (idx (next-below len))
               (delta (1+ (next-below 15))))
           (setf (aref copy idx)
                 (logand #xff (if (zerop (next-below 2))
                                  (+ (aref copy idx) delta)
                                  (- (aref copy idx) delta))))
           copy))
        (2
         (let ((copy (copy-seq vec))
               (idx (next-below len)))
           (setf (aref copy idx) (svref interesting (next-below (length interesting))))
           copy))
        (3
         (if (< len max-len)
             (let* ((pos (next-below (1+ len)))
                    (out (make-array (1+ len) :initial-element 0))
                    (b (next-below 256)))
               (dotimes (i pos) (setf (aref out i) (aref vec i)))
               (setf (aref out pos) b)
               (loop for i from pos below len do
                 (setf (aref out (1+ i)) (aref vec i)))
               out)
             (let ((copy (copy-seq vec)))
               (setf (aref copy (next-below len)) (next-below 256))
               copy)))
        (4
         (if (> len 1)
             (let* ((pos (next-below len))
                    (out (make-array (1- len) :initial-element 0)))
               (dotimes (i pos) (setf (aref out i) (aref vec i)))
               (loop for i from (1+ pos) below len do
                 (setf (aref out (1- i)) (aref vec i)))
               out)
             #()))
        (otherwise
         (let* ((other (aref pool (next-below (length pool))))
                (olen (length other))
                (p1 (next-below (1+ len)))
                (p2 (next-below (1+ olen)))
                (out-len (min max-len (+ p1 (- olen p2)))))
           (let ((out (make-array out-len :initial-element 0)))
             (dotimes (i (min p1 out-len)) (setf (aref out i) (aref vec i)))
             (loop for k from p1 below out-len
                   for src-i = (+ p2 (- k p1)) do
                     (setf (aref out k) (aref other src-i)))
             out)))))))

(defun fuzz-property (name &key (iterations 200) (seed (fresh-seed)) (size nil size-p)
                                (max-len 64) (max-shrinks nil max-shrinks-p)
                                initial-corpus (timeout-ms nil timeout-p) check)
  (check-type iterations (integer 1 *))
  (check-type max-len (integer 1 *))
  (let ((property (zk-test::entry-info name :property)))
    (unless property (error "Unknown property ~S" name))
    (multiple-value-bind (random-generator finite-enumerator examples goals)
        (funcall (property-options property))
      (declare (ignore finite-enumerator examples goals))
      (unless random-generator
        (error "Property ~S has no random generator" name))
      (let* ((defaults (property-defaults property))
             (effective-size (if size-p size (getf defaults :max-size 20)))
             (effective-shrinks (if max-shrinks-p max-shrinks (getf defaults :max-shrinks 1000)))
             (effective-timeout (if timeout-p timeout-ms (getf defaults :timeout-ms nil)))
             (deadline (when effective-timeout
                         (+ (get-internal-real-time)
                            (ceiling (* effective-timeout internal-time-units-per-second) 1000))))
             (expect (property-expect property))
             (*condition-key-function* (property-condition-key property))
             (arity (property-arity property))
             (function (symbol-function name))
             (state-cell (list (u64 seed)))
             (pool (make-array 0 :adjustable t :fill-pointer 0))
             (seen-labels (make-hash-table :test 'equal))
             (label-counts (make-hash-table :test 'equal))
             (best-targets (make-hash-table :test 'equal))
             (ran 0)
             (discarded 0)
             (stop-reason nil))
        (vector-push-extend #() pool)
        (dolist (entry initial-corpus)
          (vector-push-extend (normalize-choice-bytes entry) pool))
        (dotimes (k 4)
          (let* ((wlen (+ 4 (* 4 (1+ k))))
                 (buf (make-array wlen :initial-element 0)))
            (dotimes (j wlen)
              (multiple-value-bind (w next) (splitmix-word (car state-cell))
                (setf (car state-cell) next
                      (aref buf j) (logand #xff w))))
            (vector-push-extend buf pool)))
        (labels ((observe (arguments)
                   (observe-property function arguments arity))
                 (coverage-alist ()
                   (loop for k being the hash-keys of label-counts using (hash-value v)
                         collect (cons k v)))
                 (targets-alist ()
                   (loop for k being the hash-keys of best-targets using (hash-value v)
                         collect (cons k v)))
                 (finalize (raw)
                   (let ((report (apply-property-expectation expect raw)))
                     (unless (eq (report-status report) :passed)
                       (setq *last-failure* report))
                     (if check
                         (if (eq (report-status report) :passed)
                             (values t report)
                             (error 'check-failed :report report))
                         report))))
          (loop for iter from 0 below iterations do
            (when (and deadline (>= (get-internal-real-time) deadline))
              (setq stop-reason :timeout)
              (return))
            (let* ((base (if (< iter (length pool))
                             (aref pool iter)
                             (let* ((idx (multiple-value-bind (w next) (splitmix-word (car state-cell))
                                           (setf (car state-cell) next)
                                           (mod w (length pool)))))
                               (mutate-fuzz-bytes (aref pool idx) pool state-cell max-len))))
                   (candidate (if (> (length base) max-len)
                                  (subseq base 0 max-len)
                                  base))
                   (args nil)
                   (path nil)
                   (trial-rejected nil))
              (handler-case
                  (multiple-value-setq (args path)
                    (generate-from-bytes random-generator candidate :size effective-size))
                (rejected-draw ()
                  (incf discarded)
                  (setq trial-rejected t)))
              (unless trial-rejected
                (handler-case
                    (multiple-value-bind (failure observed details notes observed-targets)
                        (observe (clone-arguments args))
                      (declare (ignore notes))
                      (incf ran)
                      (let ((interesting nil))
                        (dolist (lbl observed)
                          (incf (gethash lbl label-counts 0))
                          (unless (gethash lbl seen-labels)
                            (setf (gethash lbl seen-labels) t
                                  interesting t)))
                        (dolist (entry observed-targets)
                          (multiple-value-bind (cur present) (gethash (car entry) best-targets)
                            (when (or (not present) (> (cdr entry) cur))
                              (setf (gethash (car entry) best-targets) (cdr entry)
                                    interesting t))))
                        (when (and interesting (< (length pool) 256))
                          (vector-push-extend (copy-seq candidate) pool)))
                      (when failure
                        (multiple-value-bind (encoded ok) (try-encode-case-value args)
                          (multiple-value-bind (status data)
                              (analyze-failure property #'observe :fuzz random-generator path 0
                                               effective-size iter encoded ok failure details
                                               effective-shrinks deadline)
                            (return-from fuzz-property
                              (finalize
                               (zk-test::make-report status
                                 (append (list :name name :seed seed
                                               :counts (list :fuzz ran :discarded discarded)
                                               :corpus-size (length pool)
                                               :fuzz-bytes candidate
                                               :coverage (coverage-alist)
                                               :targets (targets-alist)
                                               :source :fuzz :index iter :size effective-size)
                                         data))))))))
                  (assumption-rejected ()
                    (incf discarded))
                  (machine-callback-error (c)
                    (return-from fuzz-property
                      (finalize
                       (zk-test::make-report :error
                         (list :name name :seed seed
                               :counts (list :fuzz ran :discarded discarded)
                               :fuzz-bytes candidate :condition c :prior (preceding-failure c))))))
                  (error (c)
                    (return-from fuzz-property
                      (finalize
                       (zk-test::make-report :error
                         (list :name name :seed seed
                               :counts (list :fuzz ran :discarded discarded)
                               :fuzz-bytes candidate :condition c)))))))))
          (if (zerop ran)
              (finalize (zk-test::make-report :insufficient
                          (list :name name :seed seed
                                :counts (list :fuzz 0 :discarded discarded)
                                :reason (or stop-reason :no-cases)
                                :corpus-size (length pool))))
              (finalize (zk-test::make-report :passed
                          (append (list :name name :seed seed
                                        :counts (list :fuzz ran :discarded discarded)
                                        :corpus-size (length pool)
                                        :coverage (coverage-alist))
                                  (when (targets-alist) (list :targets (targets-alist)))
                                  (when stop-reason (list :stop-reason stop-reason)))))))))))

(defun inspect-distribution (g &key (count 200) (seed (fresh-seed)) (size 20)
                                 (classifier #'identity) (limit 15) (stream *standard-output*))
  (check-type g input-generator)
  (check-type count unsigned-byte)
  (let ((samples (sample g :count count :seed seed :size size))
        (table (make-hash-table :test 'equal))
        (total 0))
    (dolist (s samples)
      (incf total)
      (incf (gethash (funcall classifier s) table 0)))
    (let ((sorted (sort (loop for k being the hash-keys of table using (hash-value v)
                              collect (cons k v))
                        (lambda (a b)
                          (if (= (cdr a) (cdr b))
                              (string< (princ-to-string (car a)) (princ-to-string (car b)))
                              (> (cdr a) (cdr b)))))))
      (when stream
        (format stream "~&Distribution (~D sample~:P):~%" total)
        (loop for entry in sorted for i from 0 while (or (null limit) (< i limit)) do
          (let ((pct (if (plusp total) (round (* 100 (cdr entry)) total) 0)))
            (format stream "  ~5D  ~3D%  ~S~%" (cdr entry) pct (car entry)))))
      sorted)))

(defun run-schedule (workers schedule)
  "Step cooperative worker thunks along SCHEDULE (indices), then drain remaining work."
  (let* ((count (length workers))
         (state (coerce workers 'simple-vector))
         (active (make-array count :initial-element t)))
    (flet ((step-worker (idx)
             (when (aref active idx)
               (unless (funcall (svref state idx))
                 (setf (aref active idx) nil)))))
      (when (plusp count)
        (dolist (choice schedule)
          (step-worker (mod (abs choice) count)))
        (loop while (some #'identity active) do
          (dotimes (i count)
            (step-worker i)))))
    t))

(defun contains-generated-function-p (root)
  (let ((seen nil))
    (labels ((scan (x)
               (cond
                 ((null x) nil)
                 ((and (functionp x) (describe-generated-function x)) t)
                 ((or (numberp x) (characterp x) (symbolp x) (stringp x)) nil)
                 ((or (consp x) (arrayp x) (hash-table-p x))
                  (unless seen (setq seen (make-hash-table :test 'eq)))
                  (when (gethash x seen) (return-from scan nil))
                  (setf (gethash x seen) t)
                  (cond
                    ((consp x) (or (scan (car x)) (scan (cdr x))))
                    ((arrayp x)
                     (dotimes (i (array-total-size x) nil)
                       (when (scan (row-major-aref x i)) (return t))))
                    ((hash-table-p x)
                     (maphash (lambda (k v)
                                (when (or (scan k) (scan v))
                                  (return-from scan t)))
                              x)
                     nil))))))
      (scan root))))

(defun prepare-value-for-display (value)
  (unless (contains-generated-function-p value)
    (return-from prepare-value-for-display value))
  (let ((seen (make-hash-table :test 'eq)))
    (labels ((transform (x)
               (cond
                 ((null x) nil)
                 ((and (functionp x) (describe-generated-function x))
                  (describe-generated-function x))
                 ((or (numberp x) (characterp x) (symbolp x) (stringp x)) x)
                 ((or (consp x) (arrayp x) (hash-table-p x))
                  (multiple-value-bind (cached found) (gethash x seen)
                    (when found (return-from transform cached)))
                  (cond
                    ((consp x)
                     (let ((cell (cons nil nil)))
                       (setf (gethash x seen) cell
                             (car cell) (transform (car x))
                             (cdr cell) (transform (cdr x)))
                       cell))
                    ((arrayp x)
                     (let ((copy (make-array (array-dimensions x))))
                       (setf (gethash x seen) copy)
                       (dotimes (i (array-total-size x) copy)
                         (setf (row-major-aref copy i)
                               (transform (row-major-aref x i))))))
                    ((hash-table-p x)
                     (let ((copy (make-hash-table :test (hash-table-test x))))
                       (setf (gethash x seen) copy)
                       (maphash (lambda (k v)
                                  (setf (gethash (transform k) copy) (transform v)))
                                x)
                       copy))))
                 (t x))))
      (transform value))))

(setf zk-test::*value-formatter* #'prepare-value-for-display)

(defun replay (report-or-case-path &key (case :reduced))
  (handler-case
      (let* ((source (if (typep report-or-case-path 'check-failed)
                         (failure-report report-or-case-path)
                         report-or-case-path))
             (reportp (typep source 'zk-test:report))
             (data (and reportp (report-data source)))
             (regression-case (if reportp (getf data :regression-case) (read-regression-case source)))
             (name (if regression-case (decode-case-value (first regression-case)) (getf data :name)))
             (forall-entry (and reportp (getf data :forall-property)))
             (property (or (zk-test::entry-info name :property)
                           (car forall-entry)
                           (error "Missing property ~S" name)))
             (expected (if regression-case (decode-case-value (second regression-case)) (getf data :failure)))
             (*condition-key-function* (property-condition-key property))
             (function (if (zk-test::entry-info name :property)
                           (symbol-function name)
                           (or (cdr forall-entry) (symbol-function name)))))
        (flet ((observe ()
                 (let ((args (cond (regression-case
                                    (decode-case-value (ecase case (:original (third regression-case)) (:reduced (fourth regression-case)))))
                                   ((getf data :rebuild)
                                    (funcall (getf data :rebuild) case))
                                   ((and (eq case :original) (getf data :original-available))
                                    (getf data :original))
                                   (t (error "Report has no counterexample")))))
                   (observe-property function args (property-arity property)))))
          (let* ((first (observe)) (again (observe)))
            (values (cond ((not (equal first again)) :unstable)
                          ((null first) :fixed) ((equal first expected) :reproduced) (t :changed))
                    first))))
    (error (c) (values :error c))))

(defun replay-corpus (directory &key property)
  (let* ((files (sort (directory (case-file-path directory :wild "zkcase")) #'string< :key #'namestring))
         (total 0)
         (repro 0)
         (fixed 0)
         (changed 0)
         (unstable 0)
         (errs 0)
         (results nil))
    (dolist (file files)
      (let* ((rc (read-regression-case file))
             (prop-name (decode-case-value (first rc))))
        (when (or (null property) (eq property prop-name))
          (incf total)
          (multiple-value-bind (status detail) (replay file)
            (case status
              (:reproduced (incf repro))
              (:fixed (incf fixed))
              (:changed (incf changed))
              (:unstable (incf unstable))
              (otherwise (incf errs)))
            (push (list (namestring file) status prop-name detail) results)))))
    (list :total total :reproduced repro :fixed fixed :changed changed
          :unstable unstable :error errs :results (nreverse results))))

(defun prune-corpus (directory &key property dry-run)
  (let* ((files (sort (directory (case-file-path directory :wild "zkcase")) #'string< :key #'namestring))
         (best-by-key (make-hash-table :test 'equal))
         (removed-fixed 0)
         (removed-dup 0)
         (kept 0)
         (removed-paths nil))
    (dolist (file files)
      (let* ((rc (read-regression-case file))
             (prop-name (decode-case-value (first rc))))
        (when (or (null property) (eq property prop-name))
          (multiple-value-bind (status detail) (replay file)
            (declare (ignore detail))
            (cond
              ((eq status :fixed)
               (incf removed-fixed)
               (push file removed-paths))
              ((eq status :reproduced)
               (let* ((fail-key (decode-case-value (second rc)))
                      (key (list prop-name fail-key))
                      (sz (length (with-output-to-string (s) (write-case-datum (fourth rc) s))))
                      (prev (gethash key best-by-key)))
                 (if (null prev)
                     (setf (gethash key best-by-key) (cons sz file))
                     (if (< sz (car prev))
                         (progn
                           (incf removed-dup)
                           (push (cdr prev) removed-paths)
                           (setf (gethash key best-by-key) (cons sz file)))
                         (progn
                           (incf removed-dup)
                           (push file removed-paths))))))
              (t (incf kept)))))))
    (incf kept (hash-table-count best-by-key))
    (unless dry-run
      (dolist (p removed-paths)
        (when (probe-file p)
          (delete-file p))))
    (list :kept kept :removed-fixed removed-fixed :removed-duplicate removed-dup
          :removed-paths (mapcar #'namestring (nreverse removed-paths)))))
