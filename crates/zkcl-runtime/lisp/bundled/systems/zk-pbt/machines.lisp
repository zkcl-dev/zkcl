(in-package #:zk-pbt)

(defstruct command
  name arity enabled weight argument-generator precondition model-transition system-action
  postcondition equivalent-results-p has-compare-p produces)
(defstruct machine initial-model open-system close-system invariant commands)
(defvar *machine-registry* (make-hash-table :test 'eq))
(defvar *machine-bundles* nil)
(defvar *machine-ref-counter* 0)
(defvar *machine-ref-env* nil)

(defun record-bundle-ref (bundle-name ref)
  (let ((entry (assoc bundle-name *machine-bundles* :test #'eq)))
    (if entry
        (setf (cdr entry) (nconc (cdr entry) (list ref)))
        (push (cons bundle-name (list ref)) *machine-bundles*)))
  ref)

(defun bundle-elements (bundle-name)
  (make-input-generator
   (lambda ()
     (let* ((refs (cdr (assoc bundle-name *machine-bundles* :test #'eq)))
            (len (length refs)))
       (when (zerop len) (reject))
       (nth (choice len) refs)))))

(defun deref (ref)
  (unless *machine-ref-env*
    (error "ZK-PBT:DEREF called outside RUN-COMMANDS / RUN-PARALLEL-COMMANDS"))
  (multiple-value-bind (obj found) (gethash ref *machine-ref-env*)
    (unless found
      (error "Unknown or out-of-scope machine bundle reference ~S" ref))
    obj))

(defun find-machine-clause (key options required)
  (let ((found (assoc key options)))
    (when (and required (not found)) (error "Missing machine clause ~S" key))
    (when (> (count key options :key #'car) 1) (error "Repeated machine clause ~S" key))
    found))

(defun machine-clause-function (key options required extra default)
  (let ((spec (find-machine-clause key options required)))
    (if spec
        (progn
          (unless (listp (second spec))
            (error "Expected parameter list in machine clause ~S" spec))
          (let ((params (append (second spec) extra)))
            `(lambda ,params
               (declare (ignorable ,@params))
               ,@(cddr spec))))
        default)))

(defun machine-weight-function (options)
  (let ((spec (find-machine-clause :weight options nil)))
    (cond
      ((null spec) '(constantly 1))
      ((null (cddr spec))
       (let ((w (gensym "WEIGHT")))
         `(let ((,w ,(second spec)))
            (lambda (m) (declare (ignore m)) ,w))))
      (t (machine-clause-function :weight options nil nil '(constantly 1))))))

(defun machine-post-function (options params)
  (let ((spec (find-machine-clause :post options nil)))
    (when spec
      (unless (and (listp (second spec)) (= (length (second spec)) 3))
        (error "Expected 3-element parameter list (MODEL-BEFORE MODEL-AFTER ACTUAL) in :post clause ~S" spec))
      (machine-clause-function :post options nil params nil))))

(defun machine-compare-function (options)
  (let ((spec (find-machine-clause :compare options nil)))
    (cond
      ((null spec) '#'equal)
      ((null (cddr spec))
       (let ((fn (gensym "COMPARE")))
         `(let ((,fn ,(second spec)))
            (lambda (expected actual) (funcall ,fn expected actual)))))
      (t (machine-clause-function :compare options nil nil '#'equal)))))

(defmacro defmachine (name &body clauses)
  (unless (symbolp name)
    (error "Machine name must be a symbol: ~S" name))
  (let ((commands nil) (names nil))
    (dolist (form clauses)
      (case (car form)
        (:command
         (destructuring-bind (key params &rest opts) (cdr form)
           (when (member key names) (error "Duplicate command ~S" key))
           (push key names)
           (dolist (opt opts)
             (unless (member (car opt) '(:args :enabled :weight :pre :step :act :post :compare :produces))
               (error "Unknown command option ~S" (car opt))))
           (let ((args-fn (if (null params)
                              (machine-clause-function :args opts nil nil '(lambda (m) (declare (ignore m)) (tuple)))
                              (machine-clause-function :args opts t nil nil)))
                 (has-compare (not (null (find-machine-clause :compare opts nil))))
                 (produces-spec (find-machine-clause :produces opts nil)))
             (when produces-spec
               (unless (and (= (length produces-spec) 2) (symbolp (second produces-spec)))
                 (error "Expected (:produces BUNDLE-NAME) in ~S" produces-spec)))
             (push `(make-command :name ',key :arity ,(length params)
                                  :enabled ,(machine-clause-function :enabled opts nil nil '(constantly t))
                                  :weight ,(machine-weight-function opts)
                                  :argument-generator ,args-fn
                                  :precondition ,(machine-clause-function :pre opts nil params '(constantly t))
                                  :model-transition ,(machine-clause-function :step opts t params nil)
                                  :system-action ,(machine-clause-function :act opts t params nil)
                                  :postcondition ,(machine-post-function opts params)
                                  :equivalent-results-p ,(machine-compare-function opts)
                                  :has-compare-p ,has-compare
                                  :produces ',(and produces-spec (second produces-spec)))
                   commands))))
        ((:model :open :close :invariant))
        (otherwise (error "Unknown machine clause ~S" (car form)))))
    `(progn
       (setf (gethash ',name *machine-registry*)
             (make-machine :initial-model ,(machine-clause-function :model clauses t nil nil)
                           :open-system ,(machine-clause-function :open clauses t nil nil)
                           :close-system ,(machine-clause-function :close clauses nil nil
                                                                  '(lambda (sut) (declare (ignore sut)) nil))
                           :invariant ,(machine-clause-function :invariant clauses nil nil '(constantly t))
                           :commands (list ,@(nreverse commands))))
       ',name)))

(defun find-machine (name) (or (gethash name *machine-registry*) (error "Unknown machine ~S" name)))
(defun generate-command-sequence (machine model min max old-seq)
  (let* ((all-cmds (coerce (machine-commands machine) 'simple-vector))
         (cmd-count (length all-cmds))
         (children (and (consp old-seq) (eq (car old-seq) :sequence) (cdr old-seq)))
         (upper (or max (+ min *sample-size*)))
         (target (if *replaying-choices*
                     (max min (min upper (length children)))
                     (+ min (random-below (1+ (- upper min))))))
         (step-gen
           (make-input-generator
            (lambda ()
              (when (zerop cmd-count) (reject))
              (let ((c nil))
                (if *replaying-choices*
                    (let ((idx (choice cmd-count)))
                      (setq c (svref all-cmds idx))
                      (unless (funcall (command-enabled c) model)
                        (reject))
                      (let ((w (funcall (command-weight c) model)))
                        (check-type w unsigned-byte)
                        (unless (plusp w) (reject))))
                    (let ((weighted nil)
                          (total-weight 0))
                      (dotimes (idx cmd-count)
                        (let ((cmd (svref all-cmds idx)))
                          (when (funcall (command-enabled cmd) model)
                            (let ((w (funcall (command-weight cmd) model)))
                              (check-type w unsigned-byte)
                              (when (plusp w)
                                (incf total-weight w)
                                (push (list idx w cmd) weighted))))))
                      (unless (plusp total-weight) (reject))
                      (let ((pick (random-below total-weight)))
                        (dolist (entry (nreverse weighted))
                          (if (< pick (second entry))
                              (progn
                                (push (first entry) *choice-trace*)
                                (setq c (third entry))
                                (return))
                              (decf pick (second entry)))))))
                (let ((args (draw-input (funcall (command-argument-generator c) model))))
                  (unless (and (listp args) (= (length args) (command-arity c)))
                    (error "Bad command generator arity for ~S: ~S" (command-name c) args))
                  (unless (apply (command-precondition c) model args) (reject))
                  (setq model (apply (command-model-transition c) model args))
                  (when (command-produces c)
                    (incf *machine-ref-counter*)
                    (record-bundle-ref (command-produces c)
                                       (list :ref (command-produces c) *machine-ref-counter*)))
                  (cons (command-name c) args)))))))
    (flet ((draw-step ()
             (if *replaying-choices*
                 (draw-input step-gen)
                 (loop repeat 10 do
                   (let ((saved *choice-trace*))
                     (handler-case (return (draw-input step-gen))
                       (rejected-draw () (setq *choice-trace* saved))))
                   finally (reject)))))
      (multiple-value-bind (ops trace)
          (let ((*remaining-replay-choices* children)
                (*choice-trace* nil))
            (let ((out nil))
              (dotimes (step target)
                (handler-case
                    (push (draw-step) out)
                  (rejected-draw ()
                    (if (and (not *replaying-choices*) (>= step min))
                        (return)
                        (reject)))))
              (values (nreverse out) (nreverse *choice-trace*))))
        (values ops (cons :sequence trace) model)))))

(defun commands (name &key (min 0) max)
  (check-type min unsigned-byte)
  (when max
    (check-type max unsigned-byte)
    (when (< max min) (error "Invalid length range")))
  (let ((machine (find-machine name)))
    (make-input-generator
     (lambda ()
       (let ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
             (*machine-bundles* nil)
             (*machine-ref-counter* 0))
         (multiple-value-bind (ops seq-trace final-model)
             (generate-command-sequence machine (funcall (machine-initial-model machine)) min max old)
           (declare (ignore final-model))
           (push seq-trace *choice-trace*)
           ops))))))

(defun parallel-commands (name &key (prefix-max 4) (branch-count 2) (branch-max 4) with-schedule)
  (check-type prefix-max unsigned-byte)
  (check-type branch-count (integer 1 *))
  (check-type branch-max unsigned-byte)
  (let ((machine (find-machine name)))
    (make-input-generator
     (lambda ()
       (let* ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
              (old-items (and (consp old) old))
              (*machine-bundles* nil)
              (*machine-ref-counter* 0))
         (multiple-value-bind (prefix prefix-trace mid-model)
             (generate-command-sequence machine (funcall (machine-initial-model machine))
                                        0 prefix-max (first old-items))
           (let ((mid-bundles (mapcar (lambda (e) (cons (car e) (copy-list (cdr e)))) *machine-bundles*))
                 (mid-counter *machine-ref-counter*)
                 (branches nil)
                 (branch-traces nil))
             (dotimes (b branch-count)
               (let ((*machine-bundles* (mapcar (lambda (e) (cons (car e) (copy-list (cdr e)))) mid-bundles))
                     (*machine-ref-counter* mid-counter))
                 (multiple-value-bind (b-ops b-trace b-model)
                     (generate-command-sequence machine mid-model 1 branch-max
                                                (nth (1+ b) old-items))
                   (declare (ignore b-model))
                   (push b-ops branches)
                   (push b-trace branch-traces))))
             (let ((final-branches (nreverse branches))
                   (final-branch-traces (nreverse branch-traces)))
               (if with-schedule
                   (let* ((sched-old (and *replaying-choices* (nth (1+ branch-count) old-items)))
                          (sched-gen (list-of (integers :min 0 :max (1- branch-count))
                                              :min 0 :max (* branch-count branch-max))))
                     (multiple-value-bind (schedule sched-trace)
                         (let ((*remaining-replay-choices* (when *replaying-choices* (list sched-old)))
                               (*choice-trace* nil))
                           (values (draw-input sched-gen) (car *choice-trace*)))
                       (push (append (cons prefix-trace final-branch-traces) (list sched-trace))
                             *choice-trace*)
                       (list :scheduled prefix final-branches schedule)))
                   (progn
                     (push (cons prefix-trace final-branch-traces) *choice-trace*)
                     (cons prefix final-branches)))))))))))

(defmacro with-machine-callback-errors (&body forms)
  `(handler-case (progn ,@forms) (error (c) (error 'machine-callback-error :cause c))))

(defun check-machine-invariant (name machine step-tag index operation model sut)
  (let ((inv (machine-invariant machine)))
    (when inv
      (let ((ok (handler-case (funcall inv model sut)
                  (property-violation (c)
                    (error 'property-violation
                           :key (list name step-tag :invariant (property-violation-key c))
                           :details (list :step index :command operation :cause c)))
                  (zk-test::assertion-failure (c)
                    (error 'property-violation
                           :key (list name step-tag :invariant :assertion)
                           :details (list :step index :command operation :form (zk-test::assertion-form c)
                                          :details (zk-test::assertion-details c))))
                  (error (c)
                    (error 'property-violation
                           :key (list name step-tag :invariant :condition (class-name (class-of c)))
                           :details (list :step index :command operation :cause c))))))
        (unless ok
          (error 'property-violation
                 :key (list name step-tag :invariant)
                 :details (list :step index :command operation :model model)))))))

(defun check-command-postcondition (name command index operation model next actual arguments)
  (let ((post (command-postcondition command)))
    (when post
      (let ((ok (handler-case (apply post model next actual arguments)
                  (property-violation (c)
                    (error 'property-violation
                           :key (list name (car operation) :postcondition (property-violation-key c))
                           :details (list :step index :command operation :cause c)))
                  (zk-test::assertion-failure (c)
                    (error 'property-violation
                           :key (list name (car operation) :postcondition :assertion)
                           :details (list :step index :command operation :form (zk-test::assertion-form c)
                                          :details (zk-test::assertion-details c))))
                  (error (c)
                    (error 'property-violation
                           :key (list name (car operation) :postcondition :condition (class-name (class-of c)))
                           :details (list :step index :command operation :cause c))))))
        (unless ok
          (error 'property-violation
                 :key (list name (car operation) :postcondition)
                 :details (list :step index :command operation :model-before model :model-after next :actual actual)))))))

(defun invoke-command-action (name command index operation sut arguments)
  (handler-case (multiple-value-list (apply (command-system-action command) sut arguments))
    (property-violation (c)
      (note "step ~D: ~S => VIOLATION ~S" index operation (property-violation-key c))
      (error 'property-violation
             :key (list name (car operation) (property-violation-key c))
             :details (list :step index :command operation :cause c)))
    (zk-test::assertion-failure (c)
      (note "step ~D: ~S => ASSERTION ~S" index operation (zk-test::assertion-form c))
      (error 'property-violation
             :key (list name (car operation) :assertion)
             :details (list :step index :command operation :form (zk-test::assertion-form c)
                            :details (zk-test::assertion-details c))))
    (error (c)
      (note "step ~D: ~S => ERROR ~A" index operation c)
      (error 'property-violation
             :key (list name (car operation) :condition (class-name (class-of c)))
             :details (list :step index :command operation :cause c)))))

(defun execute-commands (name machine operations model sut)
  (check-machine-invariant name machine :initial -1 nil model sut)
  (loop for operation in operations for index from 0 do
    (let* ((command (find (car operation) (machine-commands machine) :key #'command-name))
           (arguments (cdr operation)))
      (with-machine-callback-errors
        (unless (and command (= (length arguments) (command-arity command))
                     (funcall (command-enabled command) model)
                     (apply (command-precondition command) model arguments))
          (error "Illegal command ~S at step ~D" operation index)))
      (let* ((step-values (with-machine-callback-errors
                            (multiple-value-list (apply (command-model-transition command) model arguments))))
             (next (first step-values))
             (expected (second step-values))
             (actual (invoke-command-action name command index operation sut arguments)))
        (note "step ~D: ~S => ~S" index operation actual)
        (when (command-produces command)
          (incf *machine-ref-counter*)
          (let ((ref (list :ref (command-produces command) *machine-ref-counter*)))
            (setf (gethash ref *machine-ref-env*) (first actual))))
        (when (or (command-has-compare-p command) (not (command-postcondition command)))
          (unless (with-machine-callback-errors
                    (funcall (command-equivalent-results-p command) expected actual))
            (error 'property-violation :key (list name (car operation) :observation)
                   :details (list :step index :command operation :expected expected :actual actual))))
        (check-command-postcondition name command index operation model next actual arguments)
        (setq model next)
        (check-machine-invariant name machine (car operation) index operation model sut))))
  model)

(defun run-commands (name operations)
  (let* ((machine (find-machine name))
         (model (with-machine-callback-errors (funcall (machine-initial-model machine))))
         (sut (with-machine-callback-errors (funcall (machine-open-system machine))))
         (*machine-ref-counter* 0)
         (*machine-ref-env* (make-hash-table :test 'equal))
         (prior nil))
    (unwind-protect
         (progn
           (handler-case (execute-commands name machine operations model sut)
             (error (c) (setq prior c) (error c)))
           t)
      (handler-case (funcall (machine-close-system machine) sut)
        (error (c) (error 'machine-callback-error :cause c :prior prior))))))

(defun command-result-matches-model-p (command model next expected actual arguments)
  (and (or (not (or (command-has-compare-p command) (not (command-postcondition command))))
           (multiple-value-bind (ok err)
               (handler-case (values (funcall (command-equivalent-results-p command) expected actual) nil)
                 (error (c) (values nil c)))
             (when err (note "compare callback error: ~A" err))
             ok))
       (or (null (command-postcondition command))
           (multiple-value-bind (ok err)
               (handler-case (values (apply (command-postcondition command) model next actual arguments) nil)
                 (error (c) (values nil c)))
             (when err (note "postcondition callback error: ~A" err))
             ok))))

(defun linearizable-p (machine mid-model observed-branches)
  (let* ((machine-obj (if (symbolp machine) (find-machine machine) machine))
         (branches (coerce observed-branches 'simple-vector))
         (bcount (length branches))
         (lengths (let ((a (make-array bcount)))
                    (dotimes (i bcount a) (setf (aref a i) (length (svref branches i))))))
         (visited (make-hash-table :test 'equal))
         (steps-explored 0)
         (max-states 20000))
    (labels ((dfs (pos-list model)
               (when (>= steps-explored max-states)
                 (return-from dfs nil))
               (incf steps-explored)
               (when (every (lambda (p len) (= p len)) pos-list (coerce lengths 'list))
                 (return-from dfs t))
               (let ((state-key (cons pos-list model)))
                 (when (gethash state-key visited)
                   (return-from dfs nil))
                 (setf (gethash state-key visited) t))
               (loop for b from 0 below bcount
                     for pos in pos-list
                     for len = (aref lengths b)
                     when (< pos len) do
                       (let* ((obs (nth pos (svref branches b)))
                              (operation (car obs))
                              (actual (cdr obs))
                              (command (find (car operation) (machine-commands machine-obj) :key #'command-name))
                              (arguments (cdr operation)))
                         (when (and command
                                    (= (length arguments) (command-arity command))
                                    (funcall (command-enabled command) model)
                                    (apply (command-precondition command) model arguments))
                           (let* ((step-values (multiple-value-list
                                                (apply (command-model-transition command) model arguments)))
                                  (next (first step-values))
                                  (expected (second step-values)))
                             (when (command-result-matches-model-p command model next expected actual arguments)
                               (let ((next-pos (loop for p in pos-list for i from 0
                                                     collect (if (= i b) (1+ p) p))))
                                 (when (dfs next-pos next)
                                   (return-from dfs t))))))))
               nil))
      (dfs (make-list bcount :initial-element 0) mid-model))))

(defun compile-linearizable-history (history)
  (let ((calls (make-hash-table :test 'equal))
        (entries nil)
        (event-index 0))
    (dolist (ev history)
      (unless (consp ev)
        (error "History event must be a list, got ~S" ev))
      (ecase (car ev)
        (:call
         (let* ((len (length ev))
                (id (second ev))
                (operation (cond ((= len 3) (third ev))
                                 ((= len 4) (fourth ev))
                                 (t (error "Invalid :call history event ~S" ev)))))
           (unless (consp operation)
             (error "Expected operation form (CMD . ARGS) in ~S" ev))
           (when (gethash id calls)
             (error "Duplicate :call id ~S in history" id))
           (let ((rec (list id event-index nil operation nil nil)))
             (setf (gethash id calls) rec)
             (push rec entries))))
        (:return
         (unless (= (length ev) 3)
           (error "Invalid :return history event ~S" ev))
         (let* ((id (second ev))
                (actual (third ev))
                (rec (gethash id calls)))
           (unless rec
             (error "Unexpected :return for unknown call id ~S" id))
           (when (sixth rec)
             (error "Duplicate :return for call id ~S" id))
           (unless (listp actual)
             (error "Expected return value list in ~S" ev))
           (setf (third rec) event-index
                 (fifth rec) actual
                 (sixth rec) t))))
      (incf event-index))
    (let ((ordered (nreverse entries)))
      (dolist (rec ordered)
        (unless (sixth rec)
          (setf (third rec) event-index)))
      (coerce ordered 'simple-vector))))

(defun linearizable-history-p (machine initial-model history &key (max-steps 50000))
  (let* ((machine-obj (if (symbolp machine) (find-machine machine) machine))
         (items (compile-linearizable-history history))
         (n (length items)))
    (when (zerop n)
      (return-from linearizable-history-p t))
    (let ((call-times (make-array n))
          (ret-times (make-array n))
          (commands (make-array n))
          (args-vec (make-array n))
          (actuals (make-array n))
          (has-returns (make-array n))
          (prereqs (make-array n :initial-element 0))
          (completed-mask 0)
          (visited (make-hash-table :test 'equal))
          (steps-explored 0)
          (cmds (machine-commands machine-obj)))
      (dotimes (i n)
        (let* ((rec (svref items i))
               (op (fourth rec))
               (cmd (find (car op) cmds :key #'command-name))
               (args (cdr op)))
          (unless (and cmd (= (length args) (command-arity cmd)))
            (return-from linearizable-history-p nil))
          (setf (aref call-times i) (second rec)
                (aref ret-times i) (third rec)
                (svref commands i) cmd
                (svref args-vec i) args
                (svref actuals i) (fifth rec)
                (aref has-returns i) (sixth rec))
          (when (sixth rec)
            (setq completed-mask (logior completed-mask (ash 1 i))))))
      (dotimes (i n)
        (let ((ci (aref call-times i))
              (mask 0))
          (dotimes (j n)
            (when (and (aref has-returns j) (< (aref ret-times j) ci))
              (setq mask (logior mask (ash 1 j)))))
          (setf (aref prereqs i) mask)))
      (labels ((dfs (mask model)
                 (when (= (logand mask completed-mask) completed-mask)
                   (return-from dfs t))
                 (when (>= steps-explored max-steps)
                   (return-from dfs nil))
                 (incf steps-explored)
                 (let ((key (cons mask model)))
                   (when (gethash key visited)
                     (return-from dfs nil))
                   (setf (gethash key visited) t))
                 (dotimes (i n nil)
                   (when (and (not (logbitp i mask))
                              (= (logand (aref prereqs i) mask) (aref prereqs i)))
                     (let ((cmd (svref commands i))
                           (args (svref args-vec i)))
                       (when (and (funcall (command-enabled cmd) model)
                                  (apply (command-precondition cmd) model args))
                         (let* ((step-values (multiple-value-list
                                              (apply (command-model-transition cmd) model args)))
                                (next (first step-values))
                                (expected (second step-values)))
                           (when (or (not (aref has-returns i))
                                     (command-result-matches-model-p
                                      cmd model next expected (svref actuals i) args))
                             (when (dfs (logior mask (ash 1 i)) next)
                               (return-from dfs t))))))))))
        (dfs 0 initial-model)))))

(defun unpack-parallel-plan (plan)
  (cond
    ((and (consp plan) (eq (car plan) :scheduled) (= (length plan) 4))
     (values (second plan) (third plan) (fourth plan) t))
    ((and (listp plan) (>= (length plan) 2))
     (values (first plan) (rest plan) nil nil))
    (t
     (error "RUN-PARALLEL-COMMANDS expected (PREFIX BRANCH1 ...) or (:scheduled PREFIX BRANCHES SCHEDULE), got ~S"
            plan))))

(defun run-parallel-commands (name plan &key interleave-schedule)
  (multiple-value-bind (prefix branches plan-schedule scheduled-p) (unpack-parallel-plan plan)
    (let* ((effective-schedule (or interleave-schedule plan-schedule))
           (machine (find-machine name))
           (bcount (length branches))
           (model (with-machine-callback-errors (funcall (machine-initial-model machine))))
           (sut (with-machine-callback-errors (funcall (machine-open-system machine))))
           (*machine-ref-counter* 0)
           (*machine-ref-env* (make-hash-table :test 'equal))
           (prior nil))
      (unwind-protect
           (handler-case
               (let* ((mid-model (execute-commands name machine prefix model sut))
                      (queues (coerce (mapcar #'copy-list branches) 'simple-vector))
                      (observed (make-array bcount :initial-element nil))
                      (step-counter (length prefix)))
                 (flet ((step-branch (b)
                          (let ((op (pop (svref queues b))))
                            (when op
                              (let* ((command (find (car op) (machine-commands machine) :key #'command-name))
                                     (arguments (cdr op)))
                                (with-machine-callback-errors
                                  (unless (and command (= (length arguments) (command-arity command)))
                                    (error "Unknown parallel command ~S" op)))
                                (let ((actual (invoke-command-action name command step-counter op sut arguments)))
                                  (incf step-counter)
                                  (note "branch ~D: ~S => ~S" b op actual)
                                  (when (command-produces command)
                                    (incf *machine-ref-counter*)
                                    (let ((ref (list :ref (command-produces command) *machine-ref-counter*)))
                                      (setf (gethash ref *machine-ref-env*) (first actual))))
                                  (push (cons op actual) (svref observed b)))
                                t)))))
                   (dolist (choice effective-schedule)
                     (step-branch (mod (abs choice) bcount)))
                   (loop while (some #'identity (coerce queues 'list)) do
                     (dotimes (b bcount)
                       (step-branch b)))
                   (let ((obs-branches (loop for b below bcount collect (nreverse (svref observed b)))))
                     (unless (with-machine-callback-errors
                               (linearizable-p machine mid-model obs-branches))
                       (when (or scheduled-p effective-schedule)
                         (note "schedule: ~S" effective-schedule))
                       (error 'property-violation
                              :key (list name :linearizability)
                              :details (append (list :prefix prefix :branches obs-branches)
                                               (when (or scheduled-p effective-schedule)
                                                 (list :schedule effective-schedule)))))))
                 t)
             (error (c) (setq prior c) (error c)))
        (handler-case (funcall (machine-close-system machine) sut)
          (error (c) (error 'machine-callback-error :cause c :prior prior)))))))

(defmacro interleaved-steps (&body forms)
  `(list ,@(mapcar (lambda (f) `(lambda () ,f)) forms)))

(defun interleaving-schedules (task-count &key (min 0) (max 16))
  (check-type task-count (integer 1 *))
  (check-type min unsigned-byte)
  (check-type max unsigned-byte)
  (when (< max min)
    (error "Invalid interleaving schedule length range ~D..~D" min max))
  (list-of (integers :min 0 :max (1- task-count)) :min min :max max))

(defun shrink-schedule-list (xs)
  (when (listp xs)
    (let ((len (length xs))
          (cands nil))
      (when (plusp len)
        (loop for b = len then (floor b 2) while (plusp b) do
          (loop for i from 0 to (- len b) by b do
            (push (append (subseq xs 0 i) (subseq xs (+ i b))) cands))))
      (nreverse cands))))

(defun pct-schedules (task-count &key (steps 16) (bug-depth 2))
  "Probabilistic Concurrency Testing (PCT) schedule generator (Burckhardt et al., ASPLOS 2010).
Assigns a random priority permutation to TASK-COUNT tasks and schedules STEPS
steps while introducing BUG-DEPTH - 1 priority lowering points."
  (check-type task-count (integer 1 *))
  (check-type steps unsigned-byte)
  (check-type bug-depth (integer 1 *))
  (make-input-generator
   (lambda ()
     (let ((order (make-array task-count))
           (priorities (make-array task-count))
           (change-points (make-array (max 0 (1- bug-depth)) :initial-element -1))
           (schedule nil))
       (dotimes (i task-count)
         (setf (aref order i) i))
       (loop for i from 0 below (max 0 (1- task-count)) do
         (let ((offset (choice (- task-count i))))
           (unless (zerop offset)
             (rotatef (aref order i) (aref order (+ i offset))))))
       (dotimes (rank task-count)
         (setf (aref priorities (aref order rank)) (+ bug-depth rank)))
       (when (plusp steps)
         (dotimes (c (1- bug-depth))
           (setf (aref change-points c) (choice steps))))
       (dotimes (s steps)
         (let ((best 0)
               (best-prio (aref priorities 0)))
           (loop for tid from 1 below task-count
                 for prio = (aref priorities tid)
                 when (> prio best-prio) do
                   (setq best tid
                         best-prio prio))
           (push best schedule)
           (dotimes (c (1- bug-depth))
             (when (= s (aref change-points c))
               (setf (aref priorities best)
                     (min (aref priorities best) (1+ c)))))))
       (nreverse schedule)))
   nil
   #'shrink-schedule-list))

(defun run-interleaved (tasks schedule)
  (let* ((count (length tasks))
         (queues (coerce (mapcar #'copy-list tasks) 'simple-vector))
         (steps-done (make-array count :initial-element 0))
         (last-values (make-array count :initial-element nil)))
    (flet ((step-task (idx)
             (let ((thunk (pop (svref queues idx))))
               (when thunk
                 (let ((step-no (aref steps-done idx))
                       (val (funcall thunk)))
                   (incf (aref steps-done idx))
                   (setf (aref last-values idx) val)
                   (note "task ~D step ~D => ~S" idx step-no val)
                   t)))))
      (when (plusp count)
        (dolist (choice schedule)
          (step-task (mod (abs choice) count)))
        (loop while (some #'identity (coerce queues 'list)) do
          (dotimes (i count)
            (step-task i)))))
    (loop for i below count collect (aref last-values i))))

;;; ============================================================================
;;; Monolith-style Multi-Object Differential Model Testing (defmodel)
;;; ============================================================================

(defstruct model-abstract-type name check close)
(defstruct model-op name params weight pre ref cand cand-symbol returns exn-eq)
(defstruct diff-model name types ops exn-eq has-dependent-params)
(defvar *model-registry* (make-hash-table :test 'eq))

(defun find-model (name)
  (or (gethash name *model-registry*)
      (error "Unknown differential model ~S" name)))

(defun default-model-exn-eq (a b)
  (eq (class-of a) (class-of b)))

(defun compile-return-spec (spec)
  (cond
    ((eq spec :value) '(list :value))
    ((and (consp spec) (eq (first spec) :abstract))
     (unless (and (= (length spec) 2) (symbolp (second spec)))
       (error "Expected (:abstract TYPE) return spec, got ~S" spec))
     `(list :abstract ',(second spec)))
    ((and (consp spec) (eq (first spec) :compare))
     (unless (= (length spec) 2)
       (error "Expected (:compare FN) return spec, got ~S" spec))
     `(list :compare ,(second spec)))
    ((and (consp spec) (eq (first spec) :nondet))
     (unless (= (length spec) 2)
       (error "Expected (:nondet VALIDATOR) return spec, got ~S" spec))
     `(list :nondet ,(second spec)))
    ((and (consp spec) (eq (first spec) :values))
     (unless (cdr spec)
       (error "Expected at least one value in (:values ...) return spec ~S" spec))
     `(list :values ,@(mapcar #'compile-return-spec (cdr spec))))
    (t (error "Unknown :returns specification ~S" spec))))

(defun model-op-fn-clause (key opts required)
  (let ((spec (find-machine-clause key opts required)))
    (when spec
      (cond
        ((null (cddr spec))
         (second spec))
        ((listp (second spec))
         `(lambda ,(second spec)
            (declare (ignorable ,@(second spec)))
            ,@(cddr spec)))
        (t (error "Malformed clause ~S in DEFMODEL" spec))))))

(defun compile-model-params (param-specs declared-types)
  (let ((compiled nil)
        (prior-vars nil))
    (dolist (p param-specs (list* 'list (nreverse compiled)))
      (unless (and (consp p) (= (length p) 2) (symbolp (first p)))
        (error "Invalid DEFMODEL parameter specification ~S" p))
      (let ((var (first p))
            (spec (second p)))
        (cond
          ((and (consp spec) (eq (first spec) :ref))
           (unless (and (= (length spec) 2) (symbolp (second spec)))
             (error "Expected (:ref TYPE) in parameter ~S" p))
           (unless (member (second spec) declared-types :test #'eq)
             (error "Unknown abstract type ~S in parameter ~S" (second spec) p))
           (push `(list :ref ',(second spec) ',var) compiled))
          ((and (consp spec) (eq (first spec) :refs))
           (destructuring-bind (type-name &key (min 0) (max 3)) (cdr spec)
             (unless (symbolp type-name)
               (error "Expected (:refs TYPE ...) in parameter ~S" p))
             (unless (member type-name declared-types :test #'eq)
               (error "Unknown abstract type ~S in parameter ~S" type-name p))
             (check-type min unsigned-byte)
             (check-type max unsigned-byte)
             (when (< max min)
               (error "Invalid (:refs ...) count bounds in ~S" p))
             (push `(list :refs ',type-name ,min ,max ',var) compiled)))
          ((and (consp spec) (eq (first spec) :from))
           (unless (and (= (length spec) 3) (listp (second spec)) (every #'symbolp (second spec)))
             (error "Expected (:from (PREV-VARS...) GEN-EXPR) in parameter ~S" p))
           (dolist (dep (second spec))
             (unless (member dep prior-vars :test #'eq)
               (error ":from dependency ~S must name an earlier parameter in ~S" dep p)))
           (let ((gvar (gensym "GEN")))
             (push `(list :from ',(second spec)
                          (lambda ,(second spec)
                            (declare (ignorable ,@(second spec)))
                            (let ((,gvar ,(third spec)))
                              (check-type ,gvar input-generator)
                              ,gvar))
                          ',var)
                   compiled)))
          (t
           (let ((gvar (gensym "GEN")))
             (push `(let ((,gvar ,spec))
                      (check-type ,gvar input-generator)
                      (list :gen ,gvar ',var))
                   compiled))))
        (push var prior-vars)))))

(defun validate-return-spec-types (spec declared-types op-name)
  (cond
    ((and (consp spec) (eq (car spec) :abstract))
     (unless (member (second spec) declared-types :test #'eq)
       (error "Unknown abstract type ~S in :returns of op ~S" (second spec) op-name)))
    ((and (consp spec) (eq (car spec) :values))
     (dolist (sub (cdr spec))
       (validate-return-spec-types sub declared-types op-name)))))

(defmacro defmodel (name &body clauses)
  (unless (symbolp name)
    (error "Differential model name must be a symbol: ~S" name))
  (let ((type-forms nil)
        (declared-types nil)
        (op-clauses nil)
        (exn-eq-expr '#'default-model-exn-eq)
        (seen-exn-eq nil)
        (seen-op-names nil))
    (dolist (clause clauses)
      (unless (consp clause)
        (error "Invalid DEFMODEL clause ~S" clause))
      (case (first clause)
        (:exn-eq
         (when seen-exn-eq (error "Repeated :exn-eq clause in DEFMODEL ~S" name))
         (setq seen-exn-eq t
               exn-eq-expr (or (model-op-fn-clause :exn-eq (list clause) t)
                               (error "Invalid :exn-eq clause ~S" clause))))
        (:abstract
         (destructuring-bind (type-name &key check close) (rest clause)
           (unless (symbolp type-name)
             (error "Abstract type name must be a symbol: ~S" type-name))
           (when (member type-name declared-types :test #'eq)
             (error "Duplicate :abstract type ~S in DEFMODEL ~S" type-name name))
           (push type-name declared-types)
           (push `(make-model-abstract-type :name ',type-name :check ,check :close ,close)
                 type-forms)))
        (:op
         (push clause op-clauses))
        (otherwise
         (error "Unknown DEFMODEL clause ~S" clause))))
    (setq declared-types (nreverse declared-types)
          type-forms (nreverse type-forms)
          op-clauses (nreverse op-clauses))
    (let ((op-forms nil))
      (dolist (clause op-clauses)
        (destructuring-bind (op-name params &rest opts) (rest clause)
          (unless (symbolp op-name)
            (error "Model operation name must be a symbol: ~S" op-name))
          (when (member op-name seen-op-names :test #'eq)
            (error "Duplicate :op ~S in DEFMODEL ~S" op-name name))
          (push op-name seen-op-names)
          (dolist (opt opts)
            (unless (and (consp opt)
                         (member (car opt) '(:weight :pre :ref :cand :returns :exn-eq)))
              (error "Unknown :op option ~S in ~S" opt op-name)))
          (let* ((weight-clause (find-machine-clause :weight opts nil))
                 (weight-expr (if weight-clause
                                  (progn
                                    (unless (= (length weight-clause) 2)
                                      (error "Expected (:weight N) in ~S" op-name))
                                    (second weight-clause))
                                  1))
                 (returns-clause (find-machine-clause :returns opts nil))
                 (returns-expr (if returns-clause
                                   (progn
                                     (unless (= (length returns-clause) 2)
                                       (error "Expected (:returns SPEC) in ~S" op-name))
                                     (compile-return-spec (second returns-clause)))
                                   '(list :value)))
                 (pre-expr (model-op-fn-clause :pre opts nil))
                 (ref-expr (model-op-fn-clause :ref opts t))
                 (cand-clause (find-machine-clause :cand opts t))
                 (cand-raw (second cand-clause))
                 (cand-symbol
                   (when (and (null (cddr cand-clause))
                              (consp cand-raw)
                              (= (length cand-raw) 2)
                              (member (first cand-raw) '(function quote) :test #'eq)
                              (symbolp (second cand-raw)))
                     (second cand-raw)))
                 (cand-expr (model-op-fn-clause :cand opts t))
                 (op-exn-expr (model-op-fn-clause :exn-eq opts nil))
                 (rspec-var (gensym "RSPEC"))
                 (w-var (gensym "WEIGHT")))
            (push `(let ((,rspec-var ,returns-expr)
                         (,w-var ,weight-expr))
                     (check-type ,w-var unsigned-byte)
                     (validate-return-spec-types ,rspec-var ',declared-types ',op-name)
                     (make-model-op
                      :name ',op-name
                      :params ,(compile-model-params params declared-types)
                      :weight ,w-var
                      :pre ,pre-expr
                      :ref ,ref-expr
                      :cand ,cand-expr
                      :cand-symbol ',cand-symbol
                      :returns ,rspec-var
                      :exn-eq ,op-exn-expr))
                  op-forms))))
      (let ((ops-vec-var (gensym "OPS")))
        `(let ((,ops-vec-var (coerce (list ,@(nreverse op-forms)) 'simple-vector)))
           (setf (gethash ',name *model-registry*)
                 (make-diff-model
                  :name ',name
                  :types (list ,@type-forms)
                  :ops ,ops-vec-var
                  :exn-eq ,exn-eq-expr
                  :has-dependent-params
                  (not (null (some (lambda (op)
                                     (some (lambda (ps) (eq (car ps) :from))
                                           (model-op-params op)))
                                   ,ops-vec-var)))))
           ',name)))))

(defun return-spec-abstract-types (rspec)
  (cond
    ((and (consp rspec) (eq (car rspec) :abstract))
     (list (second rspec)))
    ((and (consp rspec) (eq (car rspec) :values))
     (loop for sub in (cdr rspec) append (return-spec-abstract-types sub)))))

(defun model-op-eligible-p (op pools)
  (and (plusp (model-op-weight op))
       (every (lambda (pspec)
                (case (first pspec)
                  (:ref (plusp (length (gethash (second pspec) pools))))
                  (:refs (or (zerop (third pspec))
                             (plusp (length (gethash (second pspec) pools)))))
                  (otherwise t)))
              (model-op-params op))))

(defun draw-model-op-args (op pools &optional gen-ref-env)
  (let ((raw-args nil)
        (ref-args nil)
        (param-env nil))
    (dolist (pspec (model-op-params op) (values (nreverse raw-args) (nreverse ref-args)))
      (ecase (first pspec)
        (:ref
         (let* ((type (second pspec))
                (var (third pspec))
                (pool (gethash type pools))
                (len (length pool)))
           (when (zerop len) (reject))
           (let ((h (nth (choice len) pool)))
             (push h raw-args)
             (when gen-ref-env
               (multiple-value-bind (rv ok) (gethash h gen-ref-env)
                 (unless ok (reject))
                 (push rv ref-args)
                 (push (cons var rv) param-env))))))
        (:refs
         (let* ((type (second pspec))
                (min (third pspec))
                (max (fourth pspec))
                (var (fifth pspec))
                (pool (gethash type pools)))
           (when (and (plusp min) (zerop (length pool)))
             (reject))
           (let* ((elem-gen (if (null pool)
                                (just nil)
                                (make-input-generator
                                 (lambda ()
                                   (let* ((p (gethash type pools))
                                          (l (length p)))
                                     (when (zerop l) (reject))
                                     (nth (choice l) p))))))
                  (effective-max (if (null pool) 0 max))
                  (handles (draw-input (list-of elem-gen :min min :max effective-max))))
             (push handles raw-args)
             (when gen-ref-env
               (let ((rvals (loop for h in handles
                                  collect (multiple-value-bind (rv ok) (gethash h gen-ref-env)
                                            (unless ok (reject))
                                            rv))))
                 (push rvals ref-args)
                 (push (cons var rvals) param-env))))))
        (:from
         (let* ((deps (second pspec))
                (fn (third pspec))
                (var (fourth pspec))
                (dep-vals (mapcar (lambda (d) (cdr (assoc d param-env :test #'eq))) deps))
                (gen (apply fn dep-vals)))
           (check-type gen input-generator)
           (let ((val (draw-input gen)))
             (push val raw-args)
             (push val ref-args)
             (push (cons var val) param-env))))
        (:gen
         (let* ((gen (second pspec))
                (var (third pspec))
                (val (draw-input gen)))
           (push val raw-args)
           (when gen-ref-env
             (push val ref-args)
             (push (cons var val) param-env))))))))

(defun allocate-model-step-handles (op pools next-id-ref)
  (let ((out-types (return-spec-abstract-types (model-op-returns op)))
        (handles nil))
    (dolist (type out-types)
      (let* ((id (car next-id-ref))
             (handle (list :mref type id)))
        (setf (car next-id-ref) (1+ id))
        (push handle handles)
        (setf (gethash type pools) (append (gethash type pools) (list handle)))))
    (nreverse handles)))

(defun bind-generated-ref-handles (rspec ref-vals handles gen-ref-env)
  (let ((cursor handles))
    (labels ((bind-slot (spec rval)
               (when (and (consp spec) (eq (car spec) :abstract) cursor)
                 (setf (gethash (pop cursor) gen-ref-env) rval))))
      (if (and (consp rspec) (eq (car rspec) :values))
          (loop for sub in (cdr rspec)
                for rv in ref-vals do (bind-slot sub rv))
          (bind-slot rspec (first ref-vals))))))

(defun execute-model-gen-step (op pools next-id-ref gen-ref-env)
  (multiple-value-bind (raw-args ref-args) (draw-model-op-args op pools gen-ref-env)
    (if (null gen-ref-env)
        (list (model-op-name op) (allocate-model-step-handles op pools next-id-ref) raw-args)
        (progn
          (when (model-op-pre op)
            (unless (apply (model-op-pre op) ref-args)
              (reject)))
          (multiple-value-bind (ref-vals ref-err)
              (handler-case
                  (values (multiple-value-list (apply (model-op-ref op) ref-args)) nil)
                (error (c) (values nil c)))
            (let ((handles (if ref-err
                               (progn (note "model ref error during gen: ~A" ref-err) nil)
                               (let ((hs (allocate-model-step-handles op pools next-id-ref)))
                                 (bind-generated-ref-handles (model-op-returns op) ref-vals hs gen-ref-env)
                                 hs))))
              (list (model-op-name op) handles raw-args)))))))

(defun model-scenarios (name &key (min 1) (max 20))
  (check-type min unsigned-byte)
  (check-type max unsigned-byte)
  (when (< max min) (error "Invalid scenario length range ~D..~D" min max))
  (let* ((model (find-model name))
         (ops-vec (diff-model-ops model))
         (op-count (length ops-vec))
         (dependent-p (diff-model-has-dependent-params model)))
    (when (zerop op-count)
      (error "Differential model ~S defines no operations" name))
    (make-input-generator
     (lambda ()
       (let* ((old (and *replaying-choices* (pop *remaining-replay-choices*)))
              (children (and (consp old) (eq (car old) :sequence) (cdr old)))
              (n (if *replaying-choices*
                     (max min (min max (length children)))
                     (let ((upper (min max (+ min *sample-size*))))
                       (+ min (random-below (1+ (- upper min)))))))
              (pools (make-hash-table :test 'eq))
              (gen-ref-env (when dependent-p (make-hash-table :test 'equal)))
              (next-id-ref (list 0))
              (steps nil)
              (step-traces nil))
         (dotimes (step-i n)
           (if *replaying-choices*
               (let* ((subtrace (and children (pop children)))
                      (op-idx nil))
                 (multiple-value-bind (step step-trace)
                     (let ((*remaining-replay-choices* (if (listp subtrace) subtrace nil))
                           (*choice-trace* nil))
                       (setq op-idx (choice op-count))
                       (let ((op (svref ops-vec op-idx)))
                         (unless (plusp (model-op-weight op)) (reject))
                         (values (execute-model-gen-step op pools next-id-ref gen-ref-env)
                                 (nreverse *choice-trace*))))
                   (push step steps)
                   (push step-trace step-traces)))
               (let ((eligible (loop for idx below op-count
                                     for op = (svref ops-vec idx)
                                     when (model-op-eligible-p op pools)
                                     collect (cons idx op))))
                 (when (null eligible)
                   (if (>= step-i min)
                       (return)
                       (reject)))
                 (let ((total-weight (reduce #'+ eligible :key (lambda (e) (model-op-weight (cdr e))))))
                   (when (zerop total-weight)
                     (if (>= step-i min)
                         (return)
                         (reject)))
                   (let* ((pick (random-below total-weight))
                          (chosen (dolist (entry eligible)
                                    (let ((w (model-op-weight (cdr entry))))
                                      (when (< pick w) (return entry))
                                      (decf pick w))))
                          (op-idx (car chosen))
                          (op (cdr chosen)))
                     (multiple-value-bind (step step-trace)
                         (let ((*choice-trace* nil))
                           (push op-idx *choice-trace*)
                           (values (execute-model-gen-step op pools next-id-ref gen-ref-env)
                                   (nreverse *choice-trace*)))
                       (push step steps)
                       (push step-trace step-traces)))))))
         (push (cons :sequence (nreverse step-traces)) *choice-trace*)
         (nreverse steps))))))

(defun format-model-handle-name (handle)
  (format nil "~(~A~)-~D" (second handle) (third handle)))

(defun format-model-arg-code (arg)
  (cond
    ((and (consp arg) (eq (car arg) :mref) (= (length arg) 3))
     (format-model-handle-name arg))
    ((and (consp arg) (some (lambda (el) (and (consp el) (eq (car el) :mref) (= (length el) 3))) arg))
     (format nil "(list ~{~A~^ ~})" (mapcar #'format-model-arg-code arg)))
    ((or (numberp arg) (stringp arg) (characterp arg) (keywordp arg) (eq arg t) (null arg))
     (let ((*print-readably* nil)) (prin1-to-string arg)))
    (t (format nil "'~S" arg))))

(defun format-model-scenario (name scenario &key limit executable)
  (let* ((model (gethash name *model-registry*))
         (ops-vec (and model (diff-model-ops model)))
         (steps (if limit (subseq scenario 0 (min limit (length scenario))) scenario))
         (all-vars (loop for step in steps
                         append (mapcar #'format-model-handle-name (second step)))))
    (with-output-to-string (out)
      (format out ";; Differential scenario for ~S (~D step~:P)~%" name (length steps))
      (if all-vars
          (format out "(let (~{~A~^ ~})" all-vars)
          (format out "(progn"))
      (dolist (step steps)
        (let* ((op-sym (first step))
               (op-rec (and ops-vec (find op-sym ops-vec :key #'model-op-name :test #'eq)))
               (cand-sym (and executable op-rec (model-op-cand-symbol op-rec)))
               (op-name (if cand-sym
                            (string-downcase (format nil "~S" cand-sym))
                            (string-downcase (symbol-name op-sym))))
               (handles (second step))
               (args (mapcar #'format-model-arg-code (third step)))
               (call-str (if args
                             (format nil "(~A ~{~A~^ ~})" op-name args)
                             (format nil "(~A)" op-name))))
          (cond
            ((null handles)
             (format out "~%  ~A" call-str))
            ((= (length handles) 1)
             (format out "~%  (setq ~A ~A)" (format-model-handle-name (first handles)) call-str))
            (t
             (format out "~%  (multiple-value-setq (~{~A~^ ~}) ~A)"
                     (mapcar #'format-model-handle-name handles) call-str)))))
      (format out ")"))))

(defun resolve-model-arg-value (arg ref-env cand-env)
  (cond
    ((and (consp arg) (eq (car arg) :mref))
     (multiple-value-bind (r r-ok) (gethash arg ref-env)
       (multiple-value-bind (c c-ok) (gethash arg cand-env)
         (unless (and r-ok c-ok)
           (signal 'assumption-rejected)
           (error "Unbound model handle ~S" arg))
         (values r c))))
    ((listp arg)
     (let ((rs nil)
           (cs nil))
       (dolist (el arg (values (nreverse rs) (nreverse cs)))
         (multiple-value-bind (r c) (resolve-model-arg-value el ref-env cand-env)
           (push r rs)
           (push c cs)))))
    (t (values arg arg))))

(defun resolve-model-step-args (raw-args ref-env cand-env)
  (let ((ref-args nil)
        (cand-args nil))
    (dolist (a raw-args (values (nreverse ref-args) (nreverse cand-args)))
      (multiple-value-bind (r c) (resolve-model-arg-value a ref-env cand-env)
        (push r ref-args)
        (push c cand-args)))))

(defun run-model (name scenario)
  (let* ((model (find-model name))
         (ops-vec (diff-model-ops model))
         (types (diff-model-types model))
         (default-exn-eq (diff-model-exn-eq model))
         (ref-env (make-hash-table :test 'equal))
         (cand-env (make-hash-table :test 'equal))
         (active-objects nil)
         (created-cands nil)
         (prior nil))
    (flet ((find-type (tname)
             (find tname types :key #'model-abstract-type-name :test #'eq))
           (find-op (op-name)
             (find op-name ops-vec :key #'model-op-name :test #'eq)))
      (unwind-protect
           (handler-case
               (progn
                 (loop for step in scenario
                       for idx from 0 do
                       (unless (and (consp step) (= (length step) 3))
                         (error "Malformed model step ~S" step))
                       (let* ((op-name (first step))
                              (bound-handles (second step))
                              (raw-args (third step))
                              (op (or (find-op op-name)
                                      (error "Unknown op ~S in model ~S" op-name name)))
                              (handle-cursor bound-handles))
                         (labels ((fail-model (subkey &rest details)
                                    (note "~A" (format-model-scenario name scenario :limit (1+ idx)))
                                    (error 'property-violation
                                           :key (list name op-name subkey)
                                           :details (list* :step idx :op op-name details)))
                                  (check-slot (spec ref-val cand-val ref-args slot-idx)
                                    (ecase (car spec)
                                      (:value
                                       (unless (equal ref-val cand-val)
                                         (fail-model :observation :slot slot-idx
                                                     :expected ref-val :actual cand-val)))
                                      (:compare
                                       (unless (with-machine-callback-errors
                                                 (funcall (second spec) ref-val cand-val))
                                         (fail-model :observation :slot slot-idx
                                                     :expected ref-val :actual cand-val)))
                                      (:nondet
                                       (unless (with-machine-callback-errors
                                                 (funcall (second spec) ref-args cand-val))
                                         (fail-model :nondet-observation :slot slot-idx
                                                     :args ref-args :actual cand-val)))
                                      (:abstract
                                       (unless handle-cursor
                                         (error "Missing bound handle for (:abstract ~S) at step ~D"
                                                (second spec) idx))
                                       (let ((h (pop handle-cursor)))
                                         (setf (gethash h ref-env) ref-val
                                               (gethash h cand-env) cand-val)
                                         (push (cons (second spec) h) active-objects)
                                         (push (cons (second spec) cand-val) created-cands)))))
                                  (check-returns (spec ref-vals cand-vals ref-args)
                                    (if (eq (car spec) :values)
                                        (let* ((subs (cdr spec))
                                               (expected-n (length subs)))
                                          (unless (= (length cand-vals) expected-n)
                                            (fail-model :arity-mismatch
                                                        :expected expected-n
                                                        :actual (length cand-vals)
                                                        :values cand-vals))
                                          (unless (= (length ref-vals) expected-n)
                                            (error "Reference op ~S returned ~D values, expected ~D"
                                                   op-name (length ref-vals) expected-n))
                                          (loop for sub in subs
                                                for r in ref-vals
                                                for c in cand-vals
                                                for s-idx from 0 do
                                                  (check-slot sub r c ref-args s-idx)))
                                        (check-slot spec (first ref-vals) (first cand-vals) ref-args 0)))
                                  (check-all-invariants ()
                                    (dolist (entry (reverse active-objects))
                                      (let* ((tname (car entry))
                                             (h (cdr entry))
                                             (tinfo (find-type tname))
                                             (chk (and tinfo (model-abstract-type-check tinfo))))
                                        (when chk
                                          (let ((rval (gethash h ref-env))
                                                (cval (gethash h cand-env)))
                                            (multiple-value-bind (ok err)
                                                (handler-case
                                                    (values (funcall chk rval cval) nil)
                                                  (error (c) (values nil c)))
                                              (unless ok
                                                (note "invariant ~S (~A): ref=~S cand=~S"
                                                      tname (format-model-handle-name h) rval cval)
                                                (fail-model :invariant
                                                            :type tname
                                                            :handle h
                                                            :ref-value rval
                                                            :cand-value cval
                                                            :cause err)))))))))
                           (multiple-value-bind (ref-args cand-args)
                               (resolve-model-step-args raw-args ref-env cand-env)
                             (when (model-op-pre op)
                               (unless (with-machine-callback-errors
                                         (apply (model-op-pre op) ref-args))
                                 (signal 'assumption-rejected)
                                 (error "Precondition failed for ~S at step ~D" op-name idx)))
                             (multiple-value-bind (ref-vals ref-err)
                                 (handler-case
                                     (values (multiple-value-list (apply (model-op-ref op) ref-args)) nil)
                                   (error (c) (values nil c)))
                               (multiple-value-bind (cand-vals cand-err)
                                   (handler-case
                                       (values (multiple-value-list (apply (model-op-cand op) cand-args)) nil)
                                     (error (c) (values nil c)))
                                 (cond
                                   ((and ref-err cand-err)
                                    (let ((cmp (or (model-op-exn-eq op) default-exn-eq)))
                                      (unless (with-machine-callback-errors
                                                (funcall cmp ref-err cand-err))
                                        (fail-model :exception-mismatch
                                                    :ref-error ref-err :cand-error cand-err))))
                                   (ref-err
                                    (fail-model :missing-exception
                                                :expected-error ref-err :actual cand-vals))
                                   (cand-err
                                    (fail-model :unexpected-exception
                                                :error cand-err :expected ref-vals))
                                   (t
                                    (check-returns (model-op-returns op) ref-vals cand-vals ref-args)))
                                 (check-all-invariants)))))))
                 t)
             (error (c) (setq prior c) (error c)))
        (dolist (entry created-cands)
          (let* ((tinfo (find-type (car entry)))
                 (closer (and tinfo (model-abstract-type-close tinfo))))
            (when closer
              (handler-case (funcall closer (cdr entry))
                (error (c) (error 'machine-callback-error :cause c :prior prior))))))))))

