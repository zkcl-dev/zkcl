(in-package #:zk-pbt)

;; The external grammar has only integers, strings and proper lists. In
;; particular it never calls READ, a reader macro, or a Lisp evaluator.
(defvar *case-codecs* nil)
(defun define-case-codec (tag encoder decoder &key (if-exists :error))
  (check-type tag string)
  (unless (member if-exists '(:error :supersede))
    (error "Expected :if-exists to be :error or :supersede, got ~S" if-exists))
  (let ((existing (assoc tag *case-codecs* :test #'equal)))
    (when existing
      (ecase if-exists
        (:error (error "Duplicate case codec ~S" tag))
        (:supersede
         (setf (second existing) encoder
               (third existing) decoder)
         (return-from define-case-codec tag)))))
  (push (list tag encoder decoder) *case-codecs*)
  tag)

(defun float-type-tag (x)
  (cond ((typep x 'single-float) "SINGLE-FLOAT")
        ((typep x 'double-float) "DOUBLE-FLOAT")
        ((typep x 'short-float) "SHORT-FLOAT")
        (t "LONG-FLOAT")))

(defun encode-case-value (value)
  (let ((seen (make-hash-table :test 'eq)) (next 0))
    (labels ((enc (x)
               (cond ((null x) nil)
                     ((integerp x) (list 0 x))
                     ((characterp x) (list 1 (char-code x)))
                     ((and (symbolp x) (symbol-package x))
                      (list 2 (package-name (symbol-package x)) (symbol-name x)))
                     ((typep x 'ratio) (list 3 (numerator x) (denominator x)))
                     ((floatp x)
                      (multiple-value-bind (m e sign) (integer-decode-float x)
                        (list 4 (float-type-tag x) m e
                              (if (zerop x) (if (minusp (float-sign x)) -1 1) sign))))
                     ((complexp x) (list 5 (enc (realpart x)) (enc (imagpart x))))
                     (t
                      (multiple-value-bind (id found) (gethash x seen)
                        (if found (list 6 id)
                            (progn
                              (setf (gethash x seen) next) (incf next)
                              (cond ((consp x) (list 7 (enc (car x)) (enc (cdr x))))
                                    ((and (typep x 'simple-string)
                                          (eq (array-element-type x) 'character))
                                     (list 8 (copy-seq x)))
                                    ((arrayp x)
                                     (multiple-value-bind (base offset) (array-displacement x)
                                       (list 9 (enc (array-element-type x)) (array-dimensions x)
                                             (if (adjustable-array-p x) 1 0)
                                             (if (array-has-fill-pointer-p x) (fill-pointer x) -1)
                                             (if base (list (enc base) offset)
                                                 (list (loop for i below (array-total-size x)
                                                             collect (enc (row-major-aref x i))))))))
                                    ((hash-table-p x)
                                     (let ((test (hash-table-test x)) (pairs nil))
                                       (unless (member test '(eq eql equal equalp))
                                         (error "Unsupported hash-table test ~S" test))
                                       (maphash (lambda (k v) (push (list (enc k) (enc v)) pairs)) x)
                                       (list 12 (symbol-name test) (nreverse pairs))))
                                    ((symbolp x) (list 10 (symbol-name x)))
                                    ((and (functionp x) (find-generated-function-spec x))
                                     (let ((spec (find-generated-function-spec x)))
                                       (list 13 (enc (first spec)) (enc (second spec)) (enc (third spec)))))
                                    (t (dolist (codec *case-codecs*
                                              (error "No case codec for ~S" (type-of x)))
                                         (multiple-value-bind (data applies) (funcall (second codec) x)
                                           (when applies
                                             (return (list 11 (first codec) (enc data)))))))))))))))
      (enc value))))

(defun decode-case-value (encoded-value)
  (let ((nodes (make-hash-table)) (next 0))
    (labels ((reserve () (prog1 next (incf next)))
             (record (id obj) (setf (gethash id nodes) obj))
             (dec (w)
               (if (null w) nil
                   (ecase (first w)
                     (0 (second w)) (1 (or (code-char (second w)) (error "Unknown character")))
                     (2 (let ((p (or (find-package (second w)) (error "Missing package ~A" (second w)))))
                          (intern (third w) p)))
                     (3 (/ (second w) (third w)))
                     (4 (let* ((kind (find-symbol (second w) :cl))
                               (magnitude (scale-float (coerce (third w) kind) (fourth w))))
                          (if (minusp (fifth w)) (- magnitude) magnitude)))
                     (5 (complex (dec (second w)) (dec (third w))))
                     (6 (multiple-value-bind (x found) (gethash (second w) nodes)
                          (unless found (error "Invalid or unsupported forward case reference")) x))
                     (7 (let ((c (record (reserve) (cons nil nil))))
                          (setf (car c) (dec (second w)) (cdr c) (dec (third w))) c))
                     (8 (record (reserve) (copy-seq (second w))))
                     (9 (destructuring-bind (tag element dims adjustable fill payload) w
                          (declare (ignore tag))
                          (let* ((id (reserve)) (type (dec element))
                                 (base (and (cdr payload) (dec (first payload))))
                                 (args (append (list :element-type type :adjustable (= adjustable 1))
                                               (unless (minusp fill) (list :fill-pointer fill))
                                               (when base (list :displaced-to base
                                                                :displaced-index-offset (second payload)))))
                                 (a (record id (apply #'make-array dims args))))
                            (unless base
                              (loop for v in (first payload) for i from 0
                                    do (setf (row-major-aref a i) (dec v))))
                            a)))
                     (12 (let* ((test (find-symbol (second w) :cl))
                                (h (record (reserve) (make-hash-table :test test))))
                           (dolist (pair (third w) h)
                             (let ((k (dec (first pair)))) (setf (gethash k h) (dec (second pair)))))))
                     (10 (record (reserve) (make-symbol (second w))))
                     (13 (record (reserve) (make-generated-function (dec (second w)) (dec (third w)) (dec (fourth w)))))
                     (11 (let* ((id (reserve))
                                (c (or (assoc (second w) *case-codecs* :test #'equal)
                                       (error "Missing case codec ~S" (second w)))))
                           (record id (funcall (third c) (dec (third w))))))))))
      (dec encoded-value))))

(defun immutable-case-atom-p (x)
  (or (null x) (numberp x) (characterp x)
      (and (symbolp x) (symbol-package x))))

(defun clone-test-value (value)
  (let ((seen nil))
    (labels ((clone (x)
               (if (immutable-case-atom-p x)
                   x
                   (progn
                     (unless seen (setq seen (make-hash-table :test 'eq)))
                     (multiple-value-bind (cached found) (gethash x seen)
                       (when found (return-from clone cached)))
                     (cond
                       ((and (functionp x) (find-generated-function-spec x))
                        (let* ((spec (find-generated-function-spec x))
                               (copy (make-generated-function
                                      (first spec) (clone (second spec)) (clone (third spec)))))
                          (setf (gethash x seen) copy)
                          copy))
                       ((consp x)
                        (let ((cell (cons nil nil)))
                          (setf (gethash x seen) cell
                                (car cell) (clone (car x))
                                (cdr cell) (clone (cdr x)))
                          cell))
                       ((and (typep x 'simple-string)
                             (eq (array-element-type x) 'character))
                        (let ((copy (copy-seq x)))
                          (setf (gethash x seen) copy)
                          copy))
                       ((arrayp x)
                        (multiple-value-bind (base offset) (array-displacement x)
                          (let* ((args (append (list :element-type (array-element-type x)
                                                     :adjustable (adjustable-array-p x))
                                               (when (array-has-fill-pointer-p x)
                                                 (list :fill-pointer (fill-pointer x)))
                                               (when base
                                                 (list :displaced-to (clone base)
                                                       :displaced-index-offset offset))))
                                 (copy (apply #'make-array (array-dimensions x) args)))
                            (setf (gethash x seen) copy)
                            (unless base
                              (dotimes (i (array-total-size x))
                                (setf (row-major-aref copy i) (clone (row-major-aref x i)))))
                            copy)))
                       ((hash-table-p x)
                        (let ((copy (make-hash-table :test (hash-table-test x))))
                          (setf (gethash x seen) copy)
                          (maphash (lambda (k v) (setf (gethash (clone k) copy) (clone v))) x)
                          copy))
                       ((symbolp x)
                        (let ((copy (make-symbol (symbol-name x))))
                          (setf (gethash x seen) copy)
                          copy))
                       (t
                        (dolist (codec *case-codecs* x)
                          (multiple-value-bind (data applies) (funcall (second codec) x)
                            (when applies
                              (let ((copy (funcall (third codec) (clone data))))
                                (setf (gethash x seen) copy)
                                (return-from clone copy)))))))))))
      (clone value))))

(defun clone-arguments (arguments)
  (if (every #'immutable-case-atom-p arguments)
      arguments
      (clone-test-value arguments)))

(defun write-case-datum (x s)
  (typecase x
    (integer (write x :stream s :base 10 :radix nil))
    (string (write-char #\" s)
            (loop for c across x do (when (member c '(#\" #\\)) (write-char #\\ s))
                  (write-char c s))
            (write-char #\" s))
    (list (write-char #\( s)
          (loop for sub in x for first = t then nil do
            (unless first (write-char #\Space s)) (write-case-datum sub s))
          (write-char #\) s))
    (t (error "Invalid case data"))))

(defun read-case-datum (s)
  (labels ((space-p (c) (member c '(#\Space #\Tab #\Newline #\Return)))
           (peek () (loop for c = (peek-char nil s nil nil)
                          while (space-p c) do (read-char s) finally (return c)))
           (item ()
             (let ((c (peek)))
               (unless c (error "Incomplete case file"))
               (cond ((char= c #\()
                      (read-char s)
                      (loop for ch = (peek) until (and ch (char= ch #\)))
                            collect (item) finally (read-char s)))
                     ((char= c #\")
                      (read-char s)
                      (with-output-to-string (out)
                        (loop for ch = (read-char s) until (char= ch #\") do
                          (write-char (if (char= ch #\\) (read-char s) ch) out))))
                     ((or (digit-char-p c) (char= c #\-))
                      (let ((neg (char= c #\-)) (n 0))
                        (when neg (read-char s))
                        (unless (digit-char-p (or (peek-char nil s nil nil) #\Space))
                          (error "Invalid case integer"))
                        (loop for ch = (peek-char nil s nil nil) while (and ch (digit-char-p ch))
                              do (setq n (+ (* 10 n) (digit-char-p (read-char s)))))
                        (if neg (- n) n)))
                     (t (error "Unexpected case-file character ~C" c))))))
    (let ((value (item))) (when (peek) (error "Trailing case data")) value)))

(defun case-file-path (corpus name type)
  (let* ((base (pathname corpus))
         (dir (if (or (pathname-name base) (pathname-type base))
                  (make-pathname :directory (append (or (pathname-directory base) '(:relative))
                                                    (list (file-namestring base)))
                                 :name nil :type nil :defaults base)
                  base)))
    (merge-pathnames (make-pathname :name name :type type) dir)))

(defun read-regression-case (path)
  (with-open-file (stream path :external-format :utf-8)
    (let ((regression-case (read-case-datum stream)))
      (unless (and (listp regression-case) (= (length regression-case) 4)
                   (consp (first regression-case)) (eql 2 (caar regression-case))
                   (= 3 (length (first regression-case)))
                   (every #'stringp (cdar regression-case)))
        (error "Malformed property identity or case in ~A" path))
      regression-case)))

;; Identity is based on the concrete reduced arguments. The first publication
;; retains the original case for diagnosis, even when later seeds reduce to it.
(defun regression-key (regression-case) (list (first regression-case) (fourth regression-case)))

(defun save-regression (report corpus)
  (let* ((resolved (if (typep report 'check-failed) (failure-report report) report))
         (case (or (getf (report-data resolved) :regression-case)
                   (error "No persistable counterexample in this report")))
         (key (regression-key case))
         (id (format nil "~16,'0X" (hash-text #xcbf29ce484222325
                                     (with-output-to-string (s) (write-case-datum key s)))))
         (target (case-file-path corpus id "zkcase"))
         (lock (case-file-path corpus id "lock")))
    (ensure-directories-exist target)
    (labels ((published ()
               (when (probe-file target)
                 (unless (equal key (regression-key (read-regression-case target)))
                   (error "Case digest collision at ~A" target))
                 target)))
      (or (published)
          (loop repeat 100
                for stream = (open lock :direction :output :if-exists nil
                                        :if-does-not-exist :create
                                        :external-format :utf-8)
                when stream do
                  (return
                    (let ((renamed nil))
                      (unwind-protect
                           (or (published)
                               (progn
                                 (unwind-protect (write-case-datum case stream) (close stream))
                                 ;; Pass name+type only: RENAME-FILE merges against LOCK's directory.
                                 (rename-file lock (make-pathname :name id :type "zkcase"))
                                 (setq renamed t)
                                 target))
                        (when (open-stream-p stream) (close stream))
                        (unless renamed (delete-file lock)))))
                do (let ((path (published))) (when path (return path))) (sleep 0.01)
                finally (error "Concurrent or interrupted case publication at ~A" lock))))))
