(in-package :zk-gray)

;; Compound streams keep the actual component objects in native storage.
;; Calls on a component reenter the CL entry point, so a user method can
;; signal, invoke a restart, or recursively operate on the same stream.
(defmacro define-directed-input (class component)
  `(progn
     (defmethod stream-read-char ((s ,class)) (read-char (,component s) nil :eof))
     (defmethod stream-read-char-no-hang ((s ,class)) (read-char-no-hang (,component s) nil :eof))
     (defmethod stream-peek-char ((s ,class)) (peek-char nil (,component s) nil :eof))
     (defmethod stream-unread-char ((s ,class) c) (unread-char c (,component s)))
     (defmethod stream-read-line ((s ,class)) (read-line (,component s) nil ""))
     (defmethod stream-listen ((s ,class)) (listen (,component s)))
     (defmethod stream-clear-input ((s ,class)) (clear-input (,component s)))
     (defmethod stream-read-byte ((s ,class)) (read-byte (,component s) nil :eof))
     (defmethod stream-read-sequence ((s ,class) seq start end)
       (read-sequence seq (,component s) :start start :end end))))

(define-directed-input two-way-stream two-way-stream-input-stream)
(define-directed-input synonym-stream zk::%synonym-target)

(defmacro define-compound-output (class component &key multiple)
  (flet ((forward (name parameters form)
           `(defmethod ,name ((s ,class) ,@parameters)
              ,(if multiple
                   `(dolist (out (,component s)) ,form)
                   `(let ((out (,component s))) ,form)))))
    `(progn
       ,(forward 'stream-write-char '(c) '(write-char c out))
       ,(forward 'stream-write-byte '(byte) '(write-byte byte out))
       ,(forward 'stream-write-string '(string &optional (start 0) end)
                 '(write-string string out :start start :end end))
       ,(forward 'stream-write-sequence '(seq start end)
                 '(write-sequence seq out :start start :end end))
       ,(forward 'stream-terpri nil '(terpri out))
       ,(forward 'stream-finish-output nil '(finish-output out))
       ,(forward 'stream-force-output nil '(force-output out))
       ,(forward 'stream-clear-output nil '(clear-output out))
       (defmethod stream-line-column ((s ,class))
         ,(if multiple
              `(let ((last (car (last (,component s))))) (if last (stream-line-column last) 0))
              `(stream-line-column (,component s))))
       (defmethod stream-fresh-line ((s ,class))
         (unless (eql 0 (stream-line-column s)) (stream-terpri s) t))
       (defmethod stream-advance-to-column ((s ,class) column)
         (let ((current (stream-line-column s)))
           (when current
             (dotimes (i (max 0 (- column current))) (stream-write-char s #\Space))
             t))))))

(defmethod stream-line-column ((s stream)) (zk::%native-output-column s))
(define-compound-output synonym-stream zk::%synonym-target)
(define-compound-output two-way-stream two-way-stream-output-stream)
(define-compound-output echo-stream echo-stream-output-stream)
(define-compound-output broadcast-stream broadcast-stream-streams :multiple t)

(defun read-concatenated (s read)
  (loop
    (let ((parts (concatenated-stream-streams s)))
      (unless parts (return :eof))
      (let ((value (funcall read (car parts))))
        (unless (eq value :eof) (return value)))
      (zk::%discard-concatenated-head s parts))))

(defmethod stream-read-char ((s concatenated-stream))
  (read-concatenated s (lambda (in) (read-char in nil :eof))))
(defmethod stream-read-char-no-hang ((s concatenated-stream))
  (read-concatenated s (lambda (in) (read-char-no-hang in nil :eof))))
(defmethod stream-peek-char ((s concatenated-stream))
  (read-concatenated s (lambda (in) (peek-char nil in nil :eof))))
(defmethod stream-read-byte ((s concatenated-stream))
  (read-concatenated s (lambda (in) (read-byte in nil :eof))))
(defmethod stream-unread-char ((s concatenated-stream) c)
  (let ((head (first (concatenated-stream-streams s))))
    (unless head (error 'stream-error :stream s))
    (unread-char c head)))
(defmethod stream-read-line ((s concatenated-stream)) (read-line-elements s))
(defmethod stream-listen ((s concatenated-stream))
  ;; Inspect later members only after the current member reports EOF.
  ;; Keep all members installed so a subsequent UNREAD-CHAR can reach them.
  (dolist (in (concatenated-stream-streams s) nil)
    (case (zk::%native-input-readiness in)
      (:ready (return t))
      (:pending (return nil))
      (:protocol
       (when (listen in) (return t))
       (unless (subtypep (stream-element-type in) 'character) (return nil))
       (let ((c (read-char-no-hang in nil :eof)))
         (unless (eq c :eof)
           (when c (unread-char c in))
           (return (not (null c)))))))))
(defmethod stream-clear-input ((s concatenated-stream))
  (let ((first (first (concatenated-stream-streams s))))
    (when first (clear-input first))))
(defmethod stream-read-sequence ((s concatenated-stream) seq start end)
  (loop while (< start end) do
    (let ((parts (concatenated-stream-streams s)))
      (unless parts (return))
      (setf start (read-sequence seq (first parts) :start start :end end))
      (when (< start end) (zk::%discard-concatenated-head s parts))))
  start)

(defun echo-input-character (s c)
  (when (characterp c)
    (multiple-value-bind (last pending) (zk::%echo-character-state s)
      (unless (and pending (eql c last)) (write-char c (echo-stream-output-stream s))))
    (zk::%record-echo-character s c nil))
  c)
(defmethod stream-read-char ((s echo-stream))
  (echo-input-character s (read-char (echo-stream-input-stream s) nil :eof)))
(defmethod stream-read-char-no-hang ((s echo-stream))
  (echo-input-character s (read-char-no-hang (echo-stream-input-stream s) nil :eof)))
(defmethod stream-peek-char ((s echo-stream))
  (peek-char nil (echo-stream-input-stream s) nil :eof))
(defmethod stream-unread-char ((s echo-stream) c)
  (multiple-value-bind (last pending) (zk::%echo-character-state s)
    (unless (and (eql last c) (not pending)) (error 'stream-error :stream s)))
  (unread-char c (echo-stream-input-stream s))
  (zk::%record-echo-character s c t))
(defmethod stream-read-byte ((s echo-stream))
  (let ((byte (read-byte (echo-stream-input-stream s) nil :eof)))
    (unless (eq byte :eof) (write-byte byte (echo-stream-output-stream s)))
    byte))
(defmethod stream-read-line ((s echo-stream)) (read-line-elements s))
(defmethod stream-read-sequence ((s echo-stream) seq start end) (read-elements s seq start end))
(defmethod stream-listen ((s echo-stream)) (listen (echo-stream-input-stream s)))
(defmethod stream-clear-input ((s echo-stream)) (clear-input (echo-stream-input-stream s)))

(defun %compound-element-type (s)
  (etypecase s
    (synonym-stream (stream-element-type (zk::%synonym-target s)))
    (echo-stream (stream-element-type (echo-stream-input-stream s)))
    (two-way-stream (stream-element-type (two-way-stream-input-stream s)))
    (broadcast-stream (let ((last (car (last (broadcast-stream-streams s)))))
                        (if last (stream-element-type last) 'character)))
    (concatenated-stream (let ((first (first (concatenated-stream-streams s))))
                           (if first (stream-element-type first) 'character)))))

(defmethod stream-file-position ((s synonym-stream) &optional position)
  (let ((target (zk::%synonym-target s)))
    (if position (file-position target position) (file-position target))))
(defmethod stream-file-position ((s broadcast-stream) &optional position)
  (let ((last (car (last (broadcast-stream-streams s)))))
    (cond ((null last) 0) (position (file-position last position)) (t (file-position last)))))
(defmethod stream-file-position ((s echo-stream) &optional position) (declare (ignore position)) nil)
(defmethod stream-file-position ((s two-way-stream) &optional position) (declare (ignore position)) nil)
(defmethod stream-file-position ((s concatenated-stream) &optional position) (declare (ignore position)) nil)

(provide :zk-gray)
