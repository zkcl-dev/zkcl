(defpackage #:zk-gray
  (:use #:cl)
  (:export
   #:fundamental-stream #:fundamental-input-stream #:fundamental-output-stream
   #:fundamental-character-stream #:fundamental-binary-stream
   #:fundamental-character-input-stream #:fundamental-character-output-stream
   #:fundamental-binary-input-stream #:fundamental-binary-output-stream
   #:stream-read-char #:stream-unread-char #:stream-read-char-no-hang
   #:stream-peek-char #:stream-listen #:stream-read-line #:stream-clear-input
   #:stream-write-char #:stream-line-column #:stream-start-line-p #:stream-write-string
   #:stream-terpri #:stream-fresh-line #:stream-finish-output #:stream-force-output
   #:stream-clear-output #:stream-advance-to-column #:stream-read-byte #:stream-write-byte
   #:stream-read-sequence #:stream-write-sequence #:stream-file-position))
(in-package #:zk-gray)

(defmethod zk-mop:validate-superclass ((class standard-class) (superclass (eql (find-class 'stream))))
  t)
(defclass fundamental-stream (standard-object stream)
  ((open :initform t)))
(defclass fundamental-input-stream (fundamental-stream) ())
(defclass fundamental-output-stream (fundamental-stream) ())
(defclass fundamental-character-stream (fundamental-stream) ())
(defclass fundamental-binary-stream (fundamental-stream) ())
(defclass fundamental-character-input-stream (fundamental-input-stream fundamental-character-stream) ())
(defclass fundamental-character-output-stream (fundamental-output-stream fundamental-character-stream) ())
(defclass fundamental-binary-input-stream (fundamental-input-stream fundamental-binary-stream) ())
(defclass fundamental-binary-output-stream (fundamental-output-stream fundamental-binary-stream) ())

(defmethod open-stream-p ((s fundamental-stream)) (slot-value s 'open))
(defmethod close ((s fundamental-stream) &key abort)
  (declare (ignore abort))
  (setf (slot-value s 'open) nil)
  t)
(defmethod input-stream-p ((s fundamental-stream)) nil)
(defmethod input-stream-p ((s fundamental-input-stream)) t)
(defmethod output-stream-p ((s fundamental-stream)) nil)
(defmethod output-stream-p ((s fundamental-output-stream)) t)
(defmethod interactive-stream-p ((s fundamental-stream)) nil)
(defmethod stream-element-type ((s fundamental-character-stream)) 'character)
(defmethod stream-element-type ((s fundamental-binary-stream)) '(unsigned-byte 8))

(defgeneric stream-read-char (stream))
(defgeneric stream-unread-char (stream character))
(defgeneric stream-read-byte (stream))
(defgeneric stream-write-byte (stream byte))
(defgeneric stream-write-char (stream character))

(defmethod stream-read-char-no-hang ((s fundamental-character-input-stream))
  (stream-read-char s))
(defmethod stream-peek-char ((s fundamental-character-input-stream))
  (let ((c (stream-read-char s)))
    (unless (eq c :eof) (stream-unread-char s c))
    c))
(defmethod stream-listen ((s fundamental-character-input-stream))
  (let ((c (stream-read-char-no-hang s)))
    (when (characterp c) (stream-unread-char s c) t)))
(defmethod stream-clear-input ((s fundamental-input-stream)) nil)
(defun read-line-elements (s)
  (let ((buffer (make-array 80 :element-type 'character :fill-pointer 0 :adjustable t)))
    (loop for c = (stream-read-char s)
          until (or (eq c :eof) (char= c #\Newline))
          do (vector-push-extend c buffer)
          finally (return (values (coerce buffer 'simple-string) (eq c :eof))))))

(defmethod stream-read-line ((s fundamental-character-input-stream)) (read-line-elements s))

(defmethod stream-write-string ((s fundamental-character-output-stream) string
                                &optional (start 0) end)
  (loop for i from start below (or end (length string))
        do (stream-write-char s (char string i)))
  string)
(defmethod stream-line-column ((s fundamental-character-output-stream)) nil)
(defmethod stream-start-line-p ((s fundamental-character-output-stream))
  (eql (stream-line-column s) 0))
(defmethod stream-terpri ((s fundamental-character-output-stream))
  (stream-write-char s #\Newline)
  nil)
(defmethod stream-fresh-line ((s fundamental-character-output-stream))
  (unless (stream-start-line-p s) (stream-terpri s) t))
(defmethod stream-advance-to-column ((s fundamental-character-output-stream) column)
  (let ((current (stream-line-column s)))
    (when current
      (dotimes (i (max 0 (- column current))) (stream-write-char s #\Space))
      t)))
(defmethod stream-finish-output ((s fundamental-output-stream)) nil)
(defmethod stream-force-output ((s fundamental-output-stream)) nil)
(defmethod stream-clear-output ((s fundamental-output-stream)) nil)
(defmethod stream-file-position ((s fundamental-stream) &optional position)
  (declare (ignore position))
  nil)

(defun read-elements (s sequence start end)
  (let ((read (if (subtypep (stream-element-type s) 'character)
                  #'stream-read-char #'stream-read-byte))
        (tail (and (listp sequence) (nthcdr start sequence))))
    (loop for i from start below end
          for element = (funcall read s)
          when (eq element :eof) return i
          do (if tail
                 (progn (setf (car tail) element) (pop tail))
                 (setf (aref sequence i) element))
          finally (return end))))
(defmethod stream-read-sequence ((s fundamental-input-stream) sequence start end)
  (read-elements s sequence start end))

(defmethod stream-write-sequence ((s fundamental-output-stream) sequence start end)
  (let ((write (if (subtypep (stream-element-type s) 'character)
                   #'stream-write-char #'stream-write-byte))
        (tail (and (listp sequence) (nthcdr start sequence))))
    (loop for i from start below end
          do (funcall write s (if tail (pop tail) (aref sequence i)))))
  sequence)

(defun check-open (stream)
  (unless (open-stream-p stream) (error 'stream-error :stream stream)))

(defun read-result (stream value errorp eof-value)
  (if (eq value :eof)
      (if errorp (error 'end-of-file :stream stream) eof-value)
      value))

(defun %read-char (s &optional (errorp t) eof-value recursive)
  (declare (ignore recursive))
  (check-open s)
  (read-result s (stream-read-char s) errorp eof-value))
(defun %read-byte (s &optional (errorp t) eof-value)
  (check-open s)
  (read-result s (stream-read-byte s) errorp eof-value))
(defun %read-char-no-hang (s &optional (errorp t) eof-value recursive)
  (declare (ignore recursive))
  (check-open s)
  (read-result s (stream-read-char-no-hang s) errorp eof-value))
(defun %peek-char (selector s &optional (errorp t) eof-value recursive)
  (declare (ignore recursive))
  (check-type selector (or null (eql t) character))
  (check-open s)
  (loop for c = (stream-peek-char s)
        until (or (eq c :eof) (null selector)
                  (if (eq selector t) (not (zk::%reader-whitespace-p c))
                      (char= c selector)))
        do (stream-read-char s)
        finally (return (read-result s c errorp eof-value))))
(defun %unread-char (c s)
  (check-type c character)
  (check-open s)
  (stream-unread-char s c)
  nil)
(defun %read-line (s &optional (errorp t) eof-value recursive)
  (declare (ignore recursive))
  (check-open s)
  (multiple-value-bind (line eof) (stream-read-line s)
    (values (if (and eof (zerop (length line)))
                (read-result s :eof errorp eof-value)
                line)
            eof)))
(defun %write-char (c s)
  (check-type c character)
  (check-open s)
  (stream-write-char s c)
  c)
(defun %write-byte (byte s)
  (check-type byte integer)
  (check-open s)
  (stream-write-byte s byte)
  byte)
(defun checked-end (sequence start end)
  (let* ((length (length sequence)) (end (or end length)))
    (unless (and (typep start 'integer) (<= 0 start length))
      (error 'type-error :datum start :expected-type (list 'integer 0 length)))
    (unless (and (typep end 'integer) (<= start end length))
      (error 'type-error :datum end :expected-type (list 'integer start length)))
    end))
(defun %write-string (string s &key (start 0) end)
  (check-type string string)
  (check-open s)
  (stream-write-string s string start (checked-end string start end))
  string)
(defun %write-line (string s &key (start 0) end)
  (%write-string string s :start start :end end)
  (stream-terpri s)
  string)
(defun %read-sequence (sequence s &key (start 0) end)
  (check-open s)
  (stream-read-sequence s sequence start (checked-end sequence start end)))
(defun %write-sequence (sequence s &key (start 0) end)
  (check-open s)
  (stream-write-sequence s sequence start (checked-end sequence start end))
  sequence)
(defun %file-position (s &optional position)
  (check-open s)
  (stream-file-position s position))
(defun %listen (s) (check-open s) (stream-listen s))
(defun %fresh-line (s) (check-open s) (stream-fresh-line s))
(defun %terpri (s) (check-open s) (stream-terpri s) nil)
(defun %clear-input (s) (check-open s) (stream-clear-input s) nil)
(defun %clear-output (s) (check-open s) (stream-clear-output s) nil)
(defun %force-output (s) (check-open s) (stream-force-output s) nil)
(defun %finish-output (s) (check-open s) (stream-finish-output s) nil)
(defun %call-with-binding (symbol value function &rest args)
  (progv (list symbol) (list value) (apply function args)))

(defun %load-binary-p (s)
  (unless (and (input-stream-p s) (open-stream-p s))
    (error 'stream-error :stream s))
  (let ((type (stream-element-type s)))
    (cond ((subtypep type 'character) nil)
          ((and (subtypep type '(unsigned-byte 8)) (subtypep '(unsigned-byte 8) type)) t)
          (t (error 'stream-error :stream s)))))
