(defun normalize-comparison (args env)
  (unless (or (= (length args) 1) (and (= (length args) 3) (eq (second args) :test)))
    (error "Expected (:= form [:test function-form]), got ~S" (cons := args)))
  (let ((form (first args)))
    (if (cdr args)
        (list :compare form (third args) t)
        (cond ((or (numberp form) (stringp form) (characterp form) (keywordp form)
                   (member form '(t nil)))
               (list :lit form))
              ((and (consp form) (eq (car form) 'quote) (= (length form) 2))
               (list :lit (second form)))
              ((symbolp form)
               (multiple-value-bind (constantp known value) (resolve-constant-value form env)
                 (if constantp
                     (list :constant-ref form known value)
                     (list :compare form nil nil))))
              (t (list :compare form nil nil))))))

(defun rest-syntax-p (pattern)
  (and (consp pattern) (eq (car pattern) :rest)))

(defun span-option (tail form)
  (cond ((null tail) nil)
        ((equal tail '(:as :span)) t)
        (t (error "Expected :as :span in ~S" form))))

(defun normalize-vector (patterns normalize-child)
  (let ((position (position-if #'rest-syntax-p patterns)))
    (if (null position)
        (list :node (list :vector (length patterns)) (mapcar normalize-child patterns))
        (destructuring-bind (marker child &rest options) (nth position patterns)
          (declare (ignore marker))
          (let ((suffix (nthcdr (1+ position) patterns)))
            (when (some #'rest-syntax-p suffix)
              (error "A vector pattern allows only one :rest"))
            (list :vector-rest (mapcar normalize-child (subseq patterns 0 position))
                  (funcall normalize-child child) (span-option options (nth position patterns))
                  (mapcar normalize-child suffix)))))))

(defun pattern-bound (form env)
  (if (and (consp form) (eq (car form) :const))
      (progn
        (arity form 1)
        (multiple-value-bind (name known value) (resolve-constant-form (second form) env)
          (declare (ignore name))
          (unless known (error "Range bound is not known at compile time: ~S" form))
          value))
      form))

(defun parse-range-bound (form env)
  (cond ((eq form '*) (values nil nil))
        ((and (consp form) (null (cdr form))) (values (pattern-bound (car form) env) t))
        (t (values (pattern-bound form env) nil))))

(defun normalize-range (lower upper child env)
  (multiple-value-bind (low exclude-low) (parse-range-bound lower env)
    (multiple-value-bind (high exclude-high) (parse-range-bound upper env)
      (let ((kind (cond ((and (or (eq lower '*) (integerp low))
                              (or (eq upper '*) (integerp high))) :integer)
                        ((and (or (eq lower '*) (characterp low))
                              (or (eq upper '*) (characterp high))) :character))))
        (unless (and kind (or low high))
          (error "Range endpoints must be integers or characters of one domain: ~S ~S" lower upper))
        (let ((start (if (characterp low) (char-code low) low))
              (end (if (characterp high) (char-code high) high)))
          (list :range kind (list (if exclude-low (1+ start) start)
                                  (if exclude-high (1- end) end)) child))))))

(defun integer-type-range (specifier)
  (labels ((valid-bound-p (bound)
             (or (eq bound '*) (integerp bound)
                 (and (consp bound) (null (cdr bound)) (integerp (car bound))))))
    (cond ((member specifier '(integer signed-byte)) '(nil nil))
          ((eq specifier 'unsigned-byte) '(0 nil))
          ((eq specifier 'bit) '(0 1))
          ((eq specifier 'fixnum) (list most-negative-fixnum most-positive-fixnum))
          ((and (consp specifier) (eq (car specifier) 'integer)
                (member (length specifier) '(1 2 3)))
           (let ((low (if (cdr specifier) (second specifier) '*))
                 (high (if (cddr specifier) (third specifier) '*)))
             (when (and (valid-bound-p low) (valid-bound-p high))
               (list (cond ((consp low) (1+ (car low))) ((integerp low) low))
                     (cond ((consp high) (1- (car high))) ((integerp high) high))))))
          ((and (consp specifier) (null (cdr specifier))
                (member (car specifier) '(unsigned-byte signed-byte)))
           (if (eq (car specifier) 'unsigned-byte) '(0 nil) '(nil nil)))
          ((and (consp specifier) (consp (cdr specifier)) (null (cddr specifier)))
           (let ((argument (second specifier)))
             (cond ((and (eq argument '*) (eq (car specifier) 'unsigned-byte)) '(0 nil))
                   ((and (eq argument '*) (eq (car specifier) 'signed-byte)) '(nil nil))
                   ((and (integerp argument) (plusp argument))
                    (case (car specifier)
                      (mod (list 0 (1- argument)))
                      (unsigned-byte
                       (when (<= argument 4096) (list 0 (1- (ash 1 argument)))))
                      (signed-byte
                       (when (<= argument 4096)
                         (let ((limit (ash 1 (1- argument)))) (list (- limit) (1- limit)))))))))))))

(defun range-test (kind range value)
  (destructuring-bind (low high) range
    (when (and low high (> low high)) (return-from range-test nil))
    (let ((checks (append (when low (list `(<= ,low ,value)))
                          (when high (list `(<= ,value ,high))))))
      (if (eq kind :integer)
          `(and (integerp ,value) ,@checks)
          `(and (characterp ,value) (let ((,value (char-code ,value))) (and ,@checks)))))))

(defun emit-value-row (patterns form success targets assign miss)
  (let ((variables (mapcar (lambda (pattern) (declare (ignore pattern)) (gensym "VALUE")) patterns))
        (body success))
    (loop for pattern in (reverse patterns) for value in (reverse variables) do
      (setq body (emit-pattern pattern value body targets nil assign miss)))
    `(multiple-value-bind ,variables ,form
       (declare (ignorable ,@variables)) ,body)))

(defun emit-indexed-sequence (pred-op len-op ref-op slice-op span-op prefix rest span-p suffix source success targets assign miss)
  (let ((length-var (gensym "LENGTH")) (end-var (gensym "REST-END"))
        (minimum (+ (length prefix) (length suffix)))
        (fields nil))
    (flet ((field (pattern form)
             (unless (eq (car pattern) :wild)
               (push (list pattern form) fields))))
      (loop for child in prefix for index from 0 do
        (field child `(,ref-op ,source ,index)))
      (when rest
        (field rest (if (and span-p span-op) `(,span-op ,source ,(length prefix) ,end-var)
                        `(,slice-op ,source ,(length prefix) ,end-var)))
        (loop for child in suffix for index from 0 do
          (let ((offset (if (zerop index) end-var `(+ ,end-var ,index))))
            (field child `(,ref-op ,source ,offset))))))
    (let ((body success))
      (dolist (entry fields)
        (destructuring-bind (pattern form) entry
          (setf body (emit-pattern pattern form body targets nil assign miss))))
      (test-path `(,pred-op ,source)
                 `(let ((,length-var (,len-op ,source)))
                    ,(test-path `(,(if rest '>= '=) ,length-var ,minimum)
                                (if rest `(let ((,end-var (- ,length-var ,(length suffix))))
                                           (declare (ignorable ,end-var)) ,body) body)
                                miss)) miss))))

(defun emit-vector (prefix rest span-p suffix source success targets assign miss)
  (emit-indexed-sequence 'vectorp 'length 'aref 'subseq 'slice-vector-span
                         prefix rest span-p suffix source success targets assign miss))

(defun emit-treelist (prefix rest suffix source success targets assign miss)
  (emit-indexed-sequence 'zk-treelist:treelist-p 'zk-treelist:length 'zk-treelist:ref 'zk-treelist:subseq nil
                         prefix rest nil suffix source success targets assign miss))

;;; Register ZK-TREELIST:TREELIST as a pluggable structural special pattern.
(defun normalize-treelist-special (args normalize-child env)
  (declare (ignore env))
  (let ((position (position-if #'rest-syntax-p args)))
    (if (null position)
        (list :special 'zk-treelist:treelist :exact (mapcar normalize-child args))
        (destructuring-bind (marker child &rest options) (nth position args)
          (declare (ignore marker))
          (let ((suffix (nthcdr (1+ position) args)))
            (when (some #'rest-syntax-p suffix)
              (error "A treelist pattern allows only one :rest"))
            (span-option options (nth position args))
            (list :special 'zk-treelist:treelist :rest
                  (mapcar normalize-child (subseq args 0 position))
                  (funcall normalize-child child)
                  (mapcar normalize-child suffix)))))))

(setf (gethash 'zk-treelist:treelist *special-patterns*)
      (make-special-pattern
       :normalizer #'normalize-treelist-special
       :bindings (lambda (node)
                   (if (eq (third node) :exact)
                       (merge-names (mapcar #'bindings (fourth node)))
                       (merge-names (mapcar #'bindings
                                            (append (fourth node) (list (fifth node)) (sixth node))))))
       :emitter (lambda (node source success targets assign miss)
                  (if (eq (third node) :exact)
                      (emit-treelist (fourth node) nil nil source success targets assign miss)
                      (emit-treelist (fourth node) (fifth node) (sixth node)
                                     source success targets assign miss)))
       :user-test-p (lambda (node)
                      (if (eq (third node) :exact)
                          (some #'user-test-p (fourth node))
                          (some #'user-test-p (append (fourth node) (list (fifth node)) (sixth node)))))
       :opaque-p (lambda (node)
                   (if (eq (third node) :exact)
                       (some #'opaque-p (fourth node))
                       t))
       :heads (lambda (node)
                (when (eq (third node) :exact)
                  (list (list :node (list :treelist (length (fourth node)))))))
       :vector-widths (lambda (node)
                        (if (eq (third node) :exact)
                            (values (length (fourth node)) 0)
                            (values (length (fourth node)) (length (sixth node)))))
       :specializer (lambda (node h domain include-uncertain-matches-p)
                      (let ((all (list (wilds (head-width h))))
                            (key (second h)))
                        (if (eq (third node) :exact)
                            (let ((children (fourth node)))
                              (cond ((and (eq (car h) :node)
                                          (equal key (list :treelist (length children))))
                                     (list children))
                                    ((and include-uncertain-matches-p (eq (car h) :lit)
                                          (zk-treelist:treelist-p (second h)))
                                     all)))
                            (let* ((prefix (fourth node)) (rest (fifth node)) (suffix (sixth node))
                                   (minimum (+ (length prefix) (length suffix))))
                              (cond ((and (eq (car h) :node) (consp key) (eq (car key) :treelist))
                                     (when (and (>= (second key) minimum)
                                                (or include-uncertain-matches-p (universal-p rest)))
                                       (list (append prefix (wilds (- (head-width h) minimum)) suffix))))
                                    ((and (eq (car h) :other) (zerop minimum) (universal-p rest)
                                          (eq domain 'zk-treelist:treelist))
                                     all)
                                    (include-uncertain-matches-p all))))))))

;;; Register ZK-BITS:BITS as a pluggable special pattern.
(defun field-shorthand (head)
  (when (symbolp head)
    (let* ((name (symbol-name head)) (length (length name)))
      (when (and (>= length 4) (find (char name 0) "UI")
                 (or (string= name "BE" :start1 (- length 2))
                     (string= name "LE" :start1 (- length 2))))
        (let ((width (ignore-errors (parse-integer name :start 1 :end (- length 2)))))
          (when width (values (if (char= (char name 0) #\U) :u :i) width
                              (if (char= (char name (- length 2)) #\B) :be :le))))))))

(defun normalize-bits (fields normalize-child env)
  (declare (ignore env))
  (list* :special 'zk-bits:bits
         (loop for (field . remaining) on fields collect
           (progn
             (unless (and (consp field) (list-length field))
               (error "Invalid bit layout field ~S" field))
             (destructuring-bind (head &rest operands) field
               (case head
                 ((:bytes :rest :rest-bits)
                  (when (and remaining (not (eq head :bytes)))
                    (error "Bit layout remainder must be last: ~S" field))
                  (let ((count (when (eq head :bytes) (pop operands)))
                        (pattern (if operands (pop operands) (error "Missing field pattern: ~S" field))))
                    (when (and (numberp count) (not (typep count '(integer 0 *))))
                      (error "Invalid byte count in ~S" field))
                    (list head count (if (eq head :rest-bits)
                                         (progn (arity field 1) t)
                                         (span-option operands field))
                          (funcall normalize-child pattern))))
                 (otherwise
                  (multiple-value-bind (kind width order) (field-shorthand head)
                    (let ((pattern (if kind (progn (arity field 1) (car operands))
                                       (destructuring-bind (size endian child) operands
                                         (setf kind head width size order endian) child))))
                      (unless (and (member kind '(:u :i)) (member order '(:be :le))
                                   (or (not (numberp width))
                                       (and (typep width '(integer 1 *))
                                            (or (eq order :be) (zerop (mod width 8))))))
                        (error "Invalid integer bit field ~S" field))
                      (list kind width order (funcall normalize-child pattern)))))))))))

(defun emit-bits (fields source success targets assign miss)
  (let ((position (gensym "BIT-POSITION")) (limit (gensym "BIT-LIMIT")))
    (labels ((emit-fields (remaining previous)
               (if (null remaining) (test-path `(= ,position ,limit) success miss)
                   (destructuring-bind (kind width option pattern) (car remaining)
                     (let* ((width-form (if (and previous (not (numberp width)))
                                            `(symbol-macrolet ,previous ,width) width))
                            (value (gensym "BIT-FIELD")) (end (gensym "FIELD-END"))
                            (bindings (mapcar (lambda (name) (list name (cdr (assoc name targets))))
                                              (bindings pattern)))
                            (body (emit-pattern pattern value
                                                (emit-fields (cdr remaining) (append bindings previous))
                                                targets nil assign miss)))
                       `(multiple-value-bind (,value ,end)
                            (bit-field ,source ,position ,limit ,kind ,width-form ,option
                                       ,(not (eq (car pattern) :wild)))
                          (declare (ignorable ,value))
                          ,(test-path end `(let ((,position ,end)) ,body) miss)))))))
      `(let ((,limit (bit-layout-size ,source)) (,position 0))
         ,(test-path limit (emit-fields fields nil) miss)))))

(setf (gethash 'zk-bits:bits *special-patterns*)
      (make-special-pattern
       :normalizer #'normalize-bits
       :bindings (lambda (node)
                   (merge-names (mapcar (lambda (field) (bindings (fourth field))) (cddr node))))
       :emitter (lambda (node source success targets assign miss)
                  (emit-bits (cddr node) source success targets assign miss))
       :user-test-p (lambda (node) (declare (ignore node)) t)
       :opaque-p (lambda (node) (declare (ignore node)) t)))
