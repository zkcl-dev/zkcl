(defun lexical-source (source scan-p)
  (if (and (consp source) (member (car source) '(:text :bytes)))
      (destructuring-bind (domain input &rest options) source
        (when (and scan-p options) (error "A scanner source does not accept range options"))
        (let ((keys nil))
          (loop for (key . tail) on options by #'cddr do
            (unless (and tail (member key '(:start :end)) (not (member key keys)))
              (error "Invalid lexical source options in ~S" source))
            (push key keys)))
        (values input domain options))
      (values source :text nil)))

(defun build-lexical-plan (data bindings domain mode)
  `(load-time-value (assemble-lexical-plan ',data ',bindings ,domain ,mode) t))

(defun lexical-binding-names (names env)
  (dolist (name names)
    (when (nth-value 1 (zk::%pattern-variable-info name env))
      (error "Lexical capture cannot bind special variable ~S" name)))
  names)

(defun lex-body (names record body)
  `(let ,(mapcar (lambda (name) (list name `(zk-lex:lex-capture ,record ',name))) names)
     (declare (ignorable ,@names)) ,@(or body (list nil))))

(defun flatten-literal-rule (form domain)
  (cond ((and (eq domain :text) (stringp form))
         (list (coerce form 'list)))
        ((and (eq domain :bytes) (consp form) (eq (car form) :octets))
         (list (cdr form)))
        ((and (consp form) (eq (car form) :seq))
         (let ((acc (list nil)))
           (dolist (part (cdr form) acc)
             (let ((arms (flatten-literal-rule part domain)))
               (unless (and arms (<= (* (length acc) (length arms)) 32))
                 (return-from flatten-literal-rule nil))
               (setf acc (loop for prefix in acc nconc
                               (loop for suffix in arms collect (append prefix suffix))))))))
        ((and (consp form) (eq (car form) :or))
         (let ((all nil))
           (dolist (part (cdr form) all)
             (let ((arms (flatten-literal-rule part domain)))
               (unless arms (return-from flatten-literal-rule nil))
               (setf all (nconc all arms))
               (when (> (length all) 64) (return-from flatten-literal-rule nil))))))))

(defun literal-rule-arms (rules bindings domain)
  (let ((arms nil) (priority 0))
    (loop for rule in rules for binding in bindings for ordinal from 0 do
      (when (first binding) (return-from literal-rule-arms nil))
      (let ((flattened (flatten-literal-rule rule domain)))
        (unless flattened (return-from literal-rule-arms nil))
        (dolist (units flattened)
          (when (> (length units) 64) (return-from literal-rule-arms nil))
          (push (list units ordinal priority) arms)
          (when (> (incf priority) 64) (return-from literal-rule-arms nil)))))
    (nreverse arms)))

(defun make-trie-node () (list nil nil most-positive-fixnum))

(defun trie-insert (node units ordinal priority)
  (setf (third node) (min (third node) priority))
  (if (null units)
      (when (or (null (first node)) (< priority (car (first node))))
        (setf (first node) (cons priority ordinal)))
      (let* ((unit (car units))
             (entry (assoc unit (second node))))
        (unless entry
          (setf entry (cons unit (make-trie-node)))
          (push entry (second node)))
        (trie-insert (cdr entry) (cdr units) ordinal priority))))

(defun unit-pos (low d)
  (if (zerop d) low `(+ ,low ,d)))

(defun unit-eq-op (domain)
  (if (eq domain :text) 'char= '=))

(defun emit-fixed-trie-node (node d len backing low domain winner)
  (let ((terminal (first node)) (children (nreverse (copy-list (second node)))))
    (cond ((= d len) (when terminal `(setf ,winner ,(cdr terminal))))
          ((null (cdr children))
           (let ((chain nil) (cur node) (depth d))
             (loop while (and (null (cdr (second cur))) (= (length (second cur)) 1)) do
               (let ((pair (first (second cur))))
                 (push (list depth (car pair)) chain)
                 (setf cur (cdr pair) depth (1+ depth))))
             (if (and (= depth len) (first cur))
                 `(when (and ,@(loop for (pos ch) in (nreverse chain)
                                     collect `(,(unit-eq-op domain) (aref ,backing ,(unit-pos low pos)) ,ch)))
                    (setf ,winner ,(cdr (first cur))))
                 (let ((pair (first children)))
                   `(when (,(unit-eq-op domain) (aref ,backing ,(unit-pos low d)) ,(car pair))
                      ,(emit-fixed-trie-node (cdr pair) (1+ d) len backing low domain winner))))))
          (t `(case (aref ,backing ,(unit-pos low d))
                ,@(loop for (unit . child) in children collect
                    `(,unit ,(emit-fixed-trie-node child (1+ d) len backing low domain winner))))))))

(defun emit-prefix-trie-node (node d len backing low domain mode winner match-end
                              &optional (best-priority most-positive-fixnum))
  (let* ((terminal (first node))
         (children (nreverse (copy-list (second node))))
         (ordered-p (eq mode :prefix))
         (select-terminal (and terminal (or (not ordered-p) (< (car terminal) best-priority))))
         ;; The priority ranks alternatives as well as rules. A longer arm of
         ;; the same rule can outrank the terminal already seen on this path.
         (limit (if select-terminal (car terminal) best-priority))
         (kept (if ordered-p
                   (remove-if-not (lambda (pair) (< (third (cdr pair)) limit)) children)
                   children))
         (set-term (when select-terminal `(setf ,winner ,(cdr terminal) ,match-end ,d)))
         (branch (when kept
                   `(when (< ,d ,len)
                      ,(if (null (cdr kept))
                           (let ((pair (first kept)))
                             `(when (,(unit-eq-op domain) (aref ,backing ,(unit-pos low d)) ,(car pair))
                                ,(emit-prefix-trie-node (cdr pair) (1+ d) len backing low domain mode winner match-end limit)))
                           `(case (aref ,backing ,(unit-pos low d))
                              ,@(loop for (unit . child) in kept collect
                                  `(,unit ,(emit-prefix-trie-node child (1+ d) len backing low domain mode winner match-end limit)))))))))
    (cond ((and set-term branch) `(progn ,set-term ,branch))
          (set-term set-term)
          (branch branch))))

(defun emit-literal-trie (arms mode domain backing low high winner match-end)
  (if (eq mode :full)
      (let ((by-len nil))
        (dolist (arm arms)
          (let* ((len (length (car arm)))
                 (bucket (assoc len by-len)))
            (unless bucket
              (setf bucket (cons len nil))
              (push bucket by-len))
            (push arm (cdr bucket))))
        `(case (- ,high ,low)
           ,@(loop for (len . group) in (nreverse by-len) collect
               (let ((trie (make-trie-node)))
                 (loop for (units ordinal priority) in (nreverse group)
                       do (trie-insert trie units ordinal priority))
                 `(,len ,(emit-fixed-trie-node trie 0 len backing low domain winner))))))
      (let ((trie (make-trie-node))
            (len (gensym "LEN")))
        (loop for (units ordinal priority) in arms do (trie-insert trie units ordinal priority))
        `(let ((,len (- ,high ,low)))
           (declare (ignorable ,len))
           ,(emit-prefix-trie-node trie 0 len backing low domain mode winner match-end)))))

(defun compile-lexical-rows (forms domain mode scan-p env record)
  (let ((rules nil) (bindings nil) (rows nil) (events nil) (ordinal 0))
    (dolist (clause forms)
      (destructuring-bind (head &rest body) clause
        (when (eq (car body) :when) (error "Lexical cases do not take guards"))
        (let ((event (cond ((wildcard-p head) (if scan-p :miss :fallback))
                           ((and scan-p (member head '((:eof) (:need-more)) :test #'equal)) (car head)))))
          (if event
              (progn
                (when (assoc event events) (error "Repeated lexical case ~S" head))
                (push (cons event body) events))
              (progn
                (when events (error "Lexical rules must precede fallback and scanner events"))
                (multiple-value-bind (data binding names) (lexical-rule-data head env t)
                  (when (and scan-p (or (second binding) (third binding)))
                    (error ":before and :after bindings require an in-memory range"))
                  (push data rules) (push binding bindings)
                  (push (list ordinal (lex-body (lexical-binding-names names env) record body) binding body) rows)
                  (incf ordinal)))))))
    (let* ((rules (nreverse rules)) (bindings (nreverse bindings))
           (program (zk::%lex-compile rules domain mode)))
      (if scan-p
          (unless (zk::%lex-scanner-p program)
            (error "Scanner rules must be nonempty, advancing prefix rules"))
          (multiple-value-bind (coverage witness selectable) (zk::%lex-coverage program)
            (when selectable
              (dotimes (index (length selectable))
                (unless (aref selectable index)
                  (warn "Lexical rule ~D cannot be selected: ~S" (1+ index) (first (nth index forms))))))
            (let ((fallback (assoc :fallback events)))
              (case coverage
                (:total (when fallback (warn "Unreachable lexical fallback")))
                (:missing (unless fallback (error "Non-exhaustive lexical match; missing input ~S" witness)))
                (:unknown (unless fallback (error "Cannot prove lexical coverage; supply a fallback")))))))
      (values (build-lexical-plan rules bindings domain mode) (nreverse rows) events rules bindings))))

(defun around-row-form (binding body input-var start-var match-end region-len domain)
  (let* ((before (second binding))
         (after (third binding))
         (source (when (and (eq (second before) :span) (eq (second after) :span)
                            (not (wildcard-p (first before))) (not (wildcard-p (first after))))
                   (gensym "SOURCE")))
         (lets nil))
    (when (and before (not (wildcard-p (first before))))
      (push (list (first before)
                  `(slice-lexical-binding ,input-var ,start-var 0 0 ',(second before) ,domain ,source))
            lets))
    (when (and after (not (wildcard-p (first after))))
      (push (list (first after)
                  `(slice-lexical-binding ,input-var ,start-var ,match-end ,region-len ',(second after) ,domain ,source))
            lets))
    (if lets
        (let* ((bindings (nreverse lets))
               (vars (mapcar #'first bindings)))
          `(let* (,@(when source `((,source (unless (input-span-p ,input-var) (gensym "SOURCE")))))
                   ,@bindings)
             (declare (ignorable ,@vars))
             ,@(or body (list nil))))
        `(progn ,@(or body (list nil))))))

(defmacro zk-lex:lexmatch (source &rest clauses &environment env)
  (multiple-value-bind (input domain options) (lexical-source source nil)
    (let ((mode (if (keywordp (car clauses)) (pop clauses) :full))
          (record (gensym "LEXICAL-MATCH")))
      (multiple-value-bind (plan rows events rules bindings)
          (compile-lexical-rows clauses domain mode nil env record)
        (let* ((arms (and (member mode '(:full :prefix :longest-prefix))
                          (literal-rule-arms rules bindings domain)))
               (fallback (if (assoc :fallback events)
                             `(progn ,@(cdr (assoc :fallback events)))
                             '(error "Input outside proven lexical match domain"))))
          (if arms
              (let* ((input-var (gensym "INPUT"))
                     (start-var (gensym "START"))
                     (end-opt (gensym "END-OPT"))
                     (backing (gensym "BACKING"))
                     (low (gensym "LOW"))
                     (high (gensym "HIGH"))
                     (local-end (gensym "LOCAL-END"))
                     (winner (gensym "WINNER"))
                     (match-end (gensym "MATCH-END"))
                     (inits (list (list input-var input)))
                     (start-expr 0)
                     (end-expr nil))
                (loop for (key expr) on options by #'cddr do
                  (let ((var (gensym (symbol-name key))))
                    (push (list var expr) inits)
                    (if (eq key :start) (setf start-expr var) (setf end-expr var))))
                (push (list start-var start-expr) inits)
                (push (list end-opt end-expr) inits)
                `(let* ,(nreverse inits)
                   (multiple-value-bind (,backing ,low ,high ,local-end)
                       (input-region ,input-var ,domain ,start-var ,end-opt)
                     (let ((,winner -1) (,match-end ,(if (eq mode :full) `(- ,high ,low) 0)))
                       (declare (ignorable ,match-end))
                       ,(emit-literal-trie arms mode domain backing low high winner match-end)
                       (if (minusp ,winner)
                           ,fallback
                           (case ,winner
                             ,@(loop for (ordinal _form binding body) in rows collect
                                 `(,ordinal ,(around-row-form binding body input-var start-var
                                                              match-end `(- ,local-end ,start-var) domain)))))))))
              (let ((call (if options
                              (let* ((input-var (gensym "INPUT"))
                                     (start-var nil)
                                     (end-var nil)
                                     (inits (list (list input-var input))))
                                (loop for (key expr) on options by #'cddr do
                                  (let ((var (gensym (symbol-name key))))
                                    (push (list var expr) inits)
                                    (if (eq key :start) (setf start-var var) (setf end-var var))))
                                `(let* ,(nreverse inits)
                                   (run-lex-rules-internal ,plan ,input-var ,(or start-var 0) ,end-var nil)))
                              `(run-lex-rules-internal ,plan ,input 0 nil nil))))
                `(let ((,record ,call))
                   (if ,record (case (zk-lex:lex-match-rule ,record)
                                 ,@(loop for (ordinal form) in rows collect (list ordinal form)))
                       ,fallback)))))))))

(defmacro zk-lex:lexscan (source &rest clauses &environment env)
  (multiple-value-bind (input domain) (lexical-source source t)
    (let ((mode (if (keywordp (car clauses)) (pop clauses) :longest-prefix))
          (scanner (gensym "SCANNER")) (record (gensym "LEXICAL-MATCH")) (status (gensym "SCAN-STATUS")))
      (multiple-value-bind (plan rows events) (compile-lexical-rows clauses domain mode t env record)
        `(let ((,scanner ,input))
           (multiple-value-bind (,status ,record) (scan-step-internal ,scanner ,plan nil)
             (case ,status
               (:match (case (zk-lex:lex-match-rule ,record)
                         ,@(loop for (ordinal form) in rows collect (list ordinal form))))
               ,@(mapcar (lambda (event) (or (and (assoc event events) (cons event (cdr (assoc event events))))
                                            (list event `(error 'zk-lex:scan-error :reason ,status
                                                                :position (zk-lex:scan-position ,scanner)))))
                          '(:eof :need-more :miss)))))))))

;;; Register ZK-LEX:LEX as a pluggable special pattern.
(defun normalize-lex (args normalize-child env)
  (declare (ignore normalize-child))
  (destructuring-bind (rule &optional (mode :full) (domain :text)) args
    (multiple-value-bind (data bindings names) (lexical-rule-data rule env t)
      (zk::%lex-compile (list data) domain mode)
      (let ((arms (and (member mode '(:full :prefix :longest-prefix))
                       (null (second bindings)) (null (third bindings))
                       (literal-rule-arms (list data) (list bindings) domain))))
        (list :special 'zk-lex:lex
              (build-lexical-plan (list data) (list bindings) domain mode)
              (lexical-binding-names names env) domain mode arms)))))

(defun emit-lex (pattern value success targets assign miss)
  (let ((plan (third pattern))
        (names (fourth pattern))
        (domain (fifth pattern))
        (mode (sixth pattern))
        (arms (seventh pattern)))
    (if arms
        (let ((backing (gensym "BACKING"))
              (low (gensym "LOW"))
              (high (gensym "HIGH"))
              (winner (gensym "WINNER"))
              (match-end (gensym "MATCH-END")))
          `(if (lexical-input-p ,value ,domain)
               (multiple-value-bind (,backing ,low ,high) (input-region ,value ,domain 0 nil)
                 (let ((,winner -1) (,match-end 0))
                   (declare (ignorable ,match-end))
                   ,(emit-literal-trie arms mode domain backing low high winner match-end)
                   ,(test-path `(not (minusp ,winner)) success miss)))
               ,(or miss nil)))
        (let* ((record (gensym "LEXICAL-MATCH"))
               (bindings (mapcar (lambda (name)
                                   (list (cdr (assoc name targets)) `(zk-lex:lex-capture ,record ',name)))
                                 names))
               (body (if assign `(progn (setq ,@(mapcan #'copy-list bindings)) ,success)
                         `(let ,bindings ,success))))
          `(let ((,record (when (lexical-input-p ,value ,domain)
                            (run-lex-rules-internal ,plan ,value 0 nil nil))))
             ,(test-path record body miss))))))

(setf (gethash 'zk-lex:lex *special-patterns*)
      (make-special-pattern
       :normalizer #'normalize-lex
       :bindings (lambda (node) (fourth node))
       :emitter #'emit-lex
       :user-test-p (lambda (node) (declare (ignore node)) t)
       :opaque-p (lambda (node) (declare (ignore node)) t)))
